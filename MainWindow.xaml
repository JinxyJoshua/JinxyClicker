                    <StackPanel x:Name="PageRecorder_replay" Visibility="Collapsed">
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE768;"/>
                                </Border>
                                <TextBlock Text="Instant replay" Style="{StaticResource CardTitle}" DockPanel.Dock="Left" Margin="11,0,0,0"/>
                                <CheckBox x:Name="ReplayEnabled" DockPanel.Dock="Right" Margin="0"
