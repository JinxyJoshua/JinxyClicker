                                         KeyDown="EditorMarkBox_KeyDown" LostFocus="EditorMarkBox_LostFocus"/>
                                <Button DockPanel.Dock="Left" Content="+" Tag="A+" Width="30" Height="28" Click="EditorNudge_Click" IsEnabled="False" x:Name="EditorNudgeAUp"/>

                                <TextBlock DockPanel.Dock="Left" Text="B" Width="14" Margin="22,0,0,0" VerticalAlignment="Center"
