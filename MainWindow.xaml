                                <Button x:Name="EditorLeftButton" Content="â—€ Move" Click="EditorMoveLeft_Click" IsEnabled="False" Height="32" Padding="12,0" Margin="0,0,8,8"/>
                                <Button x:Name="EditorRightButton" Content="Move â–¶" Click="EditorMoveRight_Click" IsEnabled="False" Height="32" Padding="12,0" Margin="0,0,8,8"/>
                                <Button x:Name="EditorRemoveButton" Content="Remove" Click="EditorRemove_Click" IsEnabled="False" Height="32" Padding="14,0" Margin="0,0,16,8"/>
                                <Button x:Name="EditorUndoButton" Content="Undo" Click="EditorUndo_Click" IsEnabled="False" Height="32" Padding="14,0" Margin="0,0,8,8"/>
                                <Button x:Name="EditorRedoButton" Content="Redo" Click="EditorRedo_Click" IsEnabled="False" Height="32" Padding="14,0" Margin="0,0,0,8"/>
                            </WrapPanel>

