                            </DockPanel>
                            <TextBlock Text="Click a game to apply your setup and launch straight into it." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="SEARCH" FontSize="9" FontWeight="Bold" Margin="0,14,0,4" Foreground="{StaticResource TextMuted}"/>
                            <TextBox x:Name="RecentSearchBox" Style="{StaticResource InputField}" MaxLength="40"
