                                <TextBox x:Name="PlayUrlBox" Style="{StaticResource InputField}" DockPanel.Dock="Left" Width="320" Margin="12,0,0,0"
                                         TextChanged="PlayUrl_Changed"
                                         ToolTip="Paste your BedWars game link OR just its game ID. Blank opens Roblox's games page."/>
                            </DockPanel>
                            <TextBlock Text="Paste your BedWars game link â€” or just the game ID number â€” and Play opens straight to it. Leave blank to open Roblox and pick it yourself."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RecentGamesCard" Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
