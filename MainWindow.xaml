                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE714;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Timeline"/>
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="Your clips, left to right"/>
