                                        Click="RecordHotkey_Click"
                                        ToolTip="Click, then press a key or a mouse button. Any mouse button works except left, and whichever one the clicker is set to send. Delete unbinds it, Escape leaves it alone. If a button does nothing at all here, your mouse software has taken it over - set it back to a plain mouse button there."
                                        Height="36" Padding="16,0" MinWidth="64" Margin="0,0,10,0"/>
                                <Button x:Name="ClearRecordKey" Tag="Record" Style="{StaticResource ClearBindingButton}"
                                        Click="ClearBinding_Click"/>
                                <Button x:Name="OpenClipFolderButton" Content="Open clips folder"
                                        Click="OpenClipFolder_Click" Height="36" Padding="16,0" Margin="0"/>
                            </StackPanel>

