<Window x:Class="JinxyClicker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:JinxyClicker"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="Jinxy AutoClicker Beta"
    Width="1120" Height="760"
    MinWidth="900" MinHeight="650"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource Bg}"
    Foreground="{DynamicResource TextBright}"
    FontFamily="Segoe UI"
    FontSize="13"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextHintingMode="Fixed"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    PreviewKeyDown="Window_PreviewKeyDown"
    PreviewMouseDown="Window_PreviewMouseDown"
    KeyDown="Window_KeyDown"
    Closing="Window_Closing"
    ContentRendered="Window_ContentRendered"
    Visibility="Visible"
    ShowInTaskbar="True">

    <Window.Resources>
        <!-- The palette. Every colour in the window resolves to one of these
             Colors, and ApplyTheme rewrites the lot when the mode changes.

             The values here are the dark set, which is also what the designer
             surface shows. They are not the source of truth at runtime: the
             constructor applies a full palette before the window is shown, so
             whichever mode was last used wins over these. -->
        <Color x:Key="BgColor">#0F141D</Color>
        <Color x:Key="PanelColor">#1A2230</Color>
        <Color x:Key="Panel2Color">#151C27</Color>
        <Color x:Key="SidebarColor">#151B25</Color>
        <Color x:Key="SunkenColor">#101620</Color>
        <Color x:Key="ControlColor">#202A39</Color>
        <Color x:Key="ControlHoverColor">#26313F</Color>
        <Color x:Key="ControlAltColor">#1E2634</Color>
        <Color x:Key="TrackColor">#2A3445</Color>
        <Color x:Key="DividerColor">#232E3E</Color>
        <Color x:Key="OutlineColor">#3A465A</Color>
        <Color x:Key="HairlineColor">#1AFFFFFF</Color>
        <Color x:Key="TextColor">#E9EDF4</Color>
        <Color x:Key="TextBrightColor">#F5F7FA</Color>
        <Color x:Key="TextSoftColor">#AAB4C5</Color>
        <Color x:Key="TextDimColor">#C3CDDD</Color>
        <Color x:Key="TextMutedColor">#8D98AA</Color>

        <!-- Hover and press are drawn as a translucent overlay. It has to invert
             with the mode: white at 7% over a dark control lightens it, but over
             a light one it does nothing at all. -->
        <Color x:Key="SheenColor">#FFFFFF</Color>

        <SolidColorBrush x:Key="Bg" Color="{DynamicResource BgColor}"/>
        <SolidColorBrush x:Key="Panel" Color="{DynamicResource PanelColor}"/>
        <SolidColorBrush x:Key="Panel2" Color="{DynamicResource Panel2Color}"/>
        <SolidColorBrush x:Key="Sidebar" Color="{DynamicResource SidebarColor}"/>
        <SolidColorBrush x:Key="Sunken" Color="{DynamicResource SunkenColor}"/>
        <SolidColorBrush x:Key="Control" Color="{DynamicResource ControlColor}"/>
        <SolidColorBrush x:Key="ControlHover" Color="{DynamicResource ControlHoverColor}"/>
        <SolidColorBrush x:Key="ControlAlt" Color="{DynamicResource ControlAltColor}"/>
        <SolidColorBrush x:Key="Track" Color="{DynamicResource TrackColor}"/>
        <SolidColorBrush x:Key="Divider" Color="{DynamicResource DividerColor}"/>
        <SolidColorBrush x:Key="Outline" Color="{DynamicResource OutlineColor}"/>
        <SolidColorBrush x:Key="Hairline" Color="{DynamicResource HairlineColor}"/>
        <SolidColorBrush x:Key="Text" Color="{DynamicResource TextColor}"/>
        <SolidColorBrush x:Key="TextBright" Color="{DynamicResource TextBrightColor}"/>
        <SolidColorBrush x:Key="TextSoft" Color="{DynamicResource TextSoftColor}"/>
        <SolidColorBrush x:Key="TextDim" Color="{DynamicResource TextDimColor}"/>
        <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource TextMutedColor}"/>
        <SolidColorBrush x:Key="Sheen" Color="{DynamicResource SheenColor}"/>

        <!--
            Tooltips, dressed to match the rest of the window.

            Untouched, WPF gives them the system default: near-white with dark
            text and a drop shadow. Against a dark purple app that is a pale
            rectangle that appears over whatever you are pointing at, and on the
            Kit Wheel it lands beside the kit picture and reads as though the
            picture itself has a background.

            An implicit style, so every tooltip in the window is covered rather
            than the twenty that happen to be written out by hand today.
        -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="FontSize" Value="11"/>
            <!-- The default template paints its own chrome, so recolouring
                 alone leaves a pale border and the shadow behind. -->
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Outline}"
                                BorderThickness="1" CornerRadius="2"
                                Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}"/>

        <!--
            The small cross beside a hotkey, which takes the key off that one
            action and leaves every other binding alone.

            Deliberately its own control rather than a keyboard shortcut. There
            was no way at all to get back to "Not set" once an action had a key,
            and a shortcut only helps the people who find out it exists.

            Shown only when there is something to clear, so a row that already
            reads "Not set" does not offer to unset it.
        -->
        <Style x:Key="ClearBindingButton" TargetType="Button">
            <Setter Property="Content" Value="&#x2715;"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="ToolTip" Value="Unbind this key, leaving the action with no hotkey"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Background="Transparent" CornerRadius="2"
                                BorderThickness="1" BorderBrush="{StaticResource Outline}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#3A1F2E"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#7A3B52"/>
                                <Setter Property="Foreground" Value="#FF9C9C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tints of the accent, as brushes rather than the ARGB literals they
             replace: the accent is user-chosen, and a literal would keep the old
             hue after it changed. ApplyAccent sets all four together.

             Each brush takes its Color from a DynamicResource rather than a
             literal, and that indirection is load-bearing in two ways. WPF
             freezes resource Freezables whenever it can, and a frozen brush
             cannot be recoloured at all â€” an unresolved reference is what keeps
             these four mutable. And because the consumers hold the brush while
             only its Color moves, every one of the 200-odd StaticResource uses
             repaints without being converted to DynamicResource itself. -->
        <Color x:Key="AccentColor">#FF4B52</Color>
        <Color x:Key="AccentStrongColor">#66FF4B52</Color>
        <Color x:Key="AccentSoftColor">#33FF4B52</Color>
        <Color x:Key="AccentWashColor">#22FF4B52</Color>

        <SolidColorBrush x:Key="AccentStrong" Color="{DynamicResource AccentStrongColor}"/>
        <SolidColorBrush x:Key="AccentSoft" Color="{DynamicResource AccentSoftColor}"/>
        <SolidColorBrush x:Key="AccentWash" Color="{DynamicResource AccentWashColor}"/>

        <!-- The default Aero2 button template sets Background on its own named
             border when the mouse is over it, which beats a Style setter. Any
             dark theme therefore needs its own template, not just setters. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root" CornerRadius="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <!-- Neutral sheen so hover/press read the same on the
                                 dark fill and on the accent fill. -->
                            <Border x:Name="Sheen" CornerRadius="1" Background="{StaticResource Sheen}" Opacity="0"/>
                            <Border x:Name="FocusRing" CornerRadius="1" Opacity="0"
                                    BorderThickness="1" BorderBrush="{StaticResource Accent}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.07"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.14"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selection is driven by Tag="Selected" so the highlight only moves
             when navigation actually happens. -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <!-- Uppercase and tracked out. The label carries the weight rather
                 than a rounded pill behind it. -->
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root" CornerRadius="0"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="Sheen" CornerRadius="0" Background="{StaticResource Sheen}" Opacity="0"/>
                            <!-- Full height and square. An inset rounded bar is
                                 the soft look this is moving away from. -->
                            <Border x:Name="SelBar" Width="4" Opacity="0"
                                    HorizontalAlignment="Left" CornerRadius="0"
                                    Background="{StaticResource Accent}"/>
                            <DockPanel Margin="{TemplateBinding Padding}" LastChildFill="True">
                                <!-- Fixed width, so the labels line up whether a
                                     glyph is wide or narrow. From the icon font
                                     Windows ships â€” nothing to bundle. -->
                                <TextBlock DockPanel.Dock="Left" Width="20"
                                           Text="{Binding Path=(app:NavIcon.Glyph),
                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" FontWeight="Normal"
                                           VerticalAlignment="Center"
                                           TextAlignment="Left"/>
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </DockPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.05"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlAlt}"/>
                                <Setter TargetName="SelBar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Mutually exclusive segment. IsChecked carries the selection, so no
             handler has to clear the previously selected button. -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Background" Value="{StaticResource Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Root" CornerRadius="1"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="Sheen" CornerRadius="1" Background="{StaticResource Sheen}" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.07"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.14"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A colour chip. The fill is the swatch's own Background, so each one
             declares only its colour. The ring marking the chosen swatch is a
             fixed near-white rather than the accent: the accent is what is being
             chosen, so using it would leave the current selection unreadable
             against its own chip. -->
        <Style x:Key="SwatchButton" TargetType="RadioButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Ring" CornerRadius="2"
                                    BorderThickness="2" BorderBrush="Transparent"/>
                            <Border x:Name="Fill" CornerRadius="1" Margin="4"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="Sheen" CornerRadius="1" Margin="4"
                                    Background="{StaticResource Sheen}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.18"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#553A465A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Editable numeric readout. Templated for the same reason the buttons
             are: the stock TextBox recolours its own border on hover/focus. -->
        <Style x:Key="ValueBox" TargetType="TextBox">
            <!-- MinWidth rather than Width: the box measures to its text, so it
                 can never clip. MaxLength=7 is exactly the widest value either
                 slider can produce â€” "1000.00" for CPS, "100.00" for duty. -->
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Background" Value="{StaticResource Sunken}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MaxLength" Value="7"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" CornerRadius="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Track}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rejects anything that would not parse as a number, on typing and on
             paste alike. The commit handlers still clamp; this just stops the
             box ever showing text that cannot mean anything. -->
        <Style x:Key="NumericValueBox" TargetType="TextBox" BasedOn="{StaticResource ValueBox}">
            <EventSetter Event="PreviewTextInput" Handler="NumericBox_PreviewTextInput"/>
            <EventSetter Event="DataObject.Pasting" Handler="NumericBox_Pasting"/>
        </Style>

        <Style x:Key="PixelBox" TargetType="TextBox" BasedOn="{StaticResource NumericValueBox}">
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MaxLength" Value="3"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <!-- Preset card. The accent rail and border make the applied preset
             readable at a glance without re-reading every number. -->
        <!-- The same box holding a path instead of a number. Everything
             overridden here exists to serve a short right-aligned figure â€” a
             path is long, reads left to right, and should not be the loudest
             thing on its panel. The 7-character cap especially. -->
        <Style x:Key="PathBox" TargetType="TextBox" BasedOn="{StaticResource ValueBox}">
            <Setter Property="MinWidth" Value="340"/>
            <Setter Property="MaxLength" Value="260"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <!-- The readout beside a slider, typeable. Small enough to sit on the
             row without crowding the track, and capped at three characters
             because nothing it holds goes past 100. -->
        <Style x:Key="SliderValueBox" TargetType="TextBox" BasedOn="{StaticResource ValueBox}">
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="MaxLength" Value="3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PresetCard" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root" CornerRadius="2" BorderThickness="1"
                                    BorderBrush="Transparent"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="Sheen" CornerRadius="2" Background="{StaticResource Sheen}" Opacity="0"/>
                            <Border x:Name="Rail" Width="3" Margin="0,10" Opacity="0"
                                    HorizontalAlignment="Left" CornerRadius="2"
                                    Background="{StaticResource Accent}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.06"/>
                                <Setter TargetName="Rail" Property="Opacity" Value="0.55"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentStrong}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Rail" Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetDelete" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,6,6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="ToolTip" Value="Delete this preset"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Width="18" Height="18" CornerRadius="9"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource ValueBox}">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="MaxLength" Value="24"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- A multi-line field: top-aligned, wraps, scrolls, with a visible resting
             border. The ValueBox template centres its one line, which reads wrong in
             a tall box, so this carries its own template. -->
        <Style x:Key="TextArea" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Height" Value="132"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" CornerRadius="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Top"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Auto"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Track}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The default for any TextBox that does not name a style.

            Three of them never did â€” the saved-wheel name, the kit search and
            the add-kit box â€” so they fell back to the stock WPF chrome: a white
            box with black text, in a window that is otherwise dark throughout.

            Implicit rather than three more Style attributes, because the next
            box added would have been white too.
        -->
        <Style TargetType="TextBox" BasedOn="{StaticResource FieldBox}"/>

        <!-- A text-entry field with a visible resting border, so a wide box reads
             as an input rather than a flat dark blob. Hover/focus still light the
             border via the template triggers. -->
        <Style x:Key="InputField" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
        </Style>

        <!-- Same field, numbers only. The preset name field stays unfiltered. -->
        <Style x:Key="NumericFieldBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <EventSetter Event="PreviewTextInput" Handler="NumericBox_PreviewTextInput"/>
            <EventSetter Event="DataObject.Pasting" Handler="NumericBox_Pasting"/>
        </Style>

        <!-- Slider, rebuilt. The filled portion is the decrease repeat button,
             which already occupies exactly the region left of the thumb â€” that
             avoids needing a converter to size a separate fill element. -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                Background="{StaticResource Accent}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrack" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                Background="{StaticResource Track}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Halo" Width="26" Height="26" Fill="{StaticResource Accent}" Opacity="0"/>
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.25"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="26" VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource SliderFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderTrack}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card used by the reworked clicker controls. -->
        <Style x:Key="ControlCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
        </Style>

        <!-- Lyre-style card header vocabulary: an accent icon chip followed by a
             title and a one-line subtitle. The chip's glyph is set per card (from
             the app's own verified Segoe MDL2 set); everything else is shared, so
             every card header reads identically. -->
        <Style x:Key="CardIconChip" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardIconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>

        <!-- Slider value readout (big, bright) and the min/max tick labels that sit
             under a track â€” the context Lyre shows so a bare slider isn't guesswork. -->
        <Style x:Key="SliderReadout" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SliderTick" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <!-- 10px bold uppercase in a muted blue was too low-contrast to read
             cleanly; larger and lighter, with the weight carrying the emphasis. -->
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Sized against the controls beside it. At 11px the labels read as a
             caption next to a 17px button, which is what made the cards look
             lopsided rather than small. -->
        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Control}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <!-- Shared by the Tweaks and Optimizations pages. Must come after the
             Badge styles: StaticResource cannot resolve a forward reference, and
             inside a template the failure only surfaces when the page renders. -->
        <DataTemplate x:Key="TweakRow">
            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}" Padding="0,12">
                <Grid>
                    <StackPanel Margin="0,0,110,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Badge}">
                                <TextBlock Text="{Binding Impact}" Style="{StaticResource BadgeText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                   Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Content="{Binding ActionText}" IsEnabled="{Binding CanAct}"
                            Click="Tweak_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="92" Margin="0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Same data, presented as a switch. IsChecked is one-way: the click
             handler performs the change and Refresh pushes the real state back,
             so a failed apply cannot leave the switch lying. -->
        <DataTemplate x:Key="TweakToggleRow">
            <Border Padding="0,4">
                <Grid>
                    <StackPanel Margin="0,0,70,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Badge}">
                                <TextBlock Text="{Binding Impact}" Style="{StaticResource BadgeText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                   Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <CheckBox IsChecked="{Binding IsApplied, Mode=OneWay}"
                              IsEnabled="{Binding CanAct}"
                              Click="TweakToggle_Click"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Shared look for the pages that have no components yet. -->
        <Style x:Key="EmptyPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="EmptyHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="EmptyTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="EmptyHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Toggle switch. These are all on/off settings, and the stock check
             box is a light Win32 square that fights the dark theme. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26">
                            <Border x:Name="Track" CornerRadius="3"
                                    Background="{StaticResource Track}"
                                    BorderThickness="1" BorderBrush="{StaticResource Outline}"/>
                            <Border x:Name="Glow" CornerRadius="3" Background="{StaticResource Sheen}" Opacity="0"/>
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="3"
                                    Background="{StaticResource TextMuted}"
                                    HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Knob" Property="Background" Value="White"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A collapsible group header in the sidebar: a muted label with a
             chevron that flips when the group is toggled. Borderless so it reads
             as a heading, not a tab. -->
        <Style x:Key="GroupHeader" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="6,12,6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The PRO upgrade shortcut: a big accent CTA so it pops against the
             dark sidebar and reads as the thing to click, not another tab. -->
        <Style x:Key="ProCta" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Join-the-Discord shortcut above the Plus group. Discord blurple with a
             matching glow so it pops against the dark sidebar and reads as the thing
             to click. Opens the invite (JoinDiscord_Click). -->
        <Style x:Key="DiscordCta" TargetType="Button">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="10,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                                                  Opacity="0.75" Color="#5865F2"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="JOIN DISCORD" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6B74F5"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="26" ShadowDepth="0"
                                                          Opacity="0.95" Color="#5865F2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small flat outlined button for clip-row actions and dialog
             secondaries, so they read as part of the dark UI, not default chrome. -->
        <!-- Small bordered action button. Inherits the default Button template
             (which renders its content correctly in any window, unlike a hand-rolled
             one) and just restyles it: literal white text, panel fill, hairline
             outline. -->
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Dark dropdowns, so the combo boxes match the app instead of the white
             Windows default. One row style for the items, one for the box. -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Outline}"
                                                BorderThickness="1" CornerRadius="3"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Outline}" BorderThickness="1"
                                        CornerRadius="3" Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240" SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One-click resolution preset tiles on the Display page. -->
        <Style x:Key="PresetChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Outline}"
                                BorderThickness="1" CornerRadius="3" Padding="13,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Panel}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="195"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Wallpaper, behind everything. First in the grid rather than given a
             ZIndex, so the ordering is visible where the layers are declared.
             Both layers span the columns: the picture sits behind the sidebar
             as well as the page, and the sidebar is thinned to let it through
             whenever one is set. -->
        <Image x:Name="WallpaperImage" Grid.ColumnSpan="2"
               Stretch="UniformToFill" Visibility="Collapsed"/>
        <Border x:Name="WallpaperDim" Grid.ColumnSpan="2"
                Background="#000000" Opacity="0.45" Visibility="Collapsed"/>

        <!-- Seasonal ambient effect (snow / leaves / blossoms / sparkles). On top of
             everything and click-through, so it drifts over the whole app harmlessly. -->
        <Canvas x:Name="SeasonCanvas" Grid.ColumnSpan="2" Panel.ZIndex="100"
                IsHitTestVisible="False" ClipToBounds="True"/>

        <!-- Sidebar -->
        <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource Sidebar}">
            <DockPanel Margin="14">
                <!-- A PRO shortcut pinned to the bottom-left corner, out of the
                     tab list so it doesn't take a row up top. It jumps to the
                     Pro page and its label reflects the current plan. -->
                <Button x:Name="NavProCorner" DockPanel.Dock="Bottom"
                        Content="&#x2605; GET PLUS"
                        Style="{StaticResource ProCta}" Click="NavPro_Click"
                        Margin="0,12,0,2"/>
                <!-- Discord invite, pinned just above the Plus button (both dock to the
                     bottom) so they stay in the same spot however far the tabs scroll. -->
                <Button x:Name="NavDiscord" DockPanel.Dock="Bottom"
                        Style="{StaticResource DiscordCta}" Margin="0,10,0,0"
                        Click="JoinDiscord_Click" ToolTip="Join the Jinxy Discord"/>
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="NavList">
                <!-- Wordmark sits against a solid accent block rather than
                     floating over the sidebar. The slab is the mark. -->
                <StackPanel Orientation="Horizontal" Margin="4,16,8,2">
                    <Border Background="{StaticResource Accent}" Width="5" Margin="0,2,10,2"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="JINXY" FontSize="24" FontWeight="Black"
                                   Foreground="{StaticResource TextBright}"/>
                        <TextBlock Text="ORIGINAL BUILD" FontSize="8" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}" Margin="1,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{StaticResource Divider}" Margin="4,16,8,18"/>

                <Button Style="{StaticResource GroupHeader}" Content="&#x25BE; CLICKING"
                        Tag="{Binding ElementName=GroupClicking}" Click="NavGroup_Click"/>
                <StackPanel x:Name="GroupClicking">
                    <Button x:Name="NavClicker" app:NavIcon.Glyph="&#xE7C9;" Content="CLICKER" Style="{StaticResource NavButton}"
                            Tag="Selected" Click="NavClicker_Click"/>
                    <Button x:Name="NavShake" app:NavIcon.Glyph="&#xEA80;" Content="SHAKY TRACKING" Style="{StaticResource NavButton}"
                            Click="NavShake_Click"/>
                    <Button x:Name="NavPresets" app:NavIcon.Glyph="&#xE734;" Content="PRESETS" Style="{StaticResource NavButton}"
                            Click="NavPresets_Click"/>
                    <Button x:Name="NavMacros" app:NavIcon.Glyph="&#xE765;" Content="AUTOMATION" Style="{StaticResource NavButton}"
                            Click="NavMacros_Click"/>
                    <Button x:Name="NavAppTargeting" app:NavIcon.Glyph="&#xE71D;" Content="APP TARGETING" Style="{StaticResource NavButton}"
                            Click="NavAppTargeting_Click"/>
                </StackPanel>

                <Button Style="{StaticResource GroupHeader}" Content="&#x25BE; GAME"
                        Tag="{Binding ElementName=GroupGame}" Click="NavGroup_Click"/>
                <StackPanel x:Name="GroupGame">
                    <Button x:Name="NavKitWheel" app:NavIcon.Glyph="&#xE72C;" Content="KIT WHEEL" Style="{StaticResource NavButton}"
                            Click="NavKitWheel_Click"/>
                    <Button x:Name="NavCrosshair" app:NavIcon.Glyph="&#xE1D1;" Content="CROSSHAIR" Style="{StaticResource NavButton}"
                            Click="NavCrosshair_Click"/>
                </StackPanel>

                <Button Style="{StaticResource GroupHeader}" Content="&#x25BE; PERFORMANCE"
                        Tag="{Binding ElementName=GroupPerf}" Click="NavGroup_Click"/>
                <StackPanel x:Name="GroupPerf">
                    <Button x:Name="NavTweaks" app:NavIcon.Glyph="&#xE90F;" Content="TWEAKS" Style="{StaticResource NavButton}"
                            Click="NavTweaks_Click"/>
                    <Button x:Name="NavOptimizations" app:NavIcon.Glyph="&#xE945;" Content="OPTIMIZATIONS" Style="{StaticResource NavButton}"
                            Click="NavOptimizations_Click"/>
                </StackPanel>

                <Button Style="{StaticResource GroupHeader}" Content="&#x25BE; CAPTURE"
                        Tag="{Binding ElementName=GroupCapture}" Click="NavGroup_Click"/>
                <StackPanel x:Name="GroupCapture">
                    <Button x:Name="NavRecorder" app:NavIcon.Glyph="&#xE714;" Content="RECORDER" Style="{StaticResource NavButton}"
                            Click="NavRecorder_Click"/>
                    <Button x:Name="NavClipStudio" app:NavIcon.Glyph="&#xE8B2;" Content="CLIP STUDIO" Style="{StaticResource NavButton}"
                            Click="NavClipStudio_Click"/>
                    <Button x:Name="NavHistory" app:NavIcon.Glyph="&#xE81C;" Content="HISTORY" Style="{StaticResource NavButton}"
                            Click="NavHistory_Click"/>
                </StackPanel>

                <Button Style="{StaticResource GroupHeader}" Content="&#x25BE; APP"
                        Tag="{Binding ElementName=GroupApp}" Click="NavGroup_Click"/>
                <StackPanel x:Name="GroupApp">
                    <Button x:Name="NavTheme" app:NavIcon.Glyph="&#xE790;" Content="THEME" Style="{StaticResource NavButton}"
                            Click="NavTheme_Click"/>
                    <Button x:Name="NavSettings" app:NavIcon.Glyph="&#xE713;" Content="SETTINGS" Style="{StaticResource NavButton}"
                            Click="NavSettings_Click"/>
                </StackPanel>

                <!-- The paid features, gathered in one group at the bottom. Each tab
                     stays visible so Free users can see what Pro unlocks; clicking one
                     when Free sends them to the key page (see the NavX_Click handlers). -->
                <Button Style="{StaticResource GroupHeader}" Content="&#x25BE; PLUS"
                        Tag="{Binding ElementName=GroupPro}" Click="NavGroup_Click"/>
                <StackPanel x:Name="GroupPro">
                    <Button x:Name="NavHitReg" app:NavIcon.Glyph="&#xE945;" Content="HIT REGISTRATION" Style="{StaticResource NavButton}"
                            Click="NavHitReg_Click"/>
                    <Button x:Name="NavMusic" app:NavIcon.Glyph="&#xE8D6;" Content="MUSIC" Style="{StaticResource NavButton}"
                            Click="NavMusic_Click"/>
                    <Button x:Name="NavLowerPing" app:NavIcon.Glyph="&#xE774;" Content="LOWER PING" Style="{StaticResource NavButton}"
                            Click="NavLowerPing_Click"/>
                    <Button x:Name="NavSocd" app:NavIcon.Glyph="&#xE962;" Content="SOCD" Style="{StaticResource NavButton}"
                            Click="NavSocd_Click"/>
                    <Button x:Name="NavOverlays" app:NavIcon.Glyph="&#xE7F4;" Content="OVERLAYS" Style="{StaticResource NavButton}"
                            Click="NavOverlays_Click"/>
                    <Button x:Name="NavScore" app:NavIcon.Glyph="&#xE734;" Content="SCOREBOARD" Style="{StaticResource NavButton}"
                            Click="NavScore_Click"/>
                    <Button x:Name="NavEditor" app:NavIcon.Glyph="&#xE714;" Content="VIDEO EDITOR" Style="{StaticResource NavButton}"
                            Click="NavEditor_Click"/>
                    <Button x:Name="NavSetups" app:NavIcon.Glyph="&#xE7FC;" Content="SETUPS" Style="{StaticResource NavButton}"
                            Click="NavSetups_Click"/>
                    <Button x:Name="NavMod" app:NavIcon.Glyph="&#xE8F1;" Content="MOD" Style="{StaticResource NavButton}"
                            Click="NavMod_Click"/>
                    <Button x:Name="NavDisplay" app:NavIcon.Glyph="&#xE7F4;" Content="DISPLAY" Style="{StaticResource NavButton}"
                            Click="NavDisplay_Click"/>
                    <Button x:Name="NavServer" app:NavIcon.Glyph="&#xE774;" Content="SERVER" Style="{StaticResource NavButton}"
                            Click="NavServer_Click"/>
                    <Button x:Name="NavTrainer" app:NavIcon.Glyph="&#xE1D2;" Content="AIM TRAINER" Style="{StaticResource NavButton}"
                            Click="NavTrainer_Click"/>
                </StackPanel>

                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Two columns rather than overlapping panels in one cell, so the
                 status block can never ride over the title at narrow widths. -->
            <Grid Grid.Row="0" Margin="2,0,2,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Accent rule under the title rather than a subtitle hanging
                     softly beneath it. Squares the header off. -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitleText" Text="CLICKER" FontSize="28" FontWeight="Black"
                               Foreground="{StaticResource TextBright}"/>
                    <Border Height="3" Width="34" Background="{StaticResource Accent}"
                            HorizontalAlignment="Left" Margin="0,5,0,0"/>
                    <TextBlock x:Name="PageSubtitleText" Text="Set how fast you click and how it behaves"
                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,7,0,0"/>
                </StackPanel>

                <!-- Pill and button share an explicit height so they align.
                     Only shown on the Clicker page. -->
                <StackPanel x:Name="StatusBlock" Grid.Column="1"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HideValuesButton" Content="Hide values"
                            Click="HideValues_Click" Height="40" Padding="16,0" Margin="0,0,10,0"
                            ToolTip="Masks the CPS and duty cycle so they are not readable on screen"/>
                    <Border Background="{StaticResource Panel2}" CornerRadius="1" Height="40" Padding="14,0"
                            Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                     Fill="{StaticResource TextMuted}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="IDLE" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="StartStopButton" Content="F6  START"
                            Style="{StaticResource AccentButton}"
                            Click="StartStop_Click" Width="120" Height="40"
                            Margin="0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- One page visible at a time. Every page shares the header, the
                 status pill and the start button above. -->
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
              <Grid>
                <StackPanel x:Name="PageClicker">

                    <!-- What is actually leaving the app, as opposed to what the
                         sliders were set to. These are routinely not the same
                         number, and until now the difference was an 11px hint
                         under a slider showing the larger, wrong one. -->
                    <Border Background="{StaticResource Panel}" CornerRadius="8"
                            BorderThickness="1" BorderBrush="{StaticResource Outline}"
                            Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="ACTUALLY SENDING" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OutputSetText" DockPanel.Dock="Right"
                                           Text="set 10.0 /s" Foreground="{StaticResource TextMuted}"
                                           FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock x:Name="OutputRateText" Text="â€”"
                                           FontSize="38" FontWeight="Black"
                                           Foreground="{StaticResource TextBright}"/>
                                <TextBlock Text="clicks / sec" VerticalAlignment="Bottom"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="12" Margin="9,0,0,8"/>
                            </StackPanel>

                            <!-- Accent only when the two disagree. A verdict that
                                 is always lit stops being read. -->
                            <TextBlock x:Name="OutputVerdictText"
                                       Text="Start clicking to measure what the game actually receives."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Stats -->
                    <UniformGrid Columns="2" Margin="0,0,0,14">
                        <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="16" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="CPU" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                <!-- The two tiles measure different things: CPU is
                                     the whole machine, RAM is this process. Said
                                     out loud so they cannot be read as a pair. -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="CpuText" Text="--%" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="(All Processes)" VerticalAlignment="Bottom"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" Margin="7,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="16" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="RAM" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="RamText" Text="-- GB" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="(All Processes)" VerticalAlignment="Bottom"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" Margin="7,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Keybind / Mode on the left, the two rates on the right. -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <!-- Button choice, spanning both columns. -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ControlCard}"
                                Margin="0,0,7,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                    <Border Style="{StaticResource CardIconChip}">
                                        <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE765;"/>
                                    </Border>
                                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Hotkeys"/>
                                        <TextBlock Style="{StaticResource CardSubtitle}" Text="Keys that start and stop the clicker"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel LastChildFill="False">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="KEYBIND" Style="{StaticResource CardLabel}"/>
                                        <TextBlock Text="Starts and stops clicking"
                                                   Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Button x:Name="ClearClickKey" Tag="Click" Style="{StaticResource ClearBindingButton}"
                                            Click="ClearBinding_Click" DockPanel.Dock="Right"/>
                                    <Button x:Name="HotkeyButton" Content="F6" Click="Hotkey_Click"
                                            DockPanel.Dock="Right" VerticalAlignment="Center"
                                            ToolTip="Click, then press a key or a mouse button. Any mouse button works except left, and whichever one the clicker is set to send. Delete unbinds it, Escape leaves it alone. If a button does nothing at all here, your mouse software has taken it over - set it back to a plain mouse button there."
                                            FontSize="17" FontWeight="Bold"
                                            Height="42" MinWidth="96"
                                            Padding="16,0" Margin="0"/>
                                </DockPanel>

                                <Separator Opacity=".15" Margin="0,12,0,10"/>

                                <DockPanel LastChildFill="False">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="AUTOCLICKER + SHAKE" Style="{StaticResource CardLabel}"/>
                                        <TextBlock Text="Starts and stops both together"
                                                   Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Button x:Name="ClearComboKey" Tag="Combo" Style="{StaticResource ClearBindingButton}"
                                            Click="ClearBinding_Click" DockPanel.Dock="Right"/>
                                    <Button x:Name="ComboHotkeyButton" Content="Not set"
                                            Click="ComboHotkey_Click"
                                            DockPanel.Dock="Right" VerticalAlignment="Center"
                                            ToolTip="Click, then press a key or a mouse button. Any mouse button works except left, and whichever one the clicker is set to send. Delete unbinds it, Escape leaves it alone. If a button does nothing at all here, your mouse software has taken it over - set it back to a plain mouse button there."
                                            FontSize="17" FontWeight="Bold"
                                            Height="42" MinWidth="96"
                                            Padding="16,0" Margin="0"/>
                                </DockPanel>

                                <Separator Opacity=".15" Margin="0,12,0,10"/>

                                <DockPanel LastChildFill="False">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="AUTOCLICKER + SWITCHER" Style="{StaticResource CardLabel}"/>
                                        <TextBlock Text="Starts and stops both together"
                                                   Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Button x:Name="ClearClickSwitchKey" Tag="ClickSwitch" Style="{StaticResource ClearBindingButton}"
                                            Click="ClearBinding_Click" DockPanel.Dock="Right"/>
                                    <Button x:Name="ClickSwitchHotkeyButton" Content="Not set"
                                            Click="ClickSwitchHotkey_Click"
                                            DockPanel.Dock="Right" VerticalAlignment="Center"
                                            ToolTip="Click, then press a key or a mouse button. Any mouse button works except left, and whichever one the clicker is set to send. Delete unbinds it, Escape leaves it alone. If a button does nothing at all here, your mouse software has taken it over - set it back to a plain mouse button there."
                                            FontSize="17" FontWeight="Bold"
                                            Height="42" MinWidth="96"
                                            Padding="16,0" Margin="0"/>
                                </DockPanel>

                                <Separator Opacity=".15" Margin="0,12,0,10"/>

                                <DockPanel LastChildFill="True">
                                    <Button x:Name="ClearBuildKey" Tag="Build" Style="{StaticResource ClearBindingButton}"
                                            Click="ClearBinding_Click" DockPanel.Dock="Right"/>
                                    <Button x:Name="BuildHotkeyButton" Content="Not set"
                                            Click="BuildHotkey_Click"
                                            DockPanel.Dock="Right" VerticalAlignment="Center"
                                            ToolTip="Click, then press a key or a mouse button. Any mouse button works except left, and whichever one the clicker is set to send. Delete unbinds it, Escape leaves it alone. If a button does nothing at all here, your mouse software has taken it over - set it back to a plain mouse button there."
                                            FontSize="17" FontWeight="Bold"
                                            Height="42" MinWidth="96"
                                            Padding="16,0" Margin="0"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="BUILDING" Style="{StaticResource CardLabel}"/>
                                        <TextBlock Text="A steady 35 a second for placing blocks. Ignores your CPS"
                                                   Style="{StaticResource CardHint}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ControlCard}"
                                Margin="7,0,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                    <Border Style="{StaticResource CardIconChip}">
                                        <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE7C9;"/>
                                    </Border>
                                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Click rate"/>
                                        <TextBlock Style="{StaticResource CardSubtitle}" Text="Clicks sent each second"/>
                                    </StackPanel>
                                    <TextBox x:Name="CpsValueBox" DockPanel.Dock="Right" Text="10.0"
                                             Style="{StaticResource NumericValueBox}" VerticalAlignment="Center"
                                             KeyDown="CpsValueBox_KeyDown"
                                             LostFocus="CpsValueBox_LostFocus"/>
                                </DockPanel>
                                <!-- 0 CPS means armed but idle; see ClickLoop. -->
                                <Slider x:Name="CpsSlider" Minimum="0" Maximum="1000" Value="10"
                                        Margin="0,2,0,0" TickFrequency="50"
                                        ValueChanged="CpsSlider_ValueChanged"/>
                                <Grid Margin="0,5,0,0">
                                    <TextBlock Style="{StaticResource SliderTick}" Text="0" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource SliderTick}" Text="500" HorizontalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource SliderTick}" Text="1000" HorizontalAlignment="Right"/>
                                </Grid>
                                <!-- Clicks actually delivered, not clicks requested. -->
                                <TextBlock x:Name="MeasuredCpsText" Text="Measured â€” /s"
                                           Style="{StaticResource CardHint}" Margin="0,8,0,0"/>
                                <!-- Only shown while HitFix is overriding the sliders. -->
                                <TextBlock x:Name="HitFixClampText" Visibility="Collapsed"
                                           Foreground="{StaticResource Accent}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource ControlCard}"
                                Margin="0,14,0,0">
                            <DockPanel LastChildFill="False">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE962;"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                                    <TextBlock Text="Button" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Which button gets clicked â€” right for blocks, wheel for scroll-bound actions"
                                               Style="{StaticResource CardSubtitle}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <RadioButton x:Name="LeftButtonMode" Content="Left" GroupName="ClickButton"
                                                 Style="{StaticResource SegmentButton}" Tag="Left"
                                                 IsChecked="True" MinWidth="72"
                                                 Checked="ClickButton_Checked"/>
                                    <RadioButton x:Name="RightButtonMode" Content="Right" GroupName="ClickButton"
                                                 Style="{StaticResource SegmentButton}" Tag="Right"
                                                 MinWidth="72" Checked="ClickButton_Checked"/>
                                    <RadioButton x:Name="MiddleButtonMode" Content="Wheel" GroupName="ClickButton"
                                                 Style="{StaticResource SegmentButton}" Tag="Middle"
                                                 MinWidth="72" Margin="0" Checked="ClickButton_Checked"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ControlCard}"
                                Margin="0,0,7,0">
                            <DockPanel LastChildFill="False">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE8AB;"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                                    <TextBlock Text="Mode" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Hold the key, or press to latch"
                                               Style="{StaticResource CardSubtitle}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <RadioButton x:Name="HoldModeButton" Content="Hold" GroupName="ClickMode"
                                                 Style="{StaticResource SegmentButton}"
                                                 Checked="HoldMode_Checked" MinWidth="76"/>
                                    <RadioButton x:Name="ToggleModeButton" Content="Toggle" GroupName="ClickMode"
                                                 IsChecked="True" Margin="0"
                                                 Style="{StaticResource SegmentButton}"
                                                 Checked="ToggleMode_Checked" MinWidth="76"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ControlCard}"
                                Margin="7,0,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                    <Border Style="{StaticResource CardIconChip}">
                                        <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE916;"/>
                                    </Border>
                                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Duty cycle"/>
                                        <TextBlock Style="{StaticResource CardSubtitle}" Text="How long each click is held"/>
                                    </StackPanel>
                                    <!-- Declared before the box so it docks furthest right. -->
                                    <TextBlock Text="%" DockPanel.Dock="Right" Margin="4,0,0,0"
                                               Foreground="{StaticResource Accent}"
                                               FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBox x:Name="CdcValueBox" DockPanel.Dock="Right" Text="67.0"
                                             Style="{StaticResource NumericValueBox}" VerticalAlignment="Center"
                                             KeyDown="CdcValueBox_KeyDown"
                                             LostFocus="CdcValueBox_LostFocus"/>
                                </DockPanel>
                                <Slider x:Name="CdcSlider" Minimum="0" Maximum="100" Value="67"
                                        Margin="0,2,0,0" TickFrequency="10"
                                        ValueChanged="CdcSlider_ValueChanged"/>
                                <Grid Margin="0,5,0,0">
                                    <TextBlock Style="{StaticResource SliderTick}" Text="Tap" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource SliderTick}" Text="50%" HorizontalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource SliderTick}" Text="Held" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Precision -->
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE90F;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Precision"/>
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="Fine-tune how the click stream behaves"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,7">
                                <StackPanel>
                                    <TextBlock Text="Ultra Accuracy" FontWeight="SemiBold"/>
                                    <TextBlock Text="Keeps your clicks evenly spaced. Uses a little more CPU"
                                               Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                                <CheckBox x:Name="UltraAccuracy" HorizontalAlignment="Right"
                                          Checked="EngineSetting_Changed" Unchecked="EngineSetting_Changed"/>
                            </Grid>

                            <Separator Opacity=".15"/>

                            <Grid Margin="0,7">
                                <StackPanel>
                                    <TextBlock Text="Ping Sync" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PingStatusText"
                                               Text="Keeps clicks steady when your connection lags"
                                               Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                                <CheckBox x:Name="PingSync" HorizontalAlignment="Right"
                                          Checked="EngineSetting_Changed" Unchecked="EngineSetting_Changed"/>
                            </Grid>

                            <Separator Opacity=".15"/>

                            <Grid Margin="0,7">
                                <StackPanel>
                                    <TextBlock Text="HitFix" FontWeight="SemiBold"/>
                                    <TextBlock Text="Holds every click long enough for the game to read it. Caps very high CPS"
                                               Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                                <CheckBox x:Name="HitFix" HorizontalAlignment="Right" IsChecked="True"
                                          Checked="EngineSetting_Changed" Unchecked="EngineSetting_Changed"/>
                            </Grid>

                            <!-- The four corners always stop the clicker and have no
                                 toggle. Only this wider zone is optional, because it
                                 is the one that fires by accident. -->
                            <Grid Margin="0,7">
                                <StackPanel>
                                    <TextBlock Text="Stop At Taskbar" FontWeight="SemiBold"/>
                                    <TextBlock Text="Also stops when the pointer reaches the taskbar or the top of a screen. Throwing the mouse into a corner always stops it, with or without this"
                                               Foreground="{StaticResource TextMuted}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,0,40,0"/>
                                </StackPanel>
                                <CheckBox x:Name="StopAtTaskbar" HorizontalAlignment="Right"
                                          VerticalAlignment="Top" Margin="0,1,0,0"
                                          Checked="EngineSetting_Changed" Unchecked="EngineSetting_Changed"/>
                            </Grid>

                            <Separator Opacity=".15"/>

                            <!-- Humanize is the opposite of Ultra Accuracy: it adds
                                 random spacing so the stream is less robotic, at the
                                 cost of a little hit-reg consistency. Off at 0. -->
                            <Grid Margin="0,7,0,0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Humanize" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HumanizeValueText" DockPanel.Dock="Right" Text="Off"
                                               Foreground="{StaticResource TextMuted}" FontSize="11"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="Randomises the gap between clicks so the pattern looks less robotic. Higher is more random"
                                           Foreground="{StaticResource TextMuted}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,18,0,0"/>
                                <Slider x:Name="HumanizeSlider" Minimum="0" Maximum="100" Value="0"
                                        Margin="0,46,0,0" TickFrequency="10"
                                        ValueChanged="Humanize_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Shaky Tracking â€” its own tab under CLICKER. Free. The engine reads
                     these through _settings like the other clicker controls. -->
                <StackPanel x:Name="PageShake" Visibility="Collapsed">

                    <!-- Enable + what it is -->
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel Margin="0,0,54,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource CardIconChip}">
                                        <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xEA80;"/>
                                    </Border>
                                    <TextBlock Text="Shaky tracking" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="ShakeStatusText" Margin="0,8,0,0"
                                           Text="Nudges your aim a little while clicking, like a hand that never sits perfectly still. Only shakes when you start with the AUTOCLICKER + SHAKE hotkey â€” the plain clicker key never shakes."
                                           Foreground="{StaticResource TextMuted}" FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="ShakyTracking" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,1,0,0"
                                      Checked="EngineSetting_Changed" Unchecked="EngineSetting_Changed"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Range + speed + smoothness -->
                        <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8"
                                BorderThickness="1" BorderBrush="{StaticResource Outline}"
                                Padding="18" Margin="0,0,7,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Style="{StaticResource CardIconChip}">
                                        <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE916;"/>
                                    </Border>
                                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Range &amp; speed"/>
                                        <TextBlock Style="{StaticResource CardSubtitle}" Text="How far, how fast, how smooth the nudge moves"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="LEFT" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                    <Slider Grid.Column="1" x:Name="ShakeLeftSlider" Minimum="0" Maximum="100" Value="8" TickFrequency="5" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="ShakeSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="ShakeLeftValue" Text="8" Style="{StaticResource SliderValueBox}" KeyDown="ShakeValue_KeyDown" LostFocus="ShakeValue_LostFocus"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="RIGHT" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                    <Slider Grid.Column="1" x:Name="ShakeRightSlider" Minimum="0" Maximum="100" Value="20" TickFrequency="5" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="ShakeSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="ShakeRightValue" Text="20" Style="{StaticResource SliderValueBox}" KeyDown="ShakeValue_KeyDown" LostFocus="ShakeValue_LostFocus"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="UP" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                    <Slider Grid.Column="1" x:Name="ShakeUpSlider" Minimum="0" Maximum="100" Value="40" TickFrequency="5" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="ShakeSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="ShakeUpValue" Text="40" Style="{StaticResource SliderValueBox}" KeyDown="ShakeValue_KeyDown" LostFocus="ShakeValue_LostFocus"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DOWN" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                    <Slider Grid.Column="1" x:Name="ShakeDownSlider" Minimum="0" Maximum="100" Value="8" TickFrequency="5" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="ShakeSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="ShakeDownValue" Text="8" Style="{StaticResource SliderValueBox}" KeyDown="ShakeValue_KeyDown" LostFocus="ShakeValue_LostFocus"/>
                                </Grid>

                                <Separator Opacity=".15" Margin="0,10,0,4"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SPEED" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                    <Slider Grid.Column="1" x:Name="ShakeSpeedSlider" Minimum="5" Maximum="50" Value="33" TickFrequency="5" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="ShakeSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="ShakeSpeedValue" Text="33" Style="{StaticResource SliderValueBox}" ToolTip="Movements per second" KeyDown="ShakeValue_KeyDown" LostFocus="ShakeValue_LostFocus"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SMOOTH" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                    <Slider Grid.Column="1" x:Name="ShakeSmoothSlider" Minimum="0" Maximum="100" Value="60" TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="ShakeSlider_ValueChanged"/>
                                    <TextBox Grid.Column="2" x:Name="ShakeSmoothValue" Text="60" Style="{StaticResource SliderValueBox}" ToolTip="0 = sharp jitter, 100 = smooth glide" KeyDown="ShakeValue_KeyDown" LostFocus="ShakeValue_LostFocus"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Save" Click="SaveShake_Click" ToolTip="Remember these values" Padding="12,5" Margin="0,0,8,0" FontSize="11"/>
                                    <Button x:Name="RestoreShakeButton" Content="Restore" Click="RestoreShake_Click" IsEnabled="False" Padding="12,5" Margin="0" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Live preview: the dashed box is the range, the faint cross is
                             where the cursor rests, the trail is the path, driven by the
                             exact easing the engine uses. -->
                        <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8"
                                BorderThickness="1" BorderBrush="{StaticResource Outline}"
                                Padding="18" Margin="7,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource CardIconChip}">
                                        <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE7F4;"/>
                                    </Border>
                                    <TextBlock Text="Preview" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="A live look at the motion. Dashed box = range, cross = resting point, trail = the path it takes."
                                           Foreground="{StaticResource TextMuted}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <Border Height="212" CornerRadius="4" Background="{StaticResource Panel2}"
                                        BorderThickness="1" BorderBrush="{StaticResource Outline}" ClipToBounds="True">
                                    <Canvas x:Name="ShakePreviewCanvas" ClipToBounds="True">
                                        <Rectangle x:Name="ShakeBoundsBox" Stroke="{StaticResource Accent}"
                                                   StrokeThickness="1" Opacity="0.22"
                                                   RadiusX="2" RadiusY="2" StrokeDashArray="3 3"/>
                                        <Line x:Name="ShakeOriginH" Stroke="{StaticResource TextMuted}"
                                              StrokeThickness="1" Opacity="0.45"/>
                                        <Line x:Name="ShakeOriginV" Stroke="{StaticResource TextMuted}"
                                              StrokeThickness="1" Opacity="0.45"/>
                                        <Polyline x:Name="ShakeTrail" Stroke="{StaticResource Accent}"
                                                  StrokeThickness="2" Opacity="0.35" StrokeLineJoin="Round"/>
                                        <Ellipse x:Name="ShakePreviewDot" Width="12" Height="12"
                                                 Fill="{StaticResource Accent}"/>
                                    </Canvas>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>

                <!-- Hit registration (Plus). Its own tab in the PLUS group. Everything
                     here is about landing more of the clicks you send; the engine reads
                     these toggles through _settings like any other clicker control. -->
                <StackPanel x:Name="PageHitReg" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="8"
                            BorderThickness="1" BorderBrush="{StaticResource Outline}"
                            Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE945;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Registration"/>
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="Land the most hits the game will accept"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Auto-tune -->
                            <Grid Margin="0,12,0,0">
                                <StackPanel Margin="0,0,54,0">
                                    <TextBlock Text="Auto-tune (max hits)" FontWeight="SemiBold"/>
                                    <TextBlock Text="Locks your rate to the speed measured to land the most hits (~33/s) and keeps it rock-steady so no click drifts past the game's hit window. Clicking faster doesn't land more â€” it floods the server. Uses a little more CPU."
                                               Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoTuneToggle" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Margin="0,1,0,0"
                                          Checked="EngineSetting_Changed" Unchecked="EngineSetting_Changed"/>
                            </Grid>

                            <Separator Opacity=".12" Margin="0,14"/>

                            <!-- Blockhit assist -->
                            <Grid>
                                <StackPanel Margin="0,0,54,0">
                                    <TextBlock Text="Blockhit assist" FontWeight="SemiBold"/>
                                    <TextBlock Text="Raises your sword block between hits to cut the knockback you take. It needs room to block, so it works at moderate CPS â€” not at the auto-tune ceiling."
                                               Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="BlockHitToggle" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Margin="0,1,0,0"
                                          Checked="EngineSetting_Changed" Unchecked="EngineSetting_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8"
                            BorderThickness="1" BorderBrush="{StaticResource Outline}"
                            Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE90F;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Combat profiles"/>
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="One-click setting bundles for the situation"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="The registration ceiling is the same for every sword, so these tune your rate and blocking for the situation â€” not fake per-weapon speed."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <StackPanel x:Name="CombatProfileRow" Orientation="Horizontal"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Music (Plus). Hosts YouTube Music in an embedded web view, so a
                     song is one search away and keeps playing while you game. The
                     page is sized to the scroll viewport so the web view gets a real
                     height; a StackPanel would measure it at infinity and collapse it. -->
                <Grid x:Name="PageMusic" Visibility="Collapsed"
                      Height="{Binding ViewportHeight, ElementName=PageScroll}">

                    <!-- The web view fills the page; searching happens inside
                         YouTube Music's own page. A fallback shows when the Edge
                         WebView2 runtime is missing or fails to start. -->
                    <Border CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource Outline}" ClipToBounds="True">
                        <Grid>
                            <wv2:WebView2 x:Name="MusicWeb"/>
                            <StackPanel x:Name="MusicFallback" Visibility="Collapsed"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        MaxWidth="420">
                                <TextBlock Text="Music needs the Edge WebView2 runtime"
                                           FontWeight="SemiBold" FontSize="14"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="MusicFallbackText"
                                           Text="It ships with Windows 11 and Microsoft Edge, so most PCs already have it. If this keeps showing, install the free runtime and reopen this tab."
                                           Foreground="{StaticResource TextMuted}" FontSize="12"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                                <Button Content="Get the WebView2 runtime" Click="MusicGetRuntime_Click"
                                        Style="{StaticResource AccentButton}" Height="36" Padding="16,0"
                                        HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Lower Ping (Plus). One switch to stop Windows adding latency,
                     plus the same network tweaks as individual toggles. Same
                     reversible contract as Gaming Mode. -->
                <StackPanel x:Name="PageLowerPing" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource Accent}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="LOWER PING" Foreground="{StaticResource Accent}"
                                           FontSize="13" FontWeight="Black" VerticalAlignment="Center"/>
                                <Border DockPanel.Dock="Right" Background="{StaticResource Accent}"
                                        CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="â˜… PLUS" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="One switch to stop Windows adding its own latency â€” disables network throttling and Nagle batching, stops update sharing and background Store apps, and keeps Wi-Fi at full power. All reversible."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Button x:Name="LowerPingButton" Content="ACTIVATE LOWER PING"
                                    Click="LowerPing_Click" Padding="16,10" FontWeight="Bold" FontSize="14"
                                    HorizontalAlignment="Left" Margin="0,14,0,0"/>

                            <TextBlock x:Name="LowerPingStatusText"
                                       Text="Off. One switch to stop Windows adding latency â€” fully reversible."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>

                            <TextBlock Text="Honest: these stop Windows throttling and batching on your own PC. They can't shorten the path to the server, so on an idle connection there's nothing to clear. The machine-wide ones (throttling, Nagle, update sharing) need the app running as administrator; without that it applies the rest."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.85"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE774;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Network tweaks"/>
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="Turn these on individually, or use the switch above"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl x:Name="LowerPingTweakList" Margin="0,8,0,0"
                                          ItemTemplate="{StaticResource TweakToggleRow}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Remaining pages: same chrome, no components yet. -->
                <StackPanel x:Name="PagePresets" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE734;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Click presets"/>
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="Saved CPS / duty-cycle combos"/>
                                </StackPanel>
                                <TextBlock x:Name="PresetAppliedText" DockPanel.Dock="Right"
                                           Text="No preset applied" FontSize="11"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                                <Button DockPanel.Dock="Right" Content="Restore defaults"
                                        Click="RestoreDefaults_Click" Padding="10,5" Margin="0"
                                        FontSize="11"
                                        ToolTip="Adds back any default preset you have removed"/>
                            </DockPanel>

                            <TextBlock x:Name="PresetEmptyText" Visibility="Collapsed"
                                       Text="No presets. Add one below, or restore the defaults."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       Margin="0,14,0,0"/>

                            <ItemsControl x:Name="PresetList" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="176" Margin="0,0,10,10">
                                            <Button Click="PresetCard_Click"
                                                    Style="{StaticResource PresetCard}"
                                                    ToolTip="Apply this preset">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <TextBlock Text="{Binding CpsText}" FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource Accent}"/>
                                                        <TextBlock Text=" CPS" FontSize="11"
                                                                   Foreground="{StaticResource TextMuted}"/>
                                                        <TextBlock Text="  Â·  " FontSize="11"
                                                                   Foreground="{StaticResource TextMuted}"/>
                                                        <TextBlock Text="{Binding CdcText}" FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource Accent}"/>
                                                        <TextBlock Text="% CDC" FontSize="11"
                                                                   Foreground="{StaticResource TextMuted}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ExtrasText}" FontSize="10"
                                                               Foreground="{StaticResource TextMuted}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,4,0,0"/>
                                                    <Border Height="3" Width="134" CornerRadius="2"
                                                            Background="{StaticResource Track}"
                                                            HorizontalAlignment="Left" Margin="0,9,0,0">
                                                        <Border Height="3" CornerRadius="2"
                                                                Background="{StaticResource Accent}"
                                                                Width="{Binding BarWidth}"
                                                                HorizontalAlignment="Left"/>
                                                    </Border>
                                                </StackPanel>
                                            </Button>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Button Content="&#9998;" Click="EditPreset_Click"
                                                        Style="{StaticResource PresetDelete}"
                                                        ToolTip="Load this preset for editing"
                                                        Margin="0,6,2,0"/>
                                                <Button Content="&#215;" Click="DeletePreset_Click"
                                                        Style="{StaticResource PresetDelete}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE713;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Custom preset"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="CustomPresetHint"
                                       Text="Name it, set CPS and CDC, and it is saved between sessions"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="NewPresetName" Grid.Column="0"
                                         Style="{StaticResource FieldBox}" Margin="0,0,10,0"
                                         KeyDown="NewPreset_KeyDown"/>
                                <TextBox x:Name="NewPresetCps" Grid.Column="1"
                                         Style="{StaticResource NumericFieldBox}" Margin="0,0,10,0"
                                         MaxLength="6" KeyDown="NewPreset_KeyDown"/>
                                <TextBox x:Name="NewPresetCdc" Grid.Column="2"
                                         Style="{StaticResource NumericFieldBox}" Margin="0,0,10,0"
                                         MaxLength="6" KeyDown="NewPreset_KeyDown"/>
                                <Button Grid.Column="3" Content="+  Save" Click="SavePreset_Click"
                                        Style="{StaticResource AccentButton}"
                                        Height="34" Width="96" Margin="0"/>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="106"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="NAME" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="1" Text="CPS" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="2" Text="CDC %" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Macros: any key, any rate, as many as you like. -->
                <StackPanel x:Name="PageMacros" Visibility="Collapsed">
                    <UniformGrid x:Name="PageAutomationBar" Columns="2" Margin="0,0,0,14">
                        <RadioButton Content="Macros" GroupName="PageAutomationTab" Tag="PageAutomation_macros" IsChecked="True" Style="{StaticResource SegmentButton}" Checked="PageTab_Checked"/>
                        <RadioButton Content="Auto Switcher" GroupName="PageAutomationTab" Tag="PageAutomation_switcher" Margin="0" Style="{StaticResource SegmentButton}" Checked="PageTab_Checked"/>
                    </UniformGrid>
                    <StackPanel x:Name="PageAutomation_macros">
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <DockPanel LastChildFill="False">
                            <Border Style="{StaticResource CardIconChip}">
                                <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE765;"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                                <TextBlock Text="Macros" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="MacrosHotkeyKillNote"
                                           Text="Switch every macro off at once, without losing what they are set to."
                                           Style="{StaticResource CardSubtitle}"/>
                            </StackPanel>
                            <Button x:Name="MacrosHotkeysOffButton" DockPanel.Dock="Right"
                                    Content="TURN HOTKEYS ON" Visibility="Collapsed"
                                    Click="HotkeyKill_Click" Height="40" MinWidth="170"
                                    Padding="16,0" FontWeight="Bold" VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    ToolTip="Every hotkey in the app is switched off, from the Settings page. This turns them back on."/>
                            <Button x:Name="MacrosHotkeyKill" DockPanel.Dock="Right" Content="DISABLE ALL"
                                    Click="DisableAllMacros_Click" Height="40" MinWidth="170"
                                    Padding="16,0" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE768;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Running"/>
                                </StackPanel>
                                <Button x:Name="StopAllMacrosButton" DockPanel.Dock="Right"
                                        Content="Stop all" Click="StopAllMacros_Click"
                                        Padding="14,6" FontSize="11"/>
                            </DockPanel>
                            <TextBlock x:Name="MacroRunningText" Text="Nothing running."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="A macro types a key over and over while it is on. It goes to whatever window is in front, so switch to the game before starting one."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="MacroList" Margin="0,0,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE765;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="New macro"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="One letter or digit per box. Fill the second and the macro alternates between the two; leave it empty and it just spams the first."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBox x:Name="MacroNameBox" Style="{StaticResource FieldBox}"/>
                                    <TextBlock Text="NAME" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBox x:Name="MacroKey1Box" Style="{StaticResource FieldBox}"
                                             MaxLength="1"/>
                                    <TextBlock Text="KEY" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBox x:Name="MacroKey2Box" Style="{StaticResource FieldBox}"
                                             MaxLength="1"/>
                                    <TextBlock Text="2ND KEY (OPTIONAL)" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <DockPanel>
                                        <Button x:Name="ClearNewMacroKey" DockPanel.Dock="Right"
                                                Style="{StaticResource ClearBindingButton}"
                                                Height="34" Width="34"
                                                Visibility="Collapsed"
                                                Click="ClearNewMacroHotkey_Click"/>
                                        <Button x:Name="NewMacroHotkeyButton" Content="Not set"
                                                Click="NewMacroHotkey_Click"
                                                ToolTip="Click, then press a key or a mouse button. Any mouse button works except left, and whichever one the clicker is set to send. Delete unbinds it, Escape leaves it alone. If a button does nothing at all here, your mouse software has taken it over - set it back to a plain mouse button there."
                                                Height="34" Padding="12,0"/>
                                    </DockPanel>
                                    <TextBlock Text="TOGGLE HOTKEY (OPTIONAL)" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="8">
                                    <TextBox x:Name="MacroIntervalBox" Style="{StaticResource NumericFieldBox}"/>
                                    <TextBlock Text="EVERY (MS)" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="10" x:Name="SaveMacroButton" Content="+  Save"
                                        Style="{StaticResource AccentButton}" Click="SaveMacro_Click"
                                        Height="34" Padding="20,0" VerticalAlignment="Top"/>
                            </Grid>

                            <TextBlock x:Name="MacroErrorText" Visibility="Collapsed"
                                       Foreground="{StaticResource Accent}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- Auto Switcher: the same engine, two keys, one purpose. -->
                    <StackPanel x:Name="PageAutomation_switcher" Visibility="Collapsed">
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <DockPanel LastChildFill="False">
                            <Border Style="{StaticResource CardIconChip}">
                                <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE8AB;"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                                <TextBlock Text="Switchers" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="SwitcherHotkeyKillNote"
                                           Text="Switch every auto switcher off at once, without losing what it is set to."
                                           Style="{StaticResource CardSubtitle}"/>
                            </StackPanel>
                            <Button x:Name="SwitcherHotkeysOffButton" DockPanel.Dock="Right"
                                    Content="TURN HOTKEYS ON" Visibility="Collapsed"
                                    Click="HotkeyKill_Click" Height="40" MinWidth="170"
                                    Padding="16,0" FontWeight="Bold" VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    ToolTip="Every hotkey in the app is switched off, from the Settings page. This turns them back on."/>
                            <Button x:Name="SwitcherHotkeyKill" DockPanel.Dock="Right" Content="DISABLE ALL"
                                    Click="DisableAllSwitchers_Click" Height="40" MinWidth="170"
                                    Padding="16,0" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- One card per saved switcher, built in code: how many
                         there are is not known until the app runs, the same as
                         the macro list. -->
                    <WrapPanel x:Name="SwitcherList" Margin="0,0,0,4"/>

                    <TextBlock x:Name="SwitcherEmptyText" Visibility="Collapsed"
                               Text="No switchers saved yet. Fill in the boxes below and press Save."
                               Foreground="{StaticResource TextMuted}" FontSize="11"
                               Margin="0,0,0,14"/>

                    <TextBlock x:Name="SwitcherCountText" Text=""
                               Foreground="{StaticResource Accent}" FontSize="11"
                               FontWeight="Bold" Margin="0,0,0,14"/>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE8AB;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="New switcher"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="Swaps between two hotbar slots on a timer &#8212; sword and crossbow, or pickaxe and gumdrop. Name it and you can keep as many as you like, and run several at once."
                                       Style="{StaticResource CardHint}" Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBox x:Name="NewSwitcherName" Style="{StaticResource FieldBox}"/>
                                    <TextBlock Text="NAME" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBox x:Name="NewSwitcherSlotA" Style="{StaticResource FieldBox}" MaxLength="1" Text="4"/>
                                    <TextBlock Text="SLOT 1" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBox x:Name="NewSwitcherSlotB" Style="{StaticResource FieldBox}" MaxLength="1" Text="1"/>
                                    <TextBlock Text="SLOT 2" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBox x:Name="NewSwitcherHoldA" Style="{StaticResource NumericFieldBox}" Text="21"/>
                                    <TextBlock Text="HOLD 1 (MS)" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="8">
                                    <TextBox x:Name="NewSwitcherEquip" Style="{StaticResource NumericFieldBox}" Text="5"/>
                                    <TextBlock Text="EQUIP (MS)" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="10">
                                    <TextBox x:Name="NewSwitcherHoldB" Style="{StaticResource NumericFieldBox}" Text="1300"/>
                                    <TextBlock Text="HOLD 2 (MS)" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="12">
                                    <DockPanel>
                                        <Button x:Name="ClearNewSwitcherKey" DockPanel.Dock="Right"
                                                Style="{StaticResource ClearBindingButton}"
                                                Visibility="Collapsed"
                                                Click="ClearNewSwitcherKey_Click"/>
                                        <Button x:Name="NewSwitcherHotkeyButton" Content="Not set"
                                                Click="NewSwitcherHotkey_Click"
                                                Height="34" MinWidth="92" Padding="10,0" FontWeight="Bold"/>
                                    </DockPanel>
                                    <TextBlock Text="HOTKEY" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="14" Content="+  Save" Click="SaveSwitcher_Click"
                                        Height="34" MinWidth="92" Padding="14,0" FontWeight="Bold"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource Accent}" Foreground="White"/>
                            </Grid>

                            <DockPanel LastChildFill="False" Margin="0,12,0,0">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Start on slot 2" Foreground="{StaticResource TextSoft}" FontSize="12"/>
                                    <TextBlock Text="Equips the second slot first when the switcher turns on, then alternates." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,1,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="NewSwitcherStartSecond" DockPanel.Dock="Right" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock x:Name="NewSwitcherStatus" Text=""
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="KEYBIND" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="Turns the switcher on and off from inside the game"
                                               Style="{StaticResource CardHint}"/>
                                </StackPanel>
                                <Button x:Name="ClearSwitcherKey" Tag="Switcher" Style="{StaticResource ClearBindingButton}"
                                        Click="ClearBinding_Click" DockPanel.Dock="Right"/>
                                <Button x:Name="SwitcherHotkeyButton" Content="Not set"
                                        Click="SwitcherHotkey_Click"
                                        DockPanel.Dock="Right" VerticalAlignment="Center"
                                        ToolTip="Click, then press a key or a mouse button. Any mouse button works except left, and whichever one the clicker is set to send. Delete unbinds it, Escape leaves it alone. If a button does nothing at all here, your mouse software has taken it over - set it back to a plain mouse button there."
                                        FontSize="17" FontWeight="Bold"
                                        Height="42" MinWidth="96" Padding="16,0" Margin="0"/>
                            </DockPanel>

                            <TextBlock Text="Slot keys are just the number keys Roblox already uses â€” the switcher presses 1 and 2 exactly as you would. It does not read the screen or the game."
                                       Style="{StaticResource CardHint}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                </StackPanel>

                <!-- App Targeting: which apps the clicker may click over. Whitelist
                     clicks only over the ticked apps; Blacklist clicks everywhere
                     except them. The app under the pointer is checked before every
                     click. Both lists are kept at once; Mode selects which is used. -->
                <StackPanel x:Name="PageAppTargeting" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE71D;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="App targeting"/>
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="Where the clicker is allowed to fire"/>
                                </StackPanel>
                            </DockPanel>
                            <UniformGrid Columns="3" Margin="0,4,0,0">
                                <RadioButton x:Name="AppTargetOff" Content="Off" GroupName="AppTarget"
                                             Tag="Off" IsChecked="True" Style="{StaticResource SegmentButton}"
                                             Checked="AppTargetMode_Checked"/>
                                <RadioButton x:Name="AppTargetWhitelist" Content="Whitelist" GroupName="AppTarget"
                                             Tag="Whitelist" Style="{StaticResource SegmentButton}"
                                             Checked="AppTargetMode_Checked"/>
                                <RadioButton x:Name="AppTargetBlacklist" Content="Blacklist" GroupName="AppTarget"
                                             Tag="Blacklist" Margin="0" Style="{StaticResource SegmentButton}"
                                             Checked="AppTargetMode_Checked"/>
                            </UniformGrid>
                            <TextBlock x:Name="AppTargetExplain"
                                       Text="Off â€” the clicker clicks everywhere, over any app."
                                       Style="{StaticResource CardHint}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <Border Background="{StaticResource Sunken}" CornerRadius="8" Padding="12,9" Margin="0,12,0,0">
                                <TextBlock x:Name="AppTargetPointer" Text="Under the pointer: â€”"
                                           Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- The list that counts in the current mode. -->
                    <Border x:Name="AppTargetActiveCard" Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE73E;"/>
                                </Border>
                                <TextBlock x:Name="AppTargetActiveHeading" Text="WHITELIST" DockPanel.Dock="Left"
                                           Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                                <TextBlock x:Name="AppTargetActiveCount" DockPanel.Dock="Right" Text="0 apps"
                                           Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>
                            <WrapPanel x:Name="AppTargetChips" Margin="0,10,0,0"/>
                            <TextBlock x:Name="AppTargetEmpty"
                                       Text="No apps yet â€” tick a running app below, or type a program file name."
                                       Style="{StaticResource CardHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <DockPanel LastChildFill="True" Margin="0,14,0,0">
                                <Button Content="Add" DockPanel.Dock="Right" Click="AppTargetAdd_Click"
                                        Style="{StaticResource AccentButton}" Height="34" Padding="18,0" Margin="8,0,0,0"/>
                                <TextBox x:Name="AppTargetAddBox" Style="{StaticResource InputField}"
                                         KeyDown="AppTargetAddBox_KeyDown"
                                         ToolTip="A program file name, such as RobloxPlayerBeta.exe"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Apps with a window right now, to tick on with one click. -->
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE72C;"/>
                                </Border>
                                <TextBlock Text="Running apps" Style="{StaticResource CardTitle}" DockPanel.Dock="Left" Margin="11,0,0,0"/>
                                <Button Content="Refresh" DockPanel.Dock="Right" Click="AppTargetRefresh_Click"
                                        Height="30" Padding="14,0" Margin="0"/>
                            </DockPanel>
                            <StackPanel x:Name="RunningAppsList" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="PageSocd" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE962;"/>
                                </Border>
                                <TextBlock DockPanel.Dock="Left" Text="SOCD cleaner" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="PLUS" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="Cleans opposing movement keys so holding both doesn't fight â€” tap the opposite key and you snap straight to it instead of standing still, like Snap Tap keyboards. Pick WASD to clean both strafe axes, or Custom for one pair you choose. A single key moves you as normal; it's a keyboard input tool and doesn't read the game."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock x:Name="SocdLockNote" Visibility="Collapsed"
                                       Text="SOCD is a Plus feature. Unlock it on the PLUS page."
                                       Foreground="{StaticResource TextSoft}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <StackPanel x:Name="SocdProPanel" Margin="0,4,0,0">
                                <DockPanel LastChildFill="False" Margin="0,12,0,0">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Enable" Foreground="{StaticResource TextSoft}" FontSize="12"/>
                                        <TextBlock Text="Turn the SOCD cleaner on" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="SocdEnabledCheck" DockPanel.Dock="Right" Margin="0" VerticalAlignment="Center"
                                              Checked="SocdEnabled_Changed" Unchecked="SocdEnabled_Changed"/>
                                </DockPanel>

                                <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Margin="0,12,0,0"/>
                                <TextBlock Text="PROFILE" FontSize="9" FontWeight="Bold" Margin="0,12,0,6" Foreground="{StaticResource TextMuted}"/>
                                <WrapPanel>
                                    <RadioButton x:Name="SocdProfileWasd" Content="WASD" GroupName="SocdProfile" Tag="WASD"
                                                 Style="{StaticResource SegmentButton}" MinWidth="82" Checked="SocdProfile_Checked"/>
                                    <RadioButton x:Name="SocdProfileCustom" Content="Custom" GroupName="SocdProfile" Tag="Custom"
                                                 Style="{StaticResource SegmentButton}" MinWidth="82" Checked="SocdProfile_Checked"/>
                                </WrapPanel>
                                <TextBlock Text="WASD cleans both strafe axes (A/D and W/S). Custom cleans one pair of keys you pick."
                                           Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>

                                <StackPanel x:Name="SocdCustomKeys">
                                    <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Margin="0,12,0,0"/>
                                    <TextBlock Text="THE TWO KEYS" FontSize="9" FontWeight="Bold" Margin="0,12,0,6" Foreground="{StaticResource TextMuted}"/>
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBox x:Name="SocdLeftKey" Style="{StaticResource FieldBox}" MaxLength="1" Width="48" Text="A" TextChanged="SocdKeys_Changed"/>
                                            <TextBlock Text="KEY 1" FontSize="9" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBox x:Name="SocdRightKey" Style="{StaticResource FieldBox}" MaxLength="1" Width="48" Text="D" TextChanged="SocdKeys_Changed"/>
                                            <TextBlock Text="KEY 2" FontSize="9" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Overlays: a styled preview of every on-screen widget, plus a
                     grid of toggles. The preview and the cards are built in code
                     (MainWindow.Overlays.cs) so they reuse the real overlay look. -->
                <StackPanel x:Name="PageOverlays" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource Outline}" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="4,2,0,12">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE7F4;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Preview"/>
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="How your overlays sit over the game"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Height="300" CornerRadius="8" ClipToBounds="True"
                                    BorderBrush="{StaticResource Outline}" BorderThickness="1">
                                <Grid x:Name="OverlayPreviewHost"/>
                            </Border>
                            <DockPanel LastChildFill="False" Margin="2,12,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Show" Style="{StaticResource CardSubtitle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <RadioButton x:Name="OverlayShowRoblox" Content="Only Roblox" Tag="roblox" GroupName="OverlayShow"
                                                 IsChecked="True" Style="{StaticResource SegmentButton}" MinWidth="112" Checked="OverlayShowMode_Checked"/>
                                    <RadioButton x:Name="OverlayShowEverywhere" Content="Windows too" Tag="always" GroupName="OverlayShow"
                                                 Style="{StaticResource SegmentButton}" MinWidth="112" Margin="0" Checked="OverlayShowMode_Checked"/>
                                </StackPanel>
                                <Button x:Name="OverlayMoveButton" DockPanel.Dock="Right" Content="Move overlays"
                                        Style="{StaticResource ChipButton}" Padding="14,7" Click="OverlayMove_Click"/>
                            </DockPanel>
                            <TextBlock x:Name="OverlayMoveHint" Visibility="Collapsed"
                                       Text="Drag each overlay where you want it, then click Done moving."
                                       Style="{StaticResource CardSubtitle}" Margin="2,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE71D;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Your overlays"/>
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="Pick which ones show on screen"/>
                                </StackPanel>
                            </StackPanel>
                            <WrapPanel x:Name="OverlayToggleGrid"/>
                        </StackPanel>
                    </Border>


                    <!-- Keystrokes is a grid card now; these controls are kept but
                         hidden because the engine and settings still drive them.
                         Panel background stays on; in-game FPS is covered by the
                         dedicated FPS overlay. Dragging is handled by Move overlays. -->
                    <StackPanel Visibility="Collapsed" Height="0">
                        <TextBlock x:Name="KeystrokesLockNote" Visibility="Collapsed"/>
                        <StackPanel x:Name="KeystrokesProPanel">
                            <CheckBox x:Name="KeystrokesCheck" Checked="KeystrokesEnabled_Changed" Unchecked="KeystrokesEnabled_Changed"/>
                            <CheckBox x:Name="KeystrokesBgCheck" IsChecked="True" Checked="KeystrokesBackground_Changed" Unchecked="KeystrokesBackground_Changed"/>
                            <CheckBox x:Name="KeystrokesFpsCheck" Checked="KeystrokesFps_Changed" Unchecked="KeystrokesFps_Changed"/>
                            <Button x:Name="KeystrokesMoveButton" Click="KeystrokesMove_Click"/>
                            <TextBlock x:Name="KeystrokesHint"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>

                <!-- Scoreboard: follow a real game's live score as an on-screen bug. -->
                <StackPanel x:Name="PageScore" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE734;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Live scoreboard"/>
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="Pick a real game to show its score on screen"/>
                                </StackPanel>
                            </StackPanel>

                            <DockPanel LastChildFill="False">
                                <CheckBox x:Name="ScoreShowCheck" DockPanel.Dock="Left" Content="Show on screen" VerticalAlignment="Center" Click="ScoreShow_Changed"/>
                                <CheckBox x:Name="ScoreLiveOnlyCheck" DockPanel.Dock="Left" Content="Live now only" VerticalAlignment="Center" Margin="18,0,0,0" Click="ScoreLiveOnly_Changed"/>
                                <ComboBox x:Name="ScoreLeagueCombo" DockPanel.Dock="Right" Width="170" Height="32" Style="{StaticResource DarkCombo}" SelectionChanged="ScoreLeague_Changed" Margin="8,0,0,0"/>
                                <Button x:Name="ScoreMoveButton" DockPanel.Dock="Right" Content="Move on screen" Click="ScoreMove_Click" Height="32" Padding="14,0" Margin="8,0,0,0"/>
                                <Button x:Name="ScoreRefreshButton" DockPanel.Dock="Right" Content="Refresh" Click="ScoreRefresh_Click" Height="32" Padding="14,0"/>
                            </DockPanel>
                            <TextBlock x:Name="ScoreStatusText" Text="Loading games&#x2026;" Foreground="{StaticResource TextSoft}" FontSize="12" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE71D;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Today's games"/>
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="Click a game to add it &#x2022; tap &#x2605; to favorite a team (stays on top, shown in yellow)"/>
                                </StackPanel>
                            </StackPanel>
                            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ScoreGameList"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE734;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Favorite teams"/>
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="Search any team and star it &#x2014; favorites stay on top even when they aren't playing"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="TYPE A TEAM NAME OR ABBREVIATION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="2,0,0,4"/>
                            <TextBox x:Name="ScoreTeamSearch" Style="{StaticResource InputField}" TextChanged="ScoreTeamSearch_Changed"/>
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <StackPanel x:Name="ScoreTeamList"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="PageKitWheel" Visibility="Collapsed">
                    <Border Background="#1B1630" CornerRadius="8" BorderThickness="1"
                            BorderBrush="#332A52" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE72C;"/>
                                </Border>
                                <TextBlock Text="Kit randomizer" Style="{StaticResource CardTitle}" DockPanel.Dock="Left" Margin="11,0,0,0"/>
                                <TextBlock x:Name="KitsRemainingText" DockPanel.Dock="Right"
                                           Text="0 KITS REMAINING" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- The reveal. One panel that swaps between asking and
                                 answering, so the result lands where the eye already is. -->
                            <Border Background="#171129" CornerRadius="8"
                                    BorderThickness="1" BorderBrush="#332A52"
                                    Height="250" Margin="0,14,0,0">
                                <Grid x:Name="RevealPanel" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="RevealScale" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="RollBadgeText" Text="KIT ROLL"
                                                   HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"
                                                   Foreground="#A78BFA"/>
                                        <!-- Two identical layers, one fading out as the other fades
                                             in. Fading a single layer down and back up is a
                                             pulse with a gap in the middle; a kit dissolving
                                             into the next one is what reads as smooth. -->
                                        <Grid x:Name="ReelStack" Height="164" Margin="0,10,0,0"
                                              Visibility="Collapsed">
                                            <StackPanel x:Name="ReelLayerA">
                                                <Border Width="104" Height="104" CornerRadius="2"
                                                        ClipToBounds="True" HorizontalAlignment="Center"
                                                        BorderThickness="1" BorderBrush="#332A52">
                                                    <Image x:Name="ReelImageA" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock x:Name="ReelNameA" Text=""
                                                           HorizontalAlignment="Center" Margin="0,10,0,0"
                                                           FontSize="34" FontWeight="Black"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextBright}"/>
                                            </StackPanel>

                                            <StackPanel x:Name="ReelLayerB" Opacity="0">
                                                <Border Width="104" Height="104" CornerRadius="2"
                                                        ClipToBounds="True" HorizontalAlignment="Center"
                                                        BorderThickness="1" BorderBrush="#332A52">
                                                    <Image x:Name="ReelImageB" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock x:Name="ReelNameB" Text=""
                                                           HorizontalAlignment="Center" Margin="0,10,0,0"
                                                           FontSize="34" FontWeight="Black"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextBright}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- The states with no kit behind them: READY, ALL DONE. -->
                                        <TextBlock x:Name="RollHeadlineText" Text="READY?"
                                                   HorizontalAlignment="Center" Margin="0,10,0,0"
                                                   FontSize="44" FontWeight="Black"
                                                   Foreground="{StaticResource TextBright}"/>
                                        <TextBlock x:Name="RollSubText" Text="Press roll to begin"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0"
                                                   FontSize="12" Foreground="{StaticResource TextMuted}"/>

                                        <!-- How far through the reel it is, so the
                                             spin has a visible end rather than
                                             stopping whenever it feels like it. -->
                                        <ProgressBar x:Name="ReelBar" Height="5" Width="260"
                                                     Minimum="0" Maximum="1" Value="0"
                                                     Margin="0,14,0,0" BorderThickness="0"
                                                     Background="#2A2246"
                                                     Foreground="#A78BFA"
                                                     Visibility="Hidden"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button x:Name="RollButton" Content="ROLL KIT"
                                    Height="46" Margin="0,16,0,0" FontSize="15" FontWeight="Bold"
                                    Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Click="RollKit_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#7C3AED" Offset="0"/>
                                        <GradientStop Color="#4F46E5" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border x:Name="Root" CornerRadius="2"
                                                    Background="{TemplateBinding Background}"/>
                                            <Border x:Name="Sheen" CornerRadius="2"
                                                    Background="White" Opacity="0"/>
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Sheen" Property="Opacity" Value="0.10"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Sheen" Property="Opacity" Value="0.18"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <DockPanel LastChildFill="False" Margin="0,18,0,0">
                                <TextBlock Text="CHALLENGE PROGRESS" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ChallengeProgressText" DockPanel.Dock="Right"
                                           Text="0 / 0" FontSize="11" FontWeight="Bold"
                                           Foreground="#A78BFA" VerticalAlignment="Center"/>
                            </DockPanel>

                            <ProgressBar x:Name="ChallengeProgressBar" Height="6" Minimum="0" Maximum="1"
                                         Value="0" Margin="0,8,0,0"
                                         Background="#2A2246"
                                         Foreground="#A78BFA" BorderThickness="0"/>

                            <Button x:Name="ResetRunButton" Content="Start a new run"
                                    Height="34" Width="150" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Click="ResetRun_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B1630" CornerRadius="8" BorderThickness="1"
                            BorderBrush="#332A52" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="SAVED WHEELS" Foreground="#8B7FB8"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WheelHintText" DockPanel.Dock="Right"
                                           Text="" Foreground="#8B7FB8" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Keep a set of kits under a name and bring it back later. Click a wheel to load it."
                                       Foreground="#8B7FB8" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBox x:Name="WheelNameBox" Width="200" Height="32"
                                         VerticalContentAlignment="Center" Padding="10,0"
                                         KeyDown="WheelNameBox_KeyDown"/>
                                <Button x:Name="SaveWheelButton" Content="Save this wheel"
                                        Height="32" Width="140" Margin="8,0,0,0"
                                        Click="SaveWheel_Click"/>
                            </StackPanel>

                            <ItemsControl x:Name="WheelList" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#221B3A" CornerRadius="8"
                                                BorderThickness="1" BorderBrush="#332A52"
                                                Padding="2" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Tag="{Binding Name}" Click="LoadWheel_Click"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="10,6" Cursor="Hand"
                                                        ToolTip="{Binding Tip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Count}" FontSize="11"
                                                                   Margin="8,0,0,0"
                                                                   Foreground="#A78BFA"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="X" Tag="{Binding Name}"
                                                        Click="DeleteWheel_Click"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#8B7FB8"
                                                        Padding="7,0" FontSize="10" Cursor="Hand"
                                                        ToolTip="Delete this saved wheel"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="WheelEmptyText"
                                       Text="No saved wheels yet. Pick some kits, name them above and save."
                                       Foreground="#6B5FA8" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B1630" CornerRadius="8" BorderThickness="1"
                            BorderBrush="#332A52" Padding="18">
                        <StackPanel>
                            <!-- The whole row is the control, so the summary and
                                 the chevron are both part of what you click. -->
                            <Button x:Name="KitListToggle" Click="KitListToggle_Click"
                                    Background="#241C46" BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Padding="14,13" Cursor="Hand"
                                    Margin="0,0,0,2">
                                <!-- Its own template so the whole row is the
                                     target. The shared button style sizes a
                                     border to its content and centres it, which
                                     left most of this row dead to a click even
                                     though it looked like one control. A
                                     Transparent background still takes a hit;
                                     an unset one does not. -->
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <!-- Filled and outlined rather than bare. As a
                                             transparent row of muted 10px text this was
                                             indistinguishable from a heading, and people did
                                             not know the kit list was behind it. -->
                                        <Border x:Name="Row" CornerRadius="2"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="1" BorderBrush="#4A3A76">
                                            <DockPanel>
                                                <!-- The accent stripe carries most of the
                                                     "this is a control" signal, before any
                                                     text has been read. -->
                                                <Border DockPanel.Dock="Left" Width="4"
                                                        CornerRadius="2,0,0,2"
                                                        Background="#A78BFA"/>
                                                <Border Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center"/>
                                                </Border>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#332866"/>
                                                <Setter TargetName="Row" Property="BorderBrush" Value="#A78BFA"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="KitListChevron" DockPanel.Dock="Left" Text="â–¸"
                                               Foreground="#A78BFA" FontSize="16"
                                               FontWeight="Bold" Margin="0,0,11,0" VerticalAlignment="Center"/>
                                    <!-- Bright and heavy, not a muted 10px caption. This is
                                         the one thing a first-time user has to do before
                                         anything else on the page does something. -->
                                    <TextBlock Text="PICK YOUR KITS" DockPanel.Dock="Left"
                                               Foreground="{StaticResource TextBright}" FontSize="14"
                                               FontWeight="Black" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="KitCountText" DockPanel.Dock="Right" Text="0 selected"
                                               Foreground="#A78BFA" FontSize="11"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                    <!-- What is picked, readable without opening it. -->
                                    <TextBlock x:Name="KitSelectionText" Text="Nothing picked yet"
                                               Foreground="{StaticResource TextDim}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" Margin="16,0,12,0"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>

                            <StackPanel x:Name="KitListBody" Visibility="Collapsed">
                            <TextBlock Text="Tick the kits you want on the wheel. Saved as you go. The list is a starting point â€” add anything missing, remove anything retired."
                                       Style="{StaticResource CardHint}"/>

                            <!-- Search first, because with a hundred and thirteen
                                 tiles finding one is the job, and scrolling for it
                                 was the only way. -->
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="SEARCH"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="ClearKitSearchButton" DockPanel.Dock="Right"
                                        Style="{StaticResource ClearBindingButton}"
                                        Height="32" Width="32" Visibility="Collapsed"
                                        ToolTip="Clear the search and show every kit"
                                        Click="ClearKitSearch_Click"/>
                                <TextBox x:Name="KitSearchBox" Height="32"
                                         VerticalContentAlignment="Center" Padding="10,0"
                                         TextChanged="KitSearchBox_TextChanged"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <!-- MinWidth, not Width: these relabel to "Select
                                     matches" / "Clear matches" while a search is
                                     active and a fixed width would clip them. -->
                                <Button x:Name="SelectAllKitsButton" Content="Select all" Height="32"
                                        MinWidth="100" Padding="12,0" Click="SelectAllKits_Click"/>
                                <Button x:Name="ClearKitsButton" Content="Clear" Height="32" MinWidth="80"
                                        Padding="12,0" Margin="8,0,0,0" Click="ClearKits_Click"/>
                                <TextBox x:Name="KitNameBox" Width="170" Height="32" Margin="16,0,0,0"
                                         VerticalContentAlignment="Center" Padding="10,0"
                                         KeyDown="KitNameBox_KeyDown"/>
                                <Button x:Name="AddKitButton" Content="Add kit" Height="32" Width="90"
                                        Margin="8,0,0,0" Click="AddKit_Click"/>
                            </StackPanel>

                            <!-- Capped and scrollable: the roster runs to dozens
                                 of kits and would otherwise push the roll button
                                 off the page. -->
                            <ScrollViewer MaxHeight="290" Margin="0,14,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="KitList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- The whole tile is the switch. A toggle beside a
                                                 truncated name told you neither what the kit looks
                                                 like nor, half the time, what it is called. -->
                                            <Button Tag="{Binding Name}" Click="KitTile_Click"
                                                    MouseRightButtonUp="SetKitImage_Click"
                                                    Width="104" Height="126" Margin="0,0,8,8"
                                                    Padding="0" Cursor="Hand"
                                                    ToolTip="{Binding Tip}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Root" CornerRadius="2"
                                                                Background="#221B3A"
                                                                BorderThickness="1"
                                                                BorderBrush="{Binding Edge}">
                                                          <Grid>
                                                            <StackPanel Margin="0,7,0,0"
                                                                        Opacity="{Binding Dimmed}">
                                                                <Border Width="76" Height="76"
                                                                        CornerRadius="2"
                                                                        ClipToBounds="True"
                                                                        HorizontalAlignment="Center">
                                                                    <Grid>
                                                                        <TextBlock Text="+" FontSize="20"
                                                                                   Foreground="#6B5FA8"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding NoImage}"/>
                                                                        <Image Source="{Binding Image}"
                                                                               Stretch="UniformToFill"/>
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}"
                                                                           Margin="5,6,5,0"
                                                                           FontSize="11"
                                                                           TextAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{Binding Ink}"/>
                                                            </StackPanel>

                                                            <!-- Only on kits somebody added. The
                                                                 shipped roster has no delete. -->
                                                            <Button Content="X" Tag="{Binding Name}"
                                                                    Click="RemoveKit_Click"
                                                                    Visibility="{Binding Removable}"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Margin="0,2,2,0" Padding="5,1"
                                                                    FontSize="9" Cursor="Hand"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Foreground="#8B7FB8"
                                                                    ToolTip="Delete this kit from the roster"/>
                                                          </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="#2C2350"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="KitEmptyText"
                                       Text="No kits on the roster. Type one above and press Add kit."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageCrosshair" Visibility="Collapsed">

                    <UniformGrid x:Name="PageCrosshairBar" Columns="3" Margin="0,0,0,14">
                        <RadioButton Content="Crosshair" GroupName="PageCrosshairTab" Tag="PageCrosshair_chair" IsChecked="True" Style="{StaticResource SegmentButton}" Checked="PageTab_Checked"/>
                        <RadioButton Content="Gallery" GroupName="PageCrosshairTab" Tag="PageCrosshair_gallery" Style="{StaticResource SegmentButton}" Checked="PageTab_Checked"/>
                        <RadioButton Content="Create" GroupName="PageCrosshairTab" Tag="PageCrosshair_create" Margin="0" Style="{StaticResource SegmentButton}" Checked="PageTab_Checked"/>
                    </UniformGrid>

                    <StackPanel x:Name="PageCrosshair_chair">
                    <Border Style="{StaticResource ControlCard}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="176"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Style="{StaticResource CardIconChip}">
                                        <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE1D1;"/>
                                    </Border>
                                    <TextBlock Text="In-game crosshair" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Puts a crosshair in place of Roblox's mouse cursor, so it becomes the real cursor you aim with &#8212; in every installed version, and in Bloxstrap, Fishstrap and Froststrap mods if you use them. Fully reversible."
                                           Style="{StaticResource CardHint}" TextWrapping="Wrap" MaxWidth="560"/>

                                <TextBlock x:Name="CrosshairStatus" Text="Pick a crosshair below, then Apply to Roblox."
                                           Margin="0,12,0,0" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>

                                <Grid x:Name="CrosshairSizeRow" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SIZE" FontSize="10" FontWeight="Bold"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                    <Slider Grid.Column="1" x:Name="CrosshairSizeSlider" Minimum="40" Maximum="160" Value="100"
                                            IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center"
                                            ValueChanged="CrosshairSize_Changed"/>
                                    <TextBlock Grid.Column="2" x:Name="CrosshairSizeValue" Text="100%" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource Accent}"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="CrosshairApplyButton" Content="Apply to Roblox" Click="CrosshairApply_Click"
                                            Style="{StaticResource AccentButton}" Height="38" MinWidth="150" Padding="16,0"/>
                                    <Button x:Name="CrosshairRemoveButton" Content="Remove" Click="CrosshairRemove_Click"
                                            Height="38" MinWidth="96" Padding="16,0" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Pick a crosshair, then Apply to Roblox. Roblox only reads the cursor at launch, so fully close and reopen Roblox after applying."
                                           Style="{StaticResource CardHint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="1" CornerRadius="6" Margin="16,0,0,0" MinHeight="160"
                                    Background="#101018" BorderBrush="{StaticResource Outline}" BorderThickness="1">
                                <Image x:Name="CrosshairPreviewImage" Width="132" Height="132"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                            </Border>
                        </Grid>
                    </Border>

                    </StackPanel>

                    <StackPanel x:Name="PageCrosshair_gallery" Visibility="Collapsed">
                    <Border Style="{StaticResource ControlCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE1D1;"/>
                                </Border>
                                <TextBlock Text="Gallery" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Tap one to preview it, then Apply to Roblox. Keep the size small for a precise dot, or turn it up to see it easily."
                                       Style="{StaticResource CardHint}" Margin="0,4,0,0"/>
                            <WrapPanel x:Name="CrosshairGalleryPanel" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>

                    <StackPanel x:Name="PageCrosshair_create" Visibility="Collapsed">
                    <Border Style="{StaticResource ControlCard}" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Style="{StaticResource CardIconChip}">
                                        <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE713;"/>
                                    </Border>
                                    <TextBlock Text="Make your own" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Pick a shape and colours, then add it â€” or import your own crosshair image. Each one gets its own size like the rest."
                                           Style="{StaticResource CardHint}" Margin="0,4,0,0"/>

                                <TextBlock Text="SHAPE" FontSize="9" FontWeight="Bold" Margin="0,12,0,6"
                                           Foreground="{StaticResource TextMuted}"/>
                                <WrapPanel>
                                    <RadioButton x:Name="CustomShapeCross" Content="Cross" GroupName="CustomShape" Tag="Cross"
                                                 Style="{StaticResource SegmentButton}" MinWidth="64" IsChecked="True" Checked="CustomShape_Checked"/>
                                    <RadioButton x:Name="CustomShapeCrossDot" Content="Cross + Dot" GroupName="CustomShape" Tag="CrossDot"
                                                 Style="{StaticResource SegmentButton}" MinWidth="80" Checked="CustomShape_Checked"/>
                                    <RadioButton x:Name="CustomShapeX" Content="X" GroupName="CustomShape" Tag="X"
                                                 Style="{StaticResource SegmentButton}" MinWidth="48" Checked="CustomShape_Checked"/>
                                    <RadioButton x:Name="CustomShapeXDot" Content="X + Dot" GroupName="CustomShape" Tag="XDot"
                                                 Style="{StaticResource SegmentButton}" MinWidth="64" Checked="CustomShape_Checked"/>
                                    <RadioButton x:Name="CustomShapeDot" Content="Dot" GroupName="CustomShape" Tag="Dot"
                                                 Style="{StaticResource SegmentButton}" MinWidth="48" Checked="CustomShape_Checked"/>
                                    <RadioButton x:Name="CustomShapeRing" Content="Ring" GroupName="CustomShape" Tag="Circle"
                                                 Style="{StaticResource SegmentButton}" MinWidth="52" Checked="CustomShape_Checked"/>
                                    <RadioButton x:Name="CustomShapeRingDot" Content="Ring + Dot" GroupName="CustomShape" Tag="CircleDot"
                                                 Style="{StaticResource SegmentButton}" MinWidth="78" Checked="CustomShape_Checked"/>
                                    <RadioButton x:Name="CustomShapeT" Content="T" GroupName="CustomShape" Tag="TShape"
                                                 Style="{StaticResource SegmentButton}" MinWidth="44" Checked="CustomShape_Checked"/>
                                </WrapPanel>

                                <TextBlock Text="MAIN COLOUR" FontSize="9" FontWeight="Bold" Margin="0,14,0,8"
                                           Foreground="{StaticResource TextMuted}"/>
                                <WrapPanel x:Name="CustomColorPanel"/>

                                <TextBlock Text="CENTRE COLOUR" FontSize="9" FontWeight="Bold" Margin="0,10,0,8"
                                           Foreground="{StaticResource TextMuted}"/>
                                <WrapPanel x:Name="CustomDotColorPanel"/>

                                <!-- Add / import live here, above the Pro divider, so they stay
                                     available to everyone and don't read as Pro-only when the
                                     Pro panel below is collapsed for Free users. -->
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="CustomAddButton" Content="+  Add to gallery" Click="CustomAdd_Click"
                                            Style="{StaticResource AccentButton}" Height="36" MinWidth="150" Padding="16,0"/>
                                    <Button x:Name="CrosshairImportButton" Content="Import imageâ€¦" Click="CrosshairImport_Click"
                                            Height="36" MinWidth="130" Padding="16,0" Margin="10,0,0,0"
                                            ToolTip="Use your own crosshair picture as the cursor. A PNG with a transparent background works best."/>
                                </StackPanel>

                                <!-- Pro: any colour, glow, and fine-tuning -->
                                <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Margin="0,16,0,0"/>
                                <TextBlock Text="PLUS â€” ANY COLOUR, GLOW &amp; FINE-TUNE" FontSize="9" FontWeight="Bold"
                                           Margin="0,12,0,0" Foreground="{StaticResource Accent}"/>
                                <TextBlock x:Name="CrosshairProLockNote" Visibility="Collapsed"
                                           Text="Unlock any colour, a glow, and full fine-tuning on the PLUS page."
                                           Foreground="{StaticResource TextSoft}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <Button x:Name="CrosshairProGetKeyButton" Visibility="Collapsed" Content="Get a key"
                                        Style="{StaticResource AccentButton}" Padding="16,7" HorizontalAlignment="Left"
                                        Margin="0,10,0,0" Click="NavPro_Click"/>

                                <StackPanel x:Name="CrosshairProPanel" Margin="0,10,0,0">
                                    <TextBlock Text="CUSTOM COLOUR (type any hex)" FontSize="9" FontWeight="Bold" Margin="0,0,0,6"
                                               Foreground="{StaticResource TextMuted}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Main" Foreground="{StaticResource TextSoft}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="CustomHexBox" Style="{StaticResource InputField}" Width="94" MaxLength="7"
                                                 TextChanged="CustomHex_Changed" ToolTip="Any colour, e.g. #FF8800"/>
                                        <TextBlock Text="Centre" Foreground="{StaticResource TextSoft}" FontSize="11" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                        <TextBox x:Name="CustomDotHexBox" Style="{StaticResource InputField}" Width="94" MaxLength="7"
                                                 TextChanged="CustomDotHex_Changed" ToolTip="Centre colour, or blank to match the main colour"/>
                                    </StackPanel>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="THICK" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                        <Slider Grid.Column="1" x:Name="CustomThicknessSlider" Minimum="1" Maximum="12" Value="3"
                                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="CustomTune_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="CustomThicknessValue" Text="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="GAP" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                        <Slider Grid.Column="1" x:Name="CustomGapSlider" Minimum="0" Maximum="20" Value="4"
                                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="CustomTune_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="CustomGapValue" Text="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="DOT" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                        <Slider Grid.Column="1" x:Name="CustomDotSlider" Minimum="1" Maximum="12" Value="3"
                                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="CustomTune_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="CustomDotValue" Text="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="OPACITY" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                        <Slider Grid.Column="1" x:Name="CustomOpacitySlider" Minimum="20" Maximum="100" Value="100"
                                                IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" ValueChanged="CustomTune_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="CustomOpacityValue" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="GLOW" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                        <Slider Grid.Column="1" x:Name="CustomGlowSlider" Minimum="0" Maximum="100" Value="0"
                                                IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" ValueChanged="CustomTune_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="CustomGlowValue" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" CornerRadius="6" Margin="14,0,0,0" MinHeight="120"
                                    Background="#101018" BorderBrush="{StaticResource Outline}" BorderThickness="1"
                                    VerticalAlignment="Top">
                                <Image x:Name="CustomPreviewImage" Width="96" Height="96"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                            </Border>
                        </Grid>
                    </Border>

                    </StackPanel>

                </StackPanel>

                <StackPanel x:Name="PageServer" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" MaxWidth="440">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <Border Style="{StaticResource CardIconChip}">
                                            <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE774;"/>
                                        </Border>
                                        <TextBlock Text="Server region overlay" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Off unless you turn it on. When you join a game, a small banner names the region of the server you're on â€” read from Roblox's own log, not the game itself."
                                               Foreground="{StaticResource TextMuted}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <!-- Unchecked here as well as in AppSettings: the
                                     markup value is what a fresh run starts from. -->
                                <CheckBox x:Name="ServerRegionCheck" DockPanel.Dock="Right"
                                          VerticalAlignment="Center"
                                          Checked="ServerRegion_Changed"
                                          Unchecked="ServerRegion_Changed"/>
                            </DockPanel>

                            <TextBlock Text="Roblox routes every server through a relay, so this is the region the server is reached through â€” accurate to the area, not a claim about the exact building. There is no ping: a real ping to a Roblox server can't be measured from outside the game, and an invented number would be worse than none."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <DockPanel LastChildFill="False">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <Border Style="{StaticResource CardIconChip}">
                                        <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE916;"/>
                                    </Border>
                                    <TextBlock Text="How long it shows" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Keep it on the whole time, or let it pop up on joining and tuck itself away."
                                           Foreground="{StaticResource TextMuted}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,3,0,0" MaxWidth="320"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="ServerDurAlways" Content="Keep on" GroupName="ServerOverlayDuration"
                                             Style="{StaticResource SegmentButton}" Tag="0"
                                             IsChecked="True" MinWidth="70" Checked="ServerOverlayDuration_Checked"/>
                                <RadioButton x:Name="ServerDur10" Content="10s" GroupName="ServerOverlayDuration"
                                             Style="{StaticResource SegmentButton}" Tag="10"
                                             MinWidth="56" Checked="ServerOverlayDuration_Checked"/>
                                <RadioButton x:Name="ServerDur5" Content="5s" GroupName="ServerOverlayDuration"
                                             Style="{StaticResource SegmentButton}" Tag="5"
                                             MinWidth="56" Checked="ServerOverlayDuration_Checked"/>
                                <RadioButton x:Name="ServerDur3" Content="3s" GroupName="ServerOverlayDuration"
                                             Style="{StaticResource SegmentButton}" Tag="3"
                                             MinWidth="56" Margin="0" Checked="ServerOverlayDuration_Checked"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE774;"/>
                                </Border>
                                <TextBlock Text="Current server" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="ServerRegionStatusText" Text="Open a game to see your server region"
                                       FontSize="22" FontWeight="Black" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="ServerRegionDetailText" Text="" Visibility="Collapsed"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>

                            <Button x:Name="ViewGlobeButton" Content="ðŸŒ  View my server on the globe"
                                    Click="ViewServerGlobe_Click" IsEnabled="False"
                                    Padding="14,9" FontWeight="Bold" HorizontalAlignment="Left"
                                    Margin="0,14,0,0"/>
                            <TextBlock Text="Opens a live world map showing where your server is. It's a web page, so it adds nothing to the app."
                                       Foreground="{StaticResource TextMuted}" FontSize="10.5"
                                       TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="PageTweaks" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE90F;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Windows system tweaks" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="Each tweak reads your current setting before changing it, so Revert puts back exactly what you had â€” not a guessed default."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="RestartAdminButton" Content="Restart as administrator"
                                        Click="RestartAdmin_Click" Padding="12,6" Margin="0,0,10,0"/>
                                <Button Content="Revert all" Click="RevertAll_Click"
                                        Padding="12,6" Margin="0"
                                        ToolTip="Puts every applied tweak back to its recorded previous value"/>
                            </StackPanel>

                            <TextBlock x:Name="TweakStatusText" Text="" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE945;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Performance" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                            </DockPanel>

                            <ItemsControl x:Name="TweakList" Margin="0,4,0,0"
                                          ItemTemplate="{StaticResource TweakRow}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="PageOptimizations" Visibility="Collapsed">

                    <UniformGrid x:Name="OptTabBar" Columns="3" Margin="0,0,0,14">
                        <RadioButton Content="Game Mode" GroupName="OptTab" Tag="Boost" IsChecked="True" Style="{StaticResource SegmentButton}" Checked="OptTab_Checked"/>
                        <RadioButton Content="Cleaner" GroupName="OptTab" Tag="Cleaner" Style="{StaticResource SegmentButton}" Checked="OptTab_Checked"/>
                        <RadioButton Content="Input &amp; Network" GroupName="OptTab" Tag="Network" Margin="0" Style="{StaticResource SegmentButton}" Checked="OptTab_Checked"/>
                    </UniformGrid>

                    <StackPanel x:Name="OptTabBoost">

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Accent}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="GAMING MODE" Foreground="{StaticResource Accent}"
                                       FontSize="13" FontWeight="Black"/>
                            <TextBlock Text="One switch for the best safe FPS boost. It applies the high-impact performance tweaks, unlocks Roblox's FPS, raises Roblox's priority and frees RAM â€” all in one go."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Button x:Name="GamingModeButton" Content="ACTIVATE GAMING MODE"
                                    Click="GamingMode_Click" Padding="16,10" FontWeight="Bold" FontSize="14"
                                    HorizontalAlignment="Left" Margin="0,14,0,0"/>

                            <TextBlock x:Name="GamingModeStatusText"
                                       Text="Off. One switch for a real, reversible FPS boost."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>

                            <TextBlock Text="Everything it changes is reversible â€” turning it off puts it all back exactly as it was. The two deepest tweaks (keeping CPU cores awake, power throttling) need the app running as administrator; without that it applies the rest."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.85"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>

                    <StackPanel x:Name="OptTabCleaner" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE90F;"/>
                                </Border>
                                <TextBlock Text="Temp file cleaner" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Deletes files in your temp folders that nothing has touched for a day. Nothing outside those folders is looked at."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <TextBlock x:Name="ReclaimableText" Text="â€”" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" Margin="0,12,0,0"/>
                            <TextBlock x:Name="ReclaimableHint" Text="Scanningâ€¦"
                                       Foreground="{StaticResource TextMuted}" FontSize="11"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="CleanTempButton" Content="Clean temp files"
                                        Style="{StaticResource AccentButton}"
                                        Click="CleanTemp_Click" Height="36" Width="150" Margin="0,0,10,0"/>
                                <Button Content="Rescan" Click="RescanTemp_Click"
                                        Height="36" Padding="14,0" Margin="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="MEMORY" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="MemoryLine" Text="â€”" FontWeight="SemiBold" Margin="0,8,0,0"/>

                            <TextBlock Text="Free RAM trims every process working set. The available figure rises, then Windows pages it straight back in as those apps carry on. It does not raise FPS â€” unused RAM is cache Windows wants to be using."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <Button Content="Free RAM anyway" Click="FreeRam_Click"
                                    HorizontalAlignment="Left" Height="34" Padding="14,0"
                                    Margin="0,12,0,0"/>

                            <TextBlock x:Name="CleanupStatusText" Text="" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>

                    <StackPanel x:Name="OptTabNetwork" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="INPUT" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>
                            <ItemsControl x:Name="InputTweakList" Margin="0,8,0,0"
                                          ItemTemplate="{StaticResource TweakToggleRow}"/>

                            <TextBlock Text="NETWORK" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="0,18,0,0"/>
                            <ItemsControl x:Name="NetworkTweakList" Margin="0,8,0,0"
                                          ItemTemplate="{StaticResource TweakToggleRow}"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>

                </StackPanel>

                <StackPanel x:Name="PageDisplay" Visibility="Collapsed">

                    <!-- Hero: the screen at a glance, with a monitor tile, the live
                         resolution and a row of stat chips built in code. -->
                    <Border Background="{StaticResource Panel2}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="22" Margin="0,0,0,16">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="62" Height="62" CornerRadius="12"
                                    Background="{StaticResource Accent}" Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button DockPanel.Dock="Right" Click="DisplayRefresh_Click" Height="34" Padding="14,0"
                                    VerticalAlignment="Top" ToolTip="Re-read your monitor's modes">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="YOUR DISPLAY" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="DisplayCurrentText" Text="&#8212;" Foreground="{StaticResource TextBright}"
                                           FontSize="27" FontWeight="Black" Margin="0,2,0,0"/>
                                <WrapPanel x:Name="DisplayChips" Margin="0,11,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Live link to Roblox, so it's obvious the whole page drives the game. -->
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="14,12" Margin="0,0,0,16">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="DisplayRobloxDot" DockPanel.Dock="Left" Text="&#x25CF;" Foreground="{StaticResource TextMuted}"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock x:Name="DisplayRobloxStatus" Text="Checking Roblox&#8230;" Foreground="{StaticResource TextSoft}"
                                       FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="RESOLUTION FOR ROBLOX" Foreground="{StaticResource TextMuted}"
                               FontSize="10" FontWeight="Bold" Margin="2,2,0,4"/>
                    <TextBlock Text="Switch resolution and refresh rate the moment Roblox opens, and back to normal when it closes. Lower or stretched resolutions can mean bigger models and more FPS."
                               Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,12"/>

                    <!-- One-click Roblox presets, built from supported modes in code. -->
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="QUICK PRESETS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="One tap to a competitive setup, then it applies while Roblox is open. Stretched sizes fill the screen for bigger models and a wider view in BedWars."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <WrapPanel x:Name="DisplayPresets" Margin="0,12,0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- Resolution -->
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="16" Margin="0,0,0,10">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8" Background="{StaticResource Panel2}"
                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ComboBox DockPanel.Dock="Right" x:Name="DisplayResBox" Width="190" VerticalAlignment="Center"
                                      Style="{StaticResource DarkCombo}" SelectionChanged="DisplayRes_Changed"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Resolution" Foreground="{StaticResource TextBright}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="Pick a 4:3 size like 1440 Ã— 1080 for stretched. Reverts when Roblox closes."
                                           Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Refresh rate -->
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="16" Margin="0,0,0,10">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8" Background="{StaticResource Panel2}"
                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ComboBox DockPanel.Dock="Right" x:Name="DisplayRefreshBox" Width="190" VerticalAlignment="Center"
                                      Style="{StaticResource DarkCombo}" ItemStringFormat="{}{0} Hz" SelectionChanged="DisplayRate_Changed"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Refresh rate" Foreground="{StaticResource TextBright}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="Only rates your monitor reports for the chosen resolution are listed."
                                           Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Apply toggle -->
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="16" Margin="0,0,0,10">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8" Background="{StaticResource Panel2}"
                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <CheckBox DockPanel.Dock="Right" x:Name="DisplayEnableCheck" VerticalAlignment="Center"
                                      Checked="DisplayEnable_Changed" Unchecked="DisplayEnable_Changed"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Apply while Roblox is open" Foreground="{StaticResource TextBright}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="Switches to your picks when Roblox launches and reverts when it closes."
                                           Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Button x:Name="DisplayResetButton" Click="DisplayReset_Click" HorizontalAlignment="Left"
                            Height="34" Padding="14,0" Margin="0,2,0,0"
                            ToolTip="Revert now and keep your monitor's normal resolution">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Back to default resolution" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="DisplayStatus" Text="" Foreground="{StaticResource Accent}"
                               FontSize="11" FontWeight="Bold" TextWrapping="Wrap" Margin="2,10,0,0"/>

                    <!-- Roblox context: why you'd change this, and where the rest lives. -->
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="WHY CHANGE THIS FOR ROBLOX?" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Foreground="{StaticResource TextSoft}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                                           Text="&#x2022;  Lower resolutions render fewer pixels, so Roblox pushes more frames."/>
                                <TextBlock Foreground="{StaticResource TextSoft}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                                           Text="&#x2022;  Stretched 4:3 / 5:4 sizes blow players and blocks up bigger and widen your view â€” the classic BedWars edge."/>
                                <TextBlock Foreground="{StaticResource TextSoft}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                                           Text="&#x2022;  A higher refresh rate shows those extra frames, so aim feels smoother."/>
                                <TextBlock Foreground="{StaticResource TextSoft}" FontSize="11" TextWrapping="Wrap"
                                           Text="&#x2022;  It all reverts the instant Roblox closes â€” your desktop is never left stretched."/>
                            </StackPanel>
                            <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Margin="0,12,0,0"/>
                            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"
                                       Text="Want an FPS cap or the graphics renderer (D3D11 / Vulkan)? Those live on the MOD page under FPS Boost."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Only modes your monitor reports are offered, and the change is temporary â€” it reverts on Roblox close, on app exit, or if the app stops. Stretched resolutions fill the screen only if your GPU scaling is set to full-screen."
                               Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="2,12,0,0"/>

                </StackPanel>

                <StackPanel x:Name="PageMod" Visibility="Collapsed">

                    <UniformGrid x:Name="ModTabBar" Columns="4" Margin="0,0,0,14">
                        <RadioButton Content="Performance" GroupName="ModTab" Tag="Performance" IsChecked="True" Style="{StaticResource SegmentButton}" Checked="ModTab_Checked"/>
                        <RadioButton Content="Fonts" GroupName="ModTab" Tag="Fonts" Style="{StaticResource SegmentButton}" Checked="ModTab_Checked"/>
                        <RadioButton Content="Screen" GroupName="ModTab" Tag="Screen" Style="{StaticResource SegmentButton}" Checked="ModTab_Checked"/>
                        <RadioButton Content="Mouse" GroupName="ModTab" Tag="Mouse" Margin="0" Style="{StaticResource SegmentButton}" Checked="ModTab_Checked"/>
                    </UniformGrid>

                    <StackPanel x:Name="ModTabPerformance">

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource CardIconChip}">
                                        <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE7F4;"/>
                                    </Border>
                                    <TextBlock Text="Graphics quality" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                                    <Border Background="{StaticResource Accent}" CornerRadius="3" Padding="7,1"
                                            Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="QualityBadgeText" Text="Balanced" FontSize="9"
                                                   FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="QualityStateText" DockPanel.Dock="Right" Text=""
                                           FontSize="11" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock x:Name="QualitySummary" Text="" Foreground="{StaticResource TextMuted}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>

                            <!-- Looks vs FPS meters -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="LOOKS" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                                    <StackPanel x:Name="QualityLooksMeter" Orientation="Horizontal"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="FPS" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                                    <StackPanel x:Name="QualityFpsMeter" Orientation="Horizontal"/>
                                </StackPanel>
                            </Grid>

                            <!-- Slider -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MAX FPS" FontSize="9" FontWeight="Bold"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                <Slider Grid.Column="1" x:Name="QualitySlider" Minimum="1" Maximum="10" Value="10"
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        ValueChanged="QualitySlider_ValueChanged"/>
                                <TextBlock Grid.Column="2" Text="QUALITY" FontSize="9" FontWeight="Bold"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextMuted}"/>
                            </Grid>

                            <!-- Preset anchors -->
                            <UniformGrid x:Name="QualityPresetRow" Columns="4" Margin="0,14,0,0" HorizontalAlignment="Stretch">
                                <RadioButton Content="Quality" GroupName="QualPreset" Tag="10"
                                             Style="{StaticResource SegmentButton}" Checked="QualityPreset_Checked"/>
                                <RadioButton Content="Balanced" GroupName="QualPreset" Tag="6"
                                             Style="{StaticResource SegmentButton}" Checked="QualityPreset_Checked"/>
                                <RadioButton Content="Performance" GroupName="QualPreset" Tag="3"
                                             Style="{StaticResource SegmentButton}" Checked="QualityPreset_Checked"/>
                                <RadioButton Content="Max FPS" GroupName="QualPreset" Tag="1" Margin="0"
                                             Style="{StaticResource SegmentButton}" Checked="QualityPreset_Checked"/>
                            </UniformGrid>

                            <!-- Readout grid -->
                            <UniformGrid Columns="4" Margin="0,16,0,0">
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="GRAPHICS LEVEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="QualGraphicsLevel" Text="â€”" FontWeight="SemiBold" Margin="0,3,0,3"/>
                                    <Border Height="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="40"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="FPS CAP" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="QualFpsCap" Text="â€”" FontWeight="SemiBold" Margin="0,3,0,3"/>
                                    <Border Height="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="40"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="TEXTURES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="QualTextures" Text="â€”" FontWeight="SemiBold" Margin="0,3,0,3"/>
                                    <Border Height="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="40"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="ANTI-ALIASING" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="QualAA" Text="â€”" FontWeight="SemiBold" Margin="0,3,0,3"/>
                                    <Border Height="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="40"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="DETAIL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="QualDetail" Text="â€”" FontWeight="SemiBold" Margin="0,3,0,3"/>
                                    <Border Height="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="40"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="GRASS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="QualGrass" Text="â€”" FontWeight="SemiBold" Margin="0,3,0,3"/>
                                    <Border Height="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="40"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="SKY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="QualSky" Text="â€”" FontWeight="SemiBold" Margin="0,3,0,3"/>
                                    <Border Height="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="40"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,0">
                                    <TextBlock Text="OVERALL LOOK" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="QualArt" Text="â€”" FontWeight="SemiBold" Margin="0,3,0,3"/>
                                    <Border Height="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="40"/>
                                </StackPanel>
                            </UniformGrid>

                            <DockPanel LastChildFill="False" Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Write it into Roblox" FontWeight="SemiBold"/>
                                    <TextBlock Text="Applies next time Roblox starts." Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Restore default" Click="RestoreQuality_Click"
                                            Height="34" Padding="14,0" Margin="0,0,8,0"/>
                                    <Button Content="Apply" Style="{StaticResource AccentButton}"
                                            Click="ApplyQuality_Click" Height="34" Padding="22,0"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE945;"/>
                                </Border>
                                <TextBlock Text="FPS limit" Style="{StaticResource CardTitle}" DockPanel.Dock="Left" Margin="11,0,0,0"/>
                                <TextBlock x:Name="FpsCapStateText" DockPanel.Dock="Right" Text=""
                                           FontSize="11" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Roblox caps at 60 FPS out of the box. Lift the cap to match your monitor for smoother aim and movement. Applied the moment you choose &#8212; restart Roblox to see it. Pick a limit at or under your monitor's refresh rate; higher just wastes GPU."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <UniformGrid x:Name="FpsCapPanel" Columns="6" Margin="0,14,0,0"
                                         MaxWidth="560" HorizontalAlignment="Left">
                                <!-- No IsChecked here on purpose, as with the API grid:
                                     RefreshFlags ticks the one that matches the file. -->
                                <RadioButton Content="60" GroupName="FpsCap"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="FpsCap_Checked" Tag=""/>
                                <RadioButton Content="120" GroupName="FpsCap"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="FpsCap_Checked" Tag="120"/>
                                <RadioButton Content="144" GroupName="FpsCap"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="FpsCap_Checked" Tag="144"/>
                                <RadioButton Content="240" GroupName="FpsCap"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="FpsCap_Checked" Tag="240"/>
                                <RadioButton Content="360" GroupName="FpsCap"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="FpsCap_Checked" Tag="360"/>
                                <RadioButton Content="Max" GroupName="FpsCap" Margin="0"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="FpsCap_Checked" Tag="9999"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="GRAPHICS API" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GraphicsApiStateText" DockPanel.Dock="Right" Text=""
                                           FontSize="11" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Which backend the client renders with. Allowlisted, and applied the moment you choose â€” no Apply needed. Which one is fastest depends on your GPU and driver, so try them: Vulkan is a large gain on some machines and a loss on others."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <UniformGrid x:Name="GraphicsApiPanel" Columns="4" Margin="0,14,0,0"
                                         MaxWidth="440" HorizontalAlignment="Left">
                                <!-- Deliberately not IsChecked here. A default in the
                                     markup raises Checked during parsing, and the
                                     handler applies what it is given â€” which wiped
                                     the stored API preference on every launch.
                                     RefreshFlags selects the right one from the file. -->
                                <RadioButton Content="Default" GroupName="GraphicsApi"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="GraphicsApi_Checked" Tag=""/>
                                <RadioButton Content="D3D11" GroupName="GraphicsApi"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="GraphicsApi_Checked" Tag="D3D11"/>
                                <RadioButton Content="Vulkan" GroupName="GraphicsApi"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="GraphicsApi_Checked" Tag="Vulkan"/>
                                <RadioButton Content="OpenGL" GroupName="GraphicsApi" Margin="0"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="GraphicsApi_Checked" Tag="OpenGL"/>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="DetectApiButton" Content="Pick for my PC"
                                        Style="{StaticResource AccentButton}"
                                        Click="DetectApi_Click" Height="36" Padding="18,0" Margin="0"/>
                            </StackPanel>

                            <TextBlock x:Name="ApiAdviceText" Text="" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE90F;"/>
                                </Border>
                                <TextBlock Text="FPS boost FastFlags" Style="{StaticResource CardTitle}" DockPanel.Dock="Left" Margin="11,0,0,0"/>
                                <TextBlock x:Name="FlagStateText" DockPanel.Dock="Right" Text=""
                                           FontSize="11" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Every option here is one Roblox officially allows. Anything else it just ignores, so this only shows what actually works."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <TextBlock x:Name="FlagPathText" Text="" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,8,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="ApplyFlagsButton" Content="Apply"
                                        Style="{StaticResource AccentButton}"
                                        Click="ApplyFlags_Click" Height="36" Width="120" Margin="0,0,10,0"/>
                                <Button x:Name="ResetFlagsButton" Content="Reset"
                                        Click="ResetFlags_Click" Height="36" Padding="20,0" Margin="0,0,10,0"/>
                                <Button x:Name="RestoreFlagsButton" Content="Restore backup"
                                        Click="RestoreFlags_Click" IsEnabled="False"
                                        ToolTip="Puts back the client settings file as it was before this app first changed it"
                                        Height="36" Padding="16,0" Margin="0"/>
                            </StackPanel>

                            <TextBlock x:Name="FlagStatusText" Text="" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE90F;"/>
                                </Border>
                                <TextBlock Text="What this sets" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                            </StackPanel>

                            <ItemsControl x:Name="FlagList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextMuted}"
                                                               FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           Foreground="{StaticResource Accent}"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="470">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <Border Style="{StaticResource CardIconChip}">
                                        <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE7F4;"/>
                                    </Border>
                                    <TextBlock Text="Gray sky" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Replaces the sky with a flat gray â€” clearer sightlines and a little less to render. One tap, no FastFlags to edit. Takes effect next time you launch Roblox. A game that sets its own skybox overrides it."
