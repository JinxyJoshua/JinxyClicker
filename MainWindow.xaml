                                <RadioButton Content="Spring" Tag="Spring" GroupName="Season" Style="{StaticResource SegmentButton}" MinWidth="96" Margin="8,0,0,0" Checked="SeasonButton_Click"/>
                                <RadioButton Content="Summer" Tag="Summer" GroupName="Season" Style="{StaticResource SegmentButton}" MinWidth="96" Margin="8,0,0,0" Checked="SeasonButton_Click"/>
                                <RadioButton Content="Off" Tag="None" GroupName="Season" Style="{StaticResource SegmentButton}" MinWidth="72" Margin="8,0,0,0" IsChecked="True" Checked="SeasonButton_Click"/>
                            </WrapPanel>
                            <TextBlock Text="Fall brings a spooky drift of leaves and bats, winter a soft snowfall, spring blossoms, summer sparkles. Each also recolours the accent."
