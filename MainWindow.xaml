                                    <Button x:Name="EditorSetAButton" DockPanel.Dock="Left" Content="Set A" Width="62" Height="32"
                                            Margin="16,0,0,0" IsEnabled="False" Click="EditorSetA_Click"/>
                                    <Button x:Name="EditorSetBButton" DockPanel.Dock="Left" Content="Set B" Width="62" Height="32"
                                            Margin="8,0,0,0" IsEnabled="False" Click="EditorSetB_Click"/>
                                    <TextBlock x:Name="EditorTimeText" DockPanel.Dock="Right" Text="0.0 / 0.0" VerticalAlignment="Center"
