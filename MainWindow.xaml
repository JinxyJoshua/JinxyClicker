<Window x:Class="JinxyClicker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:JinxyClicker"
    Title="Jinxy AutoClicker Beta"
    Width="1120" Height="760"
    MinWidth="900" MinHeight="650"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource Bg}"
    Foreground="{DynamicResource TextBright}"
    FontFamily="Segoe UI"
    FontSize="13"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextHintingMode="Fixed"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    PreviewKeyDown="Window_PreviewKeyDown"
    PreviewMouseDown="Window_PreviewMouseDown"
    KeyDown="Window_KeyDown"
    Closing="Window_Closing"
    Visibility="Visible"
    ShowInTaskbar="True">

    <Window.Resources>
        <!-- The palette. Every colour in the window resolves to one of these
             Colors, and ApplyTheme rewrites the lot when the mode changes.

             The values here are the dark set, which is also what the designer
             surface shows. They are not the source of truth at runtime: the
             constructor applies a full palette before the window is shown, so
             whichever mode was last used wins over these. -->
        <Color x:Key="BgColor">#0F141D</Color>
        <Color x:Key="PanelColor">#1A2230</Color>
        <Color x:Key="Panel2Color">#151C27</Color>
        <Color x:Key="SidebarColor">#151B25</Color>
        <Color x:Key="SunkenColor">#101620</Color>
        <Color x:Key="ControlColor">#202A39</Color>
        <Color x:Key="ControlHoverColor">#26313F</Color>
        <Color x:Key="ControlAltColor">#1E2634</Color>
        <Color x:Key="TrackColor">#2A3445</Color>
        <Color x:Key="DividerColor">#232E3E</Color>
        <Color x:Key="OutlineColor">#3A465A</Color>
        <Color x:Key="HairlineColor">#1AFFFFFF</Color>
        <Color x:Key="TextColor">#E9EDF4</Color>
        <Color x:Key="TextBrightColor">#F5F7FA</Color>
        <Color x:Key="TextSoftColor">#AAB4C5</Color>
        <Color x:Key="TextDimColor">#C3CDDD</Color>
        <Color x:Key="TextMutedColor">#8D98AA</Color>

        <!-- Hover and press are drawn as a translucent overlay. It has to invert
             with the mode: white at 7% over a dark control lightens it, but over
             a light one it does nothing at all. -->
        <Color x:Key="SheenColor">#FFFFFF</Color>

        <SolidColorBrush x:Key="Bg" Color="{DynamicResource BgColor}"/>
        <SolidColorBrush x:Key="Panel" Color="{DynamicResource PanelColor}"/>
        <SolidColorBrush x:Key="Panel2" Color="{DynamicResource Panel2Color}"/>
        <SolidColorBrush x:Key="Sidebar" Color="{DynamicResource SidebarColor}"/>
        <SolidColorBrush x:Key="Sunken" Color="{DynamicResource SunkenColor}"/>
        <SolidColorBrush x:Key="Control" Color="{DynamicResource ControlColor}"/>
        <SolidColorBrush x:Key="ControlHover" Color="{DynamicResource ControlHoverColor}"/>
        <SolidColorBrush x:Key="ControlAlt" Color="{DynamicResource ControlAltColor}"/>
        <SolidColorBrush x:Key="Track" Color="{DynamicResource TrackColor}"/>
        <SolidColorBrush x:Key="Divider" Color="{DynamicResource DividerColor}"/>
        <SolidColorBrush x:Key="Outline" Color="{DynamicResource OutlineColor}"/>
        <SolidColorBrush x:Key="Hairline" Color="{DynamicResource HairlineColor}"/>
        <SolidColorBrush x:Key="Text" Color="{DynamicResource TextColor}"/>
        <SolidColorBrush x:Key="TextBright" Color="{DynamicResource TextBrightColor}"/>
        <SolidColorBrush x:Key="TextSoft" Color="{DynamicResource TextSoftColor}"/>
        <SolidColorBrush x:Key="TextDim" Color="{DynamicResource TextDimColor}"/>
        <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource TextMutedColor}"/>
        <SolidColorBrush x:Key="Sheen" Color="{DynamicResource SheenColor}"/>

        <!--
            Tooltips, dressed to match the rest of the window.

            Untouched, WPF gives them the system default: near-white with dark
            text and a drop shadow. Against a dark purple app that is a pale
            rectangle that appears over whatever you are pointing at, and on the
            Kit Wheel it lands beside the kit picture and reads as though the
            picture itself has a background.

            An implicit style, so every tooltip in the window is covered rather
            than the twenty that happen to be written out by hand today.
        -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="FontSize" Value="11"/>
            <!-- The default template paints its own chrome, so recolouring
                 alone leaves a pale border and the shadow behind. -->
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Outline}"
                                BorderThickness="1" CornerRadius="2"
                                Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}"/>

        <!--
            The small cross beside a hotkey, which takes the key off that one
            action and leaves every other binding alone.

            Deliberately its own control rather than a keyboard shortcut. There
            was no way at all to get back to "Not set" once an action had a key,
            and a shortcut only helps the people who find out it exists.

            Shown only when there is something to clear, so a row that already
            reads "Not set" does not offer to unset it.
        -->
        <Style x:Key="ClearBindingButton" TargetType="Button">
            <Setter Property="Content" Value="&#x2715;"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="ToolTip" Value="Unbind this key, leaving the action with no hotkey"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Background="Transparent" CornerRadius="2"
                                BorderThickness="1" BorderBrush="{StaticResource Outline}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#3A1F2E"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#7A3B52"/>
                                <Setter Property="Foreground" Value="#FF9C9C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tints of the accent, as brushes rather than the ARGB literals they
             replace: the accent is user-chosen, and a literal would keep the old
             hue after it changed. ApplyAccent sets all four together.

             Each brush takes its Color from a DynamicResource rather than a
             literal, and that indirection is load-bearing in two ways. WPF
             freezes resource Freezables whenever it can, and a frozen brush
             cannot be recoloured at all — an unresolved reference is what keeps
             these four mutable. And because the consumers hold the brush while
             only its Color moves, every one of the 200-odd StaticResource uses
             repaints without being converted to DynamicResource itself. -->
        <Color x:Key="AccentColor">#FF4B52</Color>
        <Color x:Key="AccentStrongColor">#66FF4B52</Color>
        <Color x:Key="AccentSoftColor">#33FF4B52</Color>
        <Color x:Key="AccentWashColor">#22FF4B52</Color>

        <SolidColorBrush x:Key="AccentStrong" Color="{DynamicResource AccentStrongColor}"/>
        <SolidColorBrush x:Key="AccentSoft" Color="{DynamicResource AccentSoftColor}"/>
        <SolidColorBrush x:Key="AccentWash" Color="{DynamicResource AccentWashColor}"/>

        <!-- The default Aero2 button template sets Background on its own named
             border when the mouse is over it, which beats a Style setter. Any
             dark theme therefore needs its own template, not just setters. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root" CornerRadius="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <!-- Neutral sheen so hover/press read the same on the
                                 dark fill and on the accent fill. -->
                            <Border x:Name="Sheen" CornerRadius="1" Background="{StaticResource Sheen}" Opacity="0"/>
                            <Border x:Name="FocusRing" CornerRadius="1" Opacity="0"
                                    BorderThickness="1" BorderBrush="{StaticResource Accent}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.07"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.14"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selection is driven by Tag="Selected" so the highlight only moves
             when navigation actually happens. -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <!-- Uppercase and tracked out. The label carries the weight rather
                 than a rounded pill behind it. -->
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root" CornerRadius="0"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="Sheen" CornerRadius="0" Background="{StaticResource Sheen}" Opacity="0"/>
                            <!-- Full height and square. An inset rounded bar is
                                 the soft look this is moving away from. -->
                            <Border x:Name="SelBar" Width="4" Opacity="0"
                                    HorizontalAlignment="Left" CornerRadius="0"
                                    Background="{StaticResource Accent}"/>
                            <DockPanel Margin="{TemplateBinding Padding}" LastChildFill="True">
                                <!-- Fixed width, so the labels line up whether a
                                     glyph is wide or narrow. From the icon font
                                     Windows ships — nothing to bundle. -->
                                <TextBlock DockPanel.Dock="Left" Width="20"
                                           Text="{Binding Path=(app:NavIcon.Glyph),
                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" FontWeight="Normal"
                                           VerticalAlignment="Center"
                                           TextAlignment="Left"/>
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </DockPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.05"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlAlt}"/>
                                <Setter TargetName="SelBar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Mutually exclusive segment. IsChecked carries the selection, so no
             handler has to clear the previously selected button. -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Background" Value="{StaticResource Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Root" CornerRadius="1"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="Sheen" CornerRadius="1" Background="{StaticResource Sheen}" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.07"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.14"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A colour chip. The fill is the swatch's own Background, so each one
             declares only its colour. The ring marking the chosen swatch is a
             fixed near-white rather than the accent: the accent is what is being
             chosen, so using it would leave the current selection unreadable
             against its own chip. -->
        <Style x:Key="SwatchButton" TargetType="RadioButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Ring" CornerRadius="2"
                                    BorderThickness="2" BorderBrush="Transparent"/>
                            <Border x:Name="Fill" CornerRadius="1" Margin="4"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="Sheen" CornerRadius="1" Margin="4"
                                    Background="{StaticResource Sheen}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.18"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#553A465A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Editable numeric readout. Templated for the same reason the buttons
             are: the stock TextBox recolours its own border on hover/focus. -->
        <Style x:Key="ValueBox" TargetType="TextBox">
            <!-- MinWidth rather than Width: the box measures to its text, so it
                 can never clip. MaxLength=7 is exactly the widest value either
                 slider can produce — "1000.00" for CPS, "100.00" for duty. -->
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Background" Value="{StaticResource Sunken}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MaxLength" Value="7"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" CornerRadius="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Track}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rejects anything that would not parse as a number, on typing and on
             paste alike. The commit handlers still clamp; this just stops the
             box ever showing text that cannot mean anything. -->
        <Style x:Key="NumericValueBox" TargetType="TextBox" BasedOn="{StaticResource ValueBox}">
            <EventSetter Event="PreviewTextInput" Handler="NumericBox_PreviewTextInput"/>
            <EventSetter Event="DataObject.Pasting" Handler="NumericBox_Pasting"/>
        </Style>

        <Style x:Key="PixelBox" TargetType="TextBox" BasedOn="{StaticResource NumericValueBox}">
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MaxLength" Value="3"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <!-- Preset card. The accent rail and border make the applied preset
             readable at a glance without re-reading every number. -->
        <!-- The same box holding a path instead of a number. Everything
             overridden here exists to serve a short right-aligned figure — a
             path is long, reads left to right, and should not be the loudest
             thing on its panel. The 7-character cap especially. -->
        <Style x:Key="PathBox" TargetType="TextBox" BasedOn="{StaticResource ValueBox}">
            <Setter Property="MinWidth" Value="340"/>
            <Setter Property="MaxLength" Value="260"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <!-- The readout beside a slider, typeable. Small enough to sit on the
             row without crowding the track, and capped at three characters
             because nothing it holds goes past 100. -->
        <Style x:Key="SliderValueBox" TargetType="TextBox" BasedOn="{StaticResource ValueBox}">
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="MaxLength" Value="3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PresetCard" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Control}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root" CornerRadius="2" BorderThickness="1"
                                    BorderBrush="Transparent"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="Sheen" CornerRadius="2" Background="{StaticResource Sheen}" Opacity="0"/>
                            <Border x:Name="Rail" Width="3" Margin="0,10" Opacity="0"
                                    HorizontalAlignment="Left" CornerRadius="2"
                                    Background="{StaticResource Accent}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.06"/>
                                <Setter TargetName="Rail" Property="Opacity" Value="0.55"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentStrong}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Rail" Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetDelete" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,6,6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="ToolTip" Value="Delete this preset"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Width="18" Height="18" CornerRadius="9"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource ValueBox}">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="MaxLength" Value="24"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!--
            The default for any TextBox that does not name a style.

            Three of them never did — the saved-wheel name, the kit search and
            the add-kit box — so they fell back to the stock WPF chrome: a white
            box with black text, in a window that is otherwise dark throughout.

            Implicit rather than three more Style attributes, because the next
            box added would have been white too.
        -->
        <Style TargetType="TextBox" BasedOn="{StaticResource FieldBox}"/>

        <!-- Same field, numbers only. The preset name field stays unfiltered. -->
        <Style x:Key="NumericFieldBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <EventSetter Event="PreviewTextInput" Handler="NumericBox_PreviewTextInput"/>
            <EventSetter Event="DataObject.Pasting" Handler="NumericBox_Pasting"/>
        </Style>

        <!-- Slider, rebuilt. The filled portion is the decrease repeat button,
             which already occupies exactly the region left of the thumb — that
             avoids needing a converter to size a separate fill element. -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                Background="{StaticResource Accent}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrack" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                Background="{StaticResource Track}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Halo" Width="26" Height="26" Fill="{StaticResource Accent}" Opacity="0"/>
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.25"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="26" VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource SliderFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderTrack}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card used by the reworked clicker controls. -->
        <Style x:Key="ControlCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
        </Style>

        <!-- 10px bold uppercase in a muted blue was too low-contrast to read
             cleanly; larger and lighter, with the weight carrying the emphasis. -->
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Sized against the controls beside it. At 11px the labels read as a
             caption next to a 17px button, which is what made the cards look
             lopsided rather than small. -->
        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Control}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <!-- Shared by the Tweaks and Optimizations pages. Must come after the
             Badge styles: StaticResource cannot resolve a forward reference, and
             inside a template the failure only surfaces when the page renders. -->
        <DataTemplate x:Key="TweakRow">
            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}" Padding="0,12">
                <Grid>
                    <StackPanel Margin="0,0,110,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Badge}">
                                <TextBlock Text="{Binding Impact}" Style="{StaticResource BadgeText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                   Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Content="{Binding ActionText}" IsEnabled="{Binding CanAct}"
                            Click="Tweak_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="92" Margin="0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Same data, presented as a switch. IsChecked is one-way: the click
             handler performs the change and Refresh pushes the real state back,
             so a failed apply cannot leave the switch lying. -->
        <DataTemplate x:Key="TweakToggleRow">
            <Border Padding="0,4">
                <Grid>
                    <StackPanel Margin="0,0,70,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Badge}">
                                <TextBlock Text="{Binding Impact}" Style="{StaticResource BadgeText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                   Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <CheckBox IsChecked="{Binding IsApplied, Mode=OneWay}"
                              IsEnabled="{Binding CanAct}"
                              Click="TweakToggle_Click"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Shared look for the pages that have no components yet. -->
        <Style x:Key="EmptyPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="EmptyHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="EmptyTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="EmptyHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Toggle switch. These are all on/off settings, and the stock check
             box is a light Win32 square that fights the dark theme. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26">
                            <Border x:Name="Track" CornerRadius="3"
                                    Background="{StaticResource Track}"
                                    BorderThickness="1" BorderBrush="{StaticResource Outline}"/>
                            <Border x:Name="Glow" CornerRadius="3" Background="{StaticResource Sheen}" Opacity="0"/>
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="3"
                                    Background="{StaticResource TextMuted}"
                                    HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Knob" Property="Background" Value="White"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="195"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Wallpaper, behind everything. First in the grid rather than given a
             ZIndex, so the ordering is visible where the layers are declared.
             Both layers span the columns: the picture sits behind the sidebar
             as well as the page, and the sidebar is thinned to let it through
             whenever one is set. -->
        <Image x:Name="WallpaperImage" Grid.ColumnSpan="2"
               Stretch="UniformToFill" Visibility="Collapsed"/>
        <Border x:Name="WallpaperDim" Grid.ColumnSpan="2"
                Background="#000000" Opacity="0.45" Visibility="Collapsed"/>

        <!-- Sidebar -->
        <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource Sidebar}">
            <StackPanel Margin="14">
                <!-- Wordmark sits against a solid accent block rather than
                     floating over the sidebar. The slab is the mark. -->
                <StackPanel Orientation="Horizontal" Margin="4,16,8,2">
                    <Border Background="{StaticResource Accent}" Width="5" Margin="0,2,10,2"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="JINXY" FontSize="24" FontWeight="Black"
                                   Foreground="{StaticResource TextBright}"/>
                        <TextBlock Text="ORIGINAL BUILD" FontSize="8" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}" Margin="1,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{StaticResource Divider}" Margin="4,16,8,18"/>

                <Button x:Name="NavClicker" app:NavIcon.Glyph="&#xE7C9;" Content="CLICKER" Style="{StaticResource NavButton}"
                        Tag="Selected" Click="NavClicker_Click"/>
                <Button x:Name="NavPresets" app:NavIcon.Glyph="&#xE734;" Content="PRESETS" Style="{StaticResource NavButton}"
                        Click="NavPresets_Click"/>
                <Button x:Name="NavMacros" app:NavIcon.Glyph="&#xE765;" Content="MACROS" Style="{StaticResource NavButton}"
                        Click="NavMacros_Click"/>
                <Button x:Name="NavSwitcher" app:NavIcon.Glyph="&#xE8AB;" Content="AUTO SWITCHER" Style="{StaticResource NavButton}"
                        Click="NavSwitcher_Click"/>
                <Button x:Name="NavTweaks" app:NavIcon.Glyph="&#xE90F;" Content="TWEAKS" Style="{StaticResource NavButton}"
                        Click="NavTweaks_Click"/>
                <Button x:Name="NavOptimizations" app:NavIcon.Glyph="&#xE945;" Content="OPTIMIZATIONS" Style="{StaticResource NavButton}"
                        Click="NavOptimizations_Click"/>
                <Button x:Name="NavMod" app:NavIcon.Glyph="&#xE8F1;" Content="MOD" Style="{StaticResource NavButton}"
                        Click="NavMod_Click"/>
                <Button x:Name="NavKitWheel" app:NavIcon.Glyph="&#xE72C;" Content="KIT WHEEL" Style="{StaticResource NavButton}"
                        Click="NavKitWheel_Click"/>
                <Button x:Name="NavRecorder" app:NavIcon.Glyph="&#xE714;" Content="RECORDER" Style="{StaticResource NavButton}"
                        Click="NavRecorder_Click"/>
                <Button x:Name="NavHistory" app:NavIcon.Glyph="&#xE81C;" Content="HISTORY" Style="{StaticResource NavButton}"
                        Click="NavHistory_Click"/>
                <Button x:Name="NavTheme" app:NavIcon.Glyph="&#xE790;" Content="THEME" Style="{StaticResource NavButton}"
                        Click="NavTheme_Click"/>
                <Button x:Name="NavSettings" app:NavIcon.Glyph="&#xE713;" Content="SETTINGS" Style="{StaticResource NavButton}"
                        Click="NavSettings_Click"/>

            </StackPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Two columns rather than overlapping panels in one cell, so the
                 status block can never ride over the title at narrow widths. -->
            <Grid Grid.Row="0" Margin="2,0,2,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Accent rule under the title rather than a subtitle hanging
                     softly beneath it. Squares the header off. -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitleText" Text="CLICKER" FontSize="28" FontWeight="Black"
                               Foreground="{StaticResource TextBright}"/>
                    <Border Height="3" Width="34" Background="{StaticResource Accent}"
                            HorizontalAlignment="Left" Margin="0,5,0,0"/>
                    <TextBlock x:Name="PageSubtitleText" Text="Configure your own click engine"
                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,7,0,0"/>
                </StackPanel>

                <!-- Pill and button share an explicit height so they align.
                     Only shown on the Clicker page. -->
                <StackPanel x:Name="StatusBlock" Grid.Column="1"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HideValuesButton" Content="Hide values"
                            Click="HideValues_Click" Height="40" Padding="16,0" Margin="0,0,10,0"
                            ToolTip="Masks the CPS and duty cycle so they are not readable on screen"/>
                    <Border Background="{StaticResource Panel2}" CornerRadius="1" Height="40" Padding="14,0"
                            Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                     Fill="{StaticResource TextMuted}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="IDLE" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="StartStopButton" Content="F6  START"
                            Style="{StaticResource AccentButton}"
                            Click="StartStop_Click" Width="120" Height="40"
                            Margin="0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- One page visible at a time. Every page shares the header, the
                 status pill and the start button above. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <Grid>
                <StackPanel x:Name="PageClicker">

                    <!-- What is actually leaving the app, as opposed to what the
                         sliders were set to. These are routinely not the same
                         number, and until now the difference was an 11px hint
                         under a slider showing the larger, wrong one. -->
                    <Border Background="{StaticResource Panel}" CornerRadius="2"
                            BorderThickness="1" BorderBrush="{StaticResource Outline}"
                            Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="ACTUALLY SENDING" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OutputSetText" DockPanel.Dock="Right"
                                           Text="set 10.0 /s" Foreground="{StaticResource TextMuted}"
                                           FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock x:Name="OutputRateText" Text="—"
                                           FontSize="38" FontWeight="Black"
                                           Foreground="{StaticResource TextBright}"/>
                                <TextBlock Text="clicks / sec" VerticalAlignment="Bottom"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="12" Margin="9,0,0,8"/>
                            </StackPanel>

                            <!-- Accent only when the two disagree. A verdict that
                                 is always lit stops being read. -->
                            <TextBlock x:Name="OutputVerdictText"
                                       Text="Start clicking to measure what the game actually receives."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Stats -->
                    <UniformGrid Columns="2" Margin="0,0,0,14">
                        <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="16" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="CPU" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                <!-- The two tiles measure different things: CPU is
                                     the whole machine, RAM is this process. Said
                                     out loud so they cannot be read as a pair. -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="CpuText" Text="--%" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="(All Processes)" VerticalAlignment="Bottom"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" Margin="7,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="16" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="RAM" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="RamText" Text="-- GB" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="(All Processes)" VerticalAlignment="Bottom"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" Margin="7,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Keybind / Mode on the left, the two rates on the right. -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <!-- Button choice, spanning both columns. -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ControlCard}"
                                Margin="0,0,7,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="KEYBIND" Style="{StaticResource CardLabel}"/>
                                        <TextBlock Text="Starts and stops clicking"
                                                   Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Button x:Name="ClearClickKey" Tag="Click" Style="{StaticResource ClearBindingButton}"
                                            Click="ClearBinding_Click" DockPanel.Dock="Right"/>
                                    <Button x:Name="HotkeyButton" Content="F6" Click="Hotkey_Click"
                                            DockPanel.Dock="Right" VerticalAlignment="Center"
                                            ToolTip="Click, then press a key or mouse side button. Delete unbinds it, Escape leaves it alone."
                                            FontSize="17" FontWeight="Bold"
                                            Height="42" MinWidth="96"
                                            Padding="16,0" Margin="0"/>
                                </DockPanel>

                                <Separator Opacity=".15" Margin="0,12,0,10"/>

                                <DockPanel LastChildFill="False">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="AUTOCLICKER + SHAKE" Style="{StaticResource CardLabel}"/>
                                        <TextBlock Text="Starts and stops both together"
                                                   Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Button x:Name="ClearComboKey" Tag="Combo" Style="{StaticResource ClearBindingButton}"
                                            Click="ClearBinding_Click" DockPanel.Dock="Right"/>
                                    <Button x:Name="ComboHotkeyButton" Content="Not set"
                                            Click="ComboHotkey_Click"
                                            DockPanel.Dock="Right" VerticalAlignment="Center"
                                            ToolTip="Click, then press a key or mouse side button. Delete unbinds it, Escape leaves it alone."
                                            FontSize="17" FontWeight="Bold"
                                            Height="42" MinWidth="96"
                                            Padding="16,0" Margin="0"/>
                                </DockPanel>

                                <Separator Opacity=".15" Margin="0,12,0,10"/>

                                <DockPanel LastChildFill="False">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="AUTOCLICKER + SWITCHER" Style="{StaticResource CardLabel}"/>
                                        <TextBlock Text="Starts and stops both together"
                                                   Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Button x:Name="ClearClickSwitchKey" Tag="ClickSwitch" Style="{StaticResource ClearBindingButton}"
                                            Click="ClearBinding_Click" DockPanel.Dock="Right"/>
                                    <Button x:Name="ClickSwitchHotkeyButton" Content="Not set"
                                            Click="ClickSwitchHotkey_Click"
                                            DockPanel.Dock="Right" VerticalAlignment="Center"
                                            ToolTip="Click, then press a key or mouse side button. Delete unbinds it, Escape leaves it alone."
                                            FontSize="17" FontWeight="Bold"
                                            Height="42" MinWidth="96"
                                            Padding="16,0" Margin="0"/>
                                </DockPanel>

                                <Separator Opacity=".15" Margin="0,12,0,10"/>

                                <DockPanel LastChildFill="False">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="BUILDING" Style="{StaticResource CardLabel}"/>
                                        <TextBlock Text="Fixed 35 CPS at 1% — Ignores the sliders"
                                                   Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Button x:Name="ClearBuildKey" Tag="Build" Style="{StaticResource ClearBindingButton}"
                                            Click="ClearBinding_Click" DockPanel.Dock="Right"/>
                                    <Button x:Name="BuildHotkeyButton" Content="Not set"
                                            Click="BuildHotkey_Click"
                                            DockPanel.Dock="Right" VerticalAlignment="Center"
                                            ToolTip="Click, then press a key or mouse side button. Delete unbinds it, Escape leaves it alone."
                                            FontSize="17" FontWeight="Bold"
                                            Height="42" MinWidth="96"
                                            Padding="16,0" Margin="0"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ControlCard}"
                                Margin="7,0,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="CPS" Style="{StaticResource CardLabel}"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="CpsValueBox" DockPanel.Dock="Right" Text="10.0"
                                             Style="{StaticResource NumericValueBox}"
                                             KeyDown="CpsValueBox_KeyDown"
                                             LostFocus="CpsValueBox_LostFocus"/>
                                </DockPanel>
                                <!-- 0 CPS means armed but idle; see ClickLoop. -->
                                <Slider x:Name="CpsSlider" Minimum="0" Maximum="1000" Value="10"
                                        Margin="0,10,0,0" TickFrequency="50"
                                        ValueChanged="CpsSlider_ValueChanged"/>
                                <!-- Clicks actually delivered, not clicks requested. -->
                                <TextBlock x:Name="MeasuredCpsText" Text="Measured — /s"
                                           Style="{StaticResource CardHint}" Margin="0,8,0,0"/>
                                <!-- Only shown while HitFix is overriding the sliders. -->
                                <TextBlock x:Name="HitFixClampText" Visibility="Collapsed"
                                           Foreground="{StaticResource Accent}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource ControlCard}"
                                Margin="0,14,0,0">
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="BUTTON" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="Which button gets clicked — right for blocks, wheel for scroll-bound actions"
                                               Style="{StaticResource CardHint}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <RadioButton x:Name="LeftButtonMode" Content="Left" GroupName="ClickButton"
                                                 Style="{StaticResource SegmentButton}" Tag="Left"
                                                 IsChecked="True" MinWidth="72"
                                                 Checked="ClickButton_Checked"/>
                                    <RadioButton x:Name="RightButtonMode" Content="Right" GroupName="ClickButton"
                                                 Style="{StaticResource SegmentButton}" Tag="Right"
                                                 MinWidth="72" Checked="ClickButton_Checked"/>
                                    <RadioButton x:Name="MiddleButtonMode" Content="Wheel" GroupName="ClickButton"
                                                 Style="{StaticResource SegmentButton}" Tag="Middle"
                                                 MinWidth="72" Margin="0" Checked="ClickButton_Checked"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ControlCard}"
                                Margin="0,0,7,0">
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="MODE" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="Hold the key, or press to latch"
                                               Style="{StaticResource CardHint}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <RadioButton x:Name="HoldModeButton" Content="Hold" GroupName="ClickMode"
                                                 Style="{StaticResource SegmentButton}"
                                                 Checked="HoldMode_Checked" MinWidth="76"/>
                                    <RadioButton x:Name="ToggleModeButton" Content="Toggle" GroupName="ClickMode"
                                                 IsChecked="True" Margin="0"
                                                 Style="{StaticResource SegmentButton}"
                                                 Checked="ToggleMode_Checked" MinWidth="76"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ControlCard}"
                                Margin="7,0,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="DUTY CYCLE" Style="{StaticResource CardLabel}"
                                               VerticalAlignment="Center"/>
                                    <!-- Declared before the box so it docks furthest right. -->
                                    <TextBlock Text="%" DockPanel.Dock="Right" Margin="4,0,0,0"
                                               Foreground="{StaticResource Accent}"
                                               FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBox x:Name="CdcValueBox" DockPanel.Dock="Right" Text="67.0"
                                             Style="{StaticResource NumericValueBox}"
                                             KeyDown="CdcValueBox_KeyDown"
                                             LostFocus="CdcValueBox_LostFocus"/>
                                </DockPanel>
                                <Slider x:Name="CdcSlider" Minimum="0" Maximum="100" Value="67"
                                        Margin="0,10,0,0" TickFrequency="10"
                                        ValueChanged="CdcSlider_ValueChanged"/>
                                <TextBlock Text="Share of each cycle the button stays held"
                                           Style="{StaticResource CardHint}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Precision -->
                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="PRECISION" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>

                            <Grid Margin="0,7">
                                <StackPanel>
                                    <TextBlock Text="Ultra Accuracy" FontWeight="SemiBold"/>
                                    <TextBlock Text="Spin-waits for even click spacing. Costs up to a third of a core"
                                               Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                                <CheckBox x:Name="UltraAccuracy" HorizontalAlignment="Right"
                                          Checked="EngineSetting_Changed" Unchecked="EngineSetting_Changed"/>
                            </Grid>

                            <Separator Opacity=".15"/>

                            <Grid Margin="0,7">
                                <StackPanel>
                                    <TextBlock Text="Ping Sync" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PingStatusText"
                                               Text="Holds maximum precision while latency is high"
                                               Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                                <CheckBox x:Name="PingSync" HorizontalAlignment="Right"
                                          Checked="EngineSetting_Changed" Unchecked="EngineSetting_Changed"/>
                            </Grid>

                            <Separator Opacity=".15"/>

                            <Grid Margin="0,7">
                                <StackPanel>
                                    <TextBlock Text="Shaky Tracking" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ShakeStatusText"
                                               Text="Moves the camera +/-8 px every 20-40 ms while running"
                                               Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <!-- Travel in each direction in pixels, and how often it moves.
                                         One row per value: label, slider, readout. -->
                                    <StackPanel Margin="0,10,16,2">
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="LEFT" FontSize="9" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMuted}"/>
                                            <Slider Grid.Column="1" x:Name="ShakeLeftSlider" Minimum="0" Maximum="100"
                                                    Value="8" TickFrequency="5" IsSnapToTickEnabled="False"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="ShakeSlider_ValueChanged"/>
                                            <TextBox Grid.Column="2" x:Name="ShakeLeftValue" Text="8"
                                                     Style="{StaticResource SliderValueBox}"
                                                     KeyDown="ShakeValue_KeyDown" LostFocus="ShakeValue_LostFocus"/>
                                        </Grid>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="RIGHT" FontSize="9" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMuted}"/>
                                            <Slider Grid.Column="1" x:Name="ShakeRightSlider" Minimum="0" Maximum="100"
                                                    Value="20" TickFrequency="5" IsSnapToTickEnabled="False"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="ShakeSlider_ValueChanged"/>
                                            <TextBox Grid.Column="2" x:Name="ShakeRightValue" Text="20"
                                                     Style="{StaticResource SliderValueBox}"
                                                     KeyDown="ShakeValue_KeyDown" LostFocus="ShakeValue_LostFocus"/>
                                        </Grid>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="UP" FontSize="9" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMuted}"/>
                                            <Slider Grid.Column="1" x:Name="ShakeUpSlider" Minimum="0" Maximum="100"
                                                    Value="40" TickFrequency="5" IsSnapToTickEnabled="False"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="ShakeSlider_ValueChanged"/>
                                            <TextBox Grid.Column="2" x:Name="ShakeUpValue" Text="40"
                                                     Style="{StaticResource SliderValueBox}"
                                                     KeyDown="ShakeValue_KeyDown" LostFocus="ShakeValue_LostFocus"/>
                                        </Grid>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="DOWN" FontSize="9" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMuted}"/>
                                            <Slider Grid.Column="1" x:Name="ShakeDownSlider" Minimum="0" Maximum="100"
                                                    Value="8" TickFrequency="5" IsSnapToTickEnabled="False"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="ShakeSlider_ValueChanged"/>
                                            <TextBox Grid.Column="2" x:Name="ShakeDownValue" Text="8"
                                                     Style="{StaticResource SliderValueBox}"
                                                     KeyDown="ShakeValue_KeyDown" LostFocus="ShakeValue_LostFocus"/>
                                        </Grid>

                                        <Separator Opacity=".15" Margin="0,10,0,4"/>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="SPEED" FontSize="9" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMuted}"/>
                                            <Slider Grid.Column="1" x:Name="ShakeSpeedSlider" Minimum="5" Maximum="50"
                                                    Value="33" TickFrequency="5" IsSnapToTickEnabled="False"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="ShakeSlider_ValueChanged"/>
                                            <TextBox Grid.Column="2" x:Name="ShakeSpeedValue" Text="33"
                                                     Style="{StaticResource SliderValueBox}"
                                                     ToolTip="Movements per second"
                                                     KeyDown="ShakeValue_KeyDown" LostFocus="ShakeValue_LostFocus"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="Save" Click="SaveShake_Click"
                                                    ToolTip="Remember these values"
                                                    Padding="12,5" Margin="0,0,8,0" FontSize="11"/>
                                            <Button x:Name="RestoreShakeButton" Content="Restore"
                                                    Click="RestoreShake_Click" IsEnabled="False"
                                                    Padding="12,5" Margin="0" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox x:Name="ShakyTracking" HorizontalAlignment="Right"
                                          VerticalAlignment="Top" Margin="0,1,0,0"
                                          Checked="EngineSetting_Changed" Unchecked="EngineSetting_Changed"/>
                            </Grid>

                            <Separator Opacity=".15"/>

                            <Grid Margin="0,7">
                                <StackPanel>
                                    <TextBlock Text="HitFix" FontWeight="SemiBold"/>
                                    <TextBlock Text="Holds every click long enough for the game to read it. Caps very high CPS"
                                               Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                                <CheckBox x:Name="HitFix" HorizontalAlignment="Right" IsChecked="True"
                                          Checked="EngineSetting_Changed" Unchecked="EngineSetting_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Remaining pages: same chrome, no components yet. -->
                <StackPanel x:Name="PagePresets" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="CLICK PRESETS — CPS / CDC"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PresetAppliedText" DockPanel.Dock="Right"
                                           Text="No preset applied" FontSize="11"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                                <Button DockPanel.Dock="Right" Content="Restore defaults"
                                        Click="RestoreDefaults_Click" Padding="10,5" Margin="0"
                                        FontSize="11"
                                        ToolTip="Adds back any default preset you have removed"/>
                            </DockPanel>

                            <TextBlock x:Name="PresetEmptyText" Visibility="Collapsed"
                                       Text="No presets. Add one below, or restore the defaults."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       Margin="0,14,0,0"/>

                            <ItemsControl x:Name="PresetList" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="176" Margin="0,0,10,10">
                                            <Button Click="PresetCard_Click"
                                                    Style="{StaticResource PresetCard}"
                                                    ToolTip="Apply this preset">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <TextBlock Text="{Binding CpsText}" FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource Accent}"/>
                                                        <TextBlock Text=" CPS" FontSize="11"
                                                                   Foreground="{StaticResource TextMuted}"/>
                                                        <TextBlock Text="  ·  " FontSize="11"
                                                                   Foreground="{StaticResource TextMuted}"/>
                                                        <TextBlock Text="{Binding CdcText}" FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource Accent}"/>
                                                        <TextBlock Text="% CDC" FontSize="11"
                                                                   Foreground="{StaticResource TextMuted}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ExtrasText}" FontSize="10"
                                                               Foreground="{StaticResource TextMuted}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,4,0,0"/>
                                                    <Border Height="3" Width="134" CornerRadius="2"
                                                            Background="{StaticResource Track}"
                                                            HorizontalAlignment="Left" Margin="0,9,0,0">
                                                        <Border Height="3" CornerRadius="2"
                                                                Background="{StaticResource Accent}"
                                                                Width="{Binding BarWidth}"
                                                                HorizontalAlignment="Left"/>
                                                    </Border>
                                                </StackPanel>
                                            </Button>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Button Content="&#9998;" Click="EditPreset_Click"
                                                        Style="{StaticResource PresetDelete}"
                                                        ToolTip="Load this preset for editing"
                                                        Margin="0,6,2,0"/>
                                                <Button Content="&#215;" Click="DeletePreset_Click"
                                                        Style="{StaticResource PresetDelete}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="CUSTOM PRESET" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="CustomPresetHint"
                                       Text="Name it, set CPS and CDC, and it is saved between sessions"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="NewPresetName" Grid.Column="0"
                                         Style="{StaticResource FieldBox}" Margin="0,0,10,0"
                                         KeyDown="NewPreset_KeyDown"/>
                                <TextBox x:Name="NewPresetCps" Grid.Column="1"
                                         Style="{StaticResource NumericFieldBox}" Margin="0,0,10,0"
                                         MaxLength="6" KeyDown="NewPreset_KeyDown"/>
                                <TextBox x:Name="NewPresetCdc" Grid.Column="2"
                                         Style="{StaticResource NumericFieldBox}" Margin="0,0,10,0"
                                         MaxLength="6" KeyDown="NewPreset_KeyDown"/>
                                <Button Grid.Column="3" Content="+  Save" Click="SavePreset_Click"
                                        Style="{StaticResource AccentButton}"
                                        Height="34" Width="96" Margin="0"/>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="106"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="NAME" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="1" Text="CPS" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="2" Text="CDC %" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Macros: any key, any rate, as many as you like. -->
                <StackPanel x:Name="PageMacros" Visibility="Collapsed">
                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1"
                            BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <DockPanel LastChildFill="False">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="HOTKEYS" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="MacrosHotkeyKillNote"
                                           Text="Every bound key is live. Turn them off while you edit."
                                           Style="{StaticResource CardHint}"/>
                            </StackPanel>
                            <Button x:Name="MacrosHotkeyKill" DockPanel.Dock="Right" Content="DISABLE HOTKEYS"
                                    Click="HotkeyKill_Click" Height="40" MinWidth="170"
                                    Padding="16,0" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="RUNNING" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button x:Name="StopAllMacrosButton" DockPanel.Dock="Right"
                                        Content="Stop all" Click="StopAllMacros_Click"
                                        Padding="14,6" FontSize="11"/>
                            </DockPanel>
                            <TextBlock x:Name="MacroRunningText" Text="Nothing running."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="A macro types a key over and over while it is on. It goes to whatever window is in front, so switch to the game before starting one."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="MacroList" Margin="0,0,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="NEW MACRO" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="One letter or digit per box. Fill the second and the macro alternates between the two; leave it empty and it just spams the first."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBox x:Name="MacroNameBox" Style="{StaticResource FieldBox}"/>
                                    <TextBlock Text="NAME" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBox x:Name="MacroKey1Box" Style="{StaticResource FieldBox}"
                                             MaxLength="1"/>
                                    <TextBlock Text="KEY" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBox x:Name="MacroKey2Box" Style="{StaticResource FieldBox}"
                                             MaxLength="1"/>
                                    <TextBlock Text="2ND KEY (OPTIONAL)" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <DockPanel>
                                        <Button x:Name="ClearNewMacroKey" DockPanel.Dock="Right"
                                                Style="{StaticResource ClearBindingButton}"
                                                Height="34" Width="34"
                                                Visibility="Collapsed"
                                                Click="ClearNewMacroHotkey_Click"/>
                                        <Button x:Name="NewMacroHotkeyButton" Content="Not set"
                                                Click="NewMacroHotkey_Click"
                                                ToolTip="Click, then press a key or mouse side button. Delete unbinds it, Escape leaves it alone."
                                                Height="34" Padding="12,0"/>
                                    </DockPanel>
                                    <TextBlock Text="TOGGLE HOTKEY (OPTIONAL)" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="8">
                                    <TextBox x:Name="MacroIntervalBox" Style="{StaticResource NumericFieldBox}"/>
                                    <TextBlock Text="EVERY (MS)" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="10" x:Name="SaveMacroButton" Content="+  Save"
                                        Style="{StaticResource AccentButton}" Click="SaveMacro_Click"
                                        Height="34" Padding="20,0" VerticalAlignment="Top"/>
                            </Grid>

                            <TextBlock x:Name="MacroErrorText" Visibility="Collapsed"
                                       Foreground="{StaticResource Accent}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Auto Switcher: the same engine, two keys, one purpose. -->
                <StackPanel x:Name="PageSwitcher" Visibility="Collapsed">
                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1"
                            BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <DockPanel LastChildFill="False">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="HOTKEYS" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="SwitcherHotkeyKillNote"
                                           Text="Every bound key is live. Turn them off while you edit."
                                           Style="{StaticResource CardHint}"/>
                            </StackPanel>
                            <Button x:Name="SwitcherHotkeyKill" DockPanel.Dock="Right" Content="DISABLE HOTKEYS"
                                    Click="HotkeyKill_Click" Height="40" MinWidth="170"
                                    Padding="16,0" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                      <Grid>
                        <!-- Stamped across when hotkeys are off, the same as a
                             macro card. The switcher has one card rather than
                             many, so the stamp goes over the card itself. -->
                        <StackPanel x:Name="SwitcherCardBody">
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="AUTO SWITCHER" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="Swaps between two hotbar slots on a timer — sword and crossbow, or pickaxe and gumdrop."
                                               Style="{StaticResource CardHint}"/>
                                </StackPanel>
                                <CheckBox x:Name="SwitcherEnabled" DockPanel.Dock="Right" Margin="0"
                                          VerticalAlignment="Center"
                                          Checked="Switcher_Changed" Unchecked="Switcher_Changed"/>
                                <Button x:Name="SwitcherDisableButton" DockPanel.Dock="Right"
                                        Content="Disable" Click="SwitcherDisable_Click"
                                        Height="30" MinWidth="86" Padding="12,0"
                                        Margin="0,0,12,0" FontSize="11"
                                        VerticalAlignment="Center"/>
                            </DockPanel>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBox x:Name="SlotABox" Style="{StaticResource FieldBox}" MaxLength="1"
                                             TextChanged="SwitcherField_Changed"/>
                                    <TextBlock Text="FIRST SLOT" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBox x:Name="SlotBBox" Style="{StaticResource FieldBox}" MaxLength="1"
                                             TextChanged="SwitcherField_Changed"/>
                                    <TextBlock Text="SECOND SLOT" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBox x:Name="SwitcherIntervalBox" Style="{StaticResource NumericFieldBox}"
                                             TextChanged="SwitcherField_Changed"/>
                                    <TextBlock Text="HOLD FIRST (MS)" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBox x:Name="SwitcherEquipBox" Style="{StaticResource NumericFieldBox}"
                                             TextChanged="SwitcherField_Changed"/>
                                    <TextBlock Text="EQUIP DELAY (MS)" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="8">
                                    <TextBox x:Name="SwitcherIntervalBBox" Style="{StaticResource NumericFieldBox}"
                                             TextChanged="SwitcherField_Changed"/>
                                    <TextBlock Text="HOLD SECOND (MS)" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="SwitcherStatusText" Text=""
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,14,0,0"/>
                            <TextBlock x:Name="SwitcherCountText" Text=""
                                       Foreground="{StaticResource Accent}" FontSize="11"
                                       FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Never takes a click: the fields stay editable with
                             hotkeys off, which is when people edit them. -->
                        <Border x:Name="SwitcherDisabledStamp" Visibility="Collapsed"
                                Background="#30E02B2B" BorderBrush="#E02B2B"
                                BorderThickness="2" CornerRadius="6"
                                VerticalAlignment="Center" Padding="0,10,0,10"
                                IsHitTestVisible="False">
                            <TextBlock x:Name="SwitcherStampText" Text="DISABLED"
                                       FontSize="26" FontWeight="Black"
                                       Foreground="#FF6B6B" TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>
                      </Grid>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="KEYBIND" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="Turns the switcher on and off from inside the game"
                                               Style="{StaticResource CardHint}"/>
                                </StackPanel>
                                <Button x:Name="ClearSwitcherKey" Tag="Switcher" Style="{StaticResource ClearBindingButton}"
                                        Click="ClearBinding_Click" DockPanel.Dock="Right"/>
                                <Button x:Name="SwitcherHotkeyButton" Content="Not set"
                                        Click="SwitcherHotkey_Click"
                                        DockPanel.Dock="Right" VerticalAlignment="Center"
                                        ToolTip="Click, then press a key or mouse side button. Delete unbinds it, Escape leaves it alone."
                                        FontSize="17" FontWeight="Bold"
                                        Height="42" MinWidth="96" Padding="16,0" Margin="0"/>
                            </DockPanel>

                            <TextBlock Text="Slot keys are just the number keys Roblox already uses — the switcher presses 1 and 2 exactly as you would. It does not read the screen or the game."
                                       Style="{StaticResource CardHint}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="PageKitWheel" Visibility="Collapsed">
                    <Border Background="#1B1630" CornerRadius="2" BorderThickness="1"
                            BorderBrush="#332A52" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="KIT RANDOMIZER" Style="{StaticResource CardLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="KitsRemainingText" DockPanel.Dock="Right"
                                           Text="0 KITS REMAINING" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- The reveal. One panel that swaps between asking and
                                 answering, so the result lands where the eye already is. -->
                            <Border Background="#171129" CornerRadius="2"
                                    BorderThickness="1" BorderBrush="#332A52"
                                    Height="250" Margin="0,14,0,0">
                                <Grid x:Name="RevealPanel" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="RevealScale" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="RollBadgeText" Text="KIT ROLL"
                                                   HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"
                                                   Foreground="#A78BFA"/>
                                        <!-- Two identical layers, one fading out as the other fades
                                             in. Fading a single layer down and back up is a
                                             pulse with a gap in the middle; a kit dissolving
                                             into the next one is what reads as smooth. -->
                                        <Grid x:Name="ReelStack" Height="164" Margin="0,10,0,0"
                                              Visibility="Collapsed">
                                            <StackPanel x:Name="ReelLayerA">
                                                <Border Width="104" Height="104" CornerRadius="2"
                                                        ClipToBounds="True" HorizontalAlignment="Center"
                                                        BorderThickness="1" BorderBrush="#332A52">
                                                    <Image x:Name="ReelImageA" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock x:Name="ReelNameA" Text=""
                                                           HorizontalAlignment="Center" Margin="0,10,0,0"
                                                           FontSize="34" FontWeight="Black"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextBright}"/>
                                            </StackPanel>

                                            <StackPanel x:Name="ReelLayerB" Opacity="0">
                                                <Border Width="104" Height="104" CornerRadius="2"
                                                        ClipToBounds="True" HorizontalAlignment="Center"
                                                        BorderThickness="1" BorderBrush="#332A52">
                                                    <Image x:Name="ReelImageB" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock x:Name="ReelNameB" Text=""
                                                           HorizontalAlignment="Center" Margin="0,10,0,0"
                                                           FontSize="34" FontWeight="Black"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextBright}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- The states with no kit behind them: READY, ALL DONE. -->
                                        <TextBlock x:Name="RollHeadlineText" Text="READY?"
                                                   HorizontalAlignment="Center" Margin="0,10,0,0"
                                                   FontSize="44" FontWeight="Black"
                                                   Foreground="{StaticResource TextBright}"/>
                                        <TextBlock x:Name="RollSubText" Text="Press roll to begin"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0"
                                                   FontSize="12" Foreground="{StaticResource TextMuted}"/>

                                        <!-- How far through the reel it is, so the
                                             spin has a visible end rather than
                                             stopping whenever it feels like it. -->
                                        <ProgressBar x:Name="ReelBar" Height="5" Width="260"
                                                     Minimum="0" Maximum="1" Value="0"
                                                     Margin="0,14,0,0" BorderThickness="0"
                                                     Background="#2A2246"
                                                     Foreground="#A78BFA"
                                                     Visibility="Hidden"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button x:Name="RollButton" Content="ROLL KIT"
                                    Height="46" Margin="0,16,0,0" FontSize="15" FontWeight="Bold"
                                    Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Click="RollKit_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#7C3AED" Offset="0"/>
                                        <GradientStop Color="#4F46E5" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border x:Name="Root" CornerRadius="2"
                                                    Background="{TemplateBinding Background}"/>
                                            <Border x:Name="Sheen" CornerRadius="2"
                                                    Background="White" Opacity="0"/>
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Sheen" Property="Opacity" Value="0.10"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Sheen" Property="Opacity" Value="0.18"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <DockPanel LastChildFill="False" Margin="0,18,0,0">
                                <TextBlock Text="CHALLENGE PROGRESS" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ChallengeProgressText" DockPanel.Dock="Right"
                                           Text="0 / 0" FontSize="11" FontWeight="Bold"
                                           Foreground="#A78BFA" VerticalAlignment="Center"/>
                            </DockPanel>

                            <ProgressBar x:Name="ChallengeProgressBar" Height="6" Minimum="0" Maximum="1"
                                         Value="0" Margin="0,8,0,0"
                                         Background="#2A2246"
                                         Foreground="#A78BFA" BorderThickness="0"/>

                            <Button x:Name="ResetRunButton" Content="Start a new run"
                                    Height="34" Width="150" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Click="ResetRun_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B1630" CornerRadius="2" BorderThickness="1"
                            BorderBrush="#332A52" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="SAVED WHEELS" Foreground="#8B7FB8"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WheelHintText" DockPanel.Dock="Right"
                                           Text="" Foreground="#8B7FB8" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Keep a set of kits under a name and bring it back later. Click a wheel to load it."
                                       Foreground="#8B7FB8" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBox x:Name="WheelNameBox" Width="200" Height="32"
                                         VerticalContentAlignment="Center" Padding="10,0"
                                         KeyDown="WheelNameBox_KeyDown"/>
                                <Button x:Name="SaveWheelButton" Content="Save this wheel"
                                        Height="32" Width="140" Margin="8,0,0,0"
                                        Click="SaveWheel_Click"/>
                            </StackPanel>

                            <ItemsControl x:Name="WheelList" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#221B3A" CornerRadius="2"
                                                BorderThickness="1" BorderBrush="#332A52"
                                                Padding="2" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Tag="{Binding Name}" Click="LoadWheel_Click"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="10,6" Cursor="Hand"
                                                        ToolTip="{Binding Tip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Count}" FontSize="11"
                                                                   Margin="8,0,0,0"
                                                                   Foreground="#A78BFA"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="X" Tag="{Binding Name}"
                                                        Click="DeleteWheel_Click"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#8B7FB8"
                                                        Padding="7,0" FontSize="10" Cursor="Hand"
                                                        ToolTip="Delete this saved wheel"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="WheelEmptyText"
                                       Text="No saved wheels yet. Pick some kits, name them above and save."
                                       Foreground="#6B5FA8" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B1630" CornerRadius="2" BorderThickness="1"
                            BorderBrush="#332A52" Padding="18">
                        <StackPanel>
                            <!-- The whole row is the control, so the summary and
                                 the chevron are both part of what you click. -->
                            <Button x:Name="KitListToggle" Click="KitListToggle_Click"
                                    Background="#241C46" BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Padding="14,13" Cursor="Hand"
                                    Margin="0,0,0,2">
                                <!-- Its own template so the whole row is the
                                     target. The shared button style sizes a
                                     border to its content and centres it, which
                                     left most of this row dead to a click even
                                     though it looked like one control. A
                                     Transparent background still takes a hit;
                                     an unset one does not. -->
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <!-- Filled and outlined rather than bare. As a
                                             transparent row of muted 10px text this was
                                             indistinguishable from a heading, and people did
                                             not know the kit list was behind it. -->
                                        <Border x:Name="Row" CornerRadius="2"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="1" BorderBrush="#4A3A76">
                                            <DockPanel>
                                                <!-- The accent stripe carries most of the
                                                     "this is a control" signal, before any
                                                     text has been read. -->
                                                <Border DockPanel.Dock="Left" Width="4"
                                                        CornerRadius="2,0,0,2"
                                                        Background="#A78BFA"/>
                                                <Border Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center"/>
                                                </Border>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#332866"/>
                                                <Setter TargetName="Row" Property="BorderBrush" Value="#A78BFA"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="KitListChevron" DockPanel.Dock="Left" Text="▸"
                                               Foreground="#A78BFA" FontSize="16"
                                               FontWeight="Bold" Margin="0,0,11,0" VerticalAlignment="Center"/>
                                    <!-- Bright and heavy, not a muted 10px caption. This is
                                         the one thing a first-time user has to do before
                                         anything else on the page does something. -->
                                    <TextBlock Text="PICK YOUR KITS" DockPanel.Dock="Left"
                                               Foreground="{StaticResource TextBright}" FontSize="14"
                                               FontWeight="Black" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="KitCountText" DockPanel.Dock="Right" Text="0 selected"
                                               Foreground="#A78BFA" FontSize="11"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                    <!-- What is picked, readable without opening it. -->
                                    <TextBlock x:Name="KitSelectionText" Text="Nothing picked yet"
                                               Foreground="{StaticResource TextDim}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" Margin="16,0,12,0"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>

                            <StackPanel x:Name="KitListBody" Visibility="Collapsed">
                            <TextBlock Text="Tick the kits you want on the wheel. Saved as you go. The list is a starting point — add anything missing, remove anything retired."
                                       Style="{StaticResource CardHint}"/>

                            <!-- Search first, because with a hundred and thirteen
                                 tiles finding one is the job, and scrolling for it
                                 was the only way. -->
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="SEARCH"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="ClearKitSearchButton" DockPanel.Dock="Right"
                                        Style="{StaticResource ClearBindingButton}"
                                        Height="32" Width="32" Visibility="Collapsed"
                                        ToolTip="Clear the search and show every kit"
                                        Click="ClearKitSearch_Click"/>
                                <TextBox x:Name="KitSearchBox" Height="32"
                                         VerticalContentAlignment="Center" Padding="10,0"
                                         TextChanged="KitSearchBox_TextChanged"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <!-- MinWidth, not Width: these relabel to "Select
                                     matches" / "Clear matches" while a search is
                                     active and a fixed width would clip them. -->
                                <Button x:Name="SelectAllKitsButton" Content="Select all" Height="32"
                                        MinWidth="100" Padding="12,0" Click="SelectAllKits_Click"/>
                                <Button x:Name="ClearKitsButton" Content="Clear" Height="32" MinWidth="80"
                                        Padding="12,0" Margin="8,0,0,0" Click="ClearKits_Click"/>
                                <TextBox x:Name="KitNameBox" Width="170" Height="32" Margin="16,0,0,0"
                                         VerticalContentAlignment="Center" Padding="10,0"
                                         KeyDown="KitNameBox_KeyDown"/>
                                <Button x:Name="AddKitButton" Content="Add kit" Height="32" Width="90"
                                        Margin="8,0,0,0" Click="AddKit_Click"/>
                            </StackPanel>

                            <!-- Capped and scrollable: the roster runs to dozens
                                 of kits and would otherwise push the roll button
                                 off the page. -->
                            <ScrollViewer MaxHeight="290" Margin="0,14,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="KitList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- The whole tile is the switch. A toggle beside a
                                                 truncated name told you neither what the kit looks
                                                 like nor, half the time, what it is called. -->
                                            <Button Tag="{Binding Name}" Click="KitTile_Click"
                                                    MouseRightButtonUp="SetKitImage_Click"
                                                    Width="104" Height="126" Margin="0,0,8,8"
                                                    Padding="0" Cursor="Hand"
                                                    ToolTip="{Binding Tip}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Root" CornerRadius="2"
                                                                Background="#221B3A"
                                                                BorderThickness="1"
                                                                BorderBrush="{Binding Edge}">
                                                          <Grid>
                                                            <StackPanel Margin="0,7,0,0"
                                                                        Opacity="{Binding Dimmed}">
                                                                <Border Width="76" Height="76"
                                                                        CornerRadius="2"
                                                                        ClipToBounds="True"
                                                                        HorizontalAlignment="Center">
                                                                    <Grid>
                                                                        <TextBlock Text="+" FontSize="20"
                                                                                   Foreground="#6B5FA8"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding NoImage}"/>
                                                                        <Image Source="{Binding Image}"
                                                                               Stretch="UniformToFill"/>
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}"
                                                                           Margin="5,6,5,0"
                                                                           FontSize="11"
                                                                           TextAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{Binding Ink}"/>
                                                            </StackPanel>

                                                            <!-- Only on kits somebody added. The
                                                                 shipped roster has no delete. -->
                                                            <Button Content="X" Tag="{Binding Name}"
                                                                    Click="RemoveKit_Click"
                                                                    Visibility="{Binding Removable}"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Margin="0,2,2,0" Padding="5,1"
                                                                    FontSize="9" Cursor="Hand"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Foreground="#8B7FB8"
                                                                    ToolTip="Delete this kit from the roster"/>
                                                          </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="#2C2350"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="KitEmptyText"
                                       Text="No kits on the roster. Type one above and press Add kit."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageTweaks" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="WINDOWS SYSTEM TWEAKS" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Each tweak reads your current setting before changing it, so Revert puts back exactly what you had — not a guessed default."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="RestartAdminButton" Content="Restart as administrator"
                                        Click="RestartAdmin_Click" Padding="12,6" Margin="0,0,10,0"/>
                                <Button Content="Revert all" Click="RevertAll_Click"
                                        Padding="12,6" Margin="0"
                                        ToolTip="Puts every applied tweak back to its recorded previous value"/>
                            </StackPanel>

                            <TextBlock x:Name="TweakStatusText" Text="" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="PERFORMANCE" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>

                            <ItemsControl x:Name="TweakList" Margin="0,4,0,0"
                                          ItemTemplate="{StaticResource TweakRow}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="PageOptimizations" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="TEMP FILE CLEANER" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Deletes files in your temp folders that nothing has touched for a day. Nothing outside those folders is looked at."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <TextBlock x:Name="ReclaimableText" Text="—" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" Margin="0,12,0,0"/>
                            <TextBlock x:Name="ReclaimableHint" Text="Scanning…"
                                       Foreground="{StaticResource TextMuted}" FontSize="11"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="CleanTempButton" Content="Clean temp files"
                                        Style="{StaticResource AccentButton}"
                                        Click="CleanTemp_Click" Height="36" Width="150" Margin="0,0,10,0"/>
                                <Button Content="Rescan" Click="RescanTemp_Click"
                                        Height="36" Padding="14,0" Margin="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="INPUT" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>
                            <ItemsControl x:Name="InputTweakList" Margin="0,8,0,0"
                                          ItemTemplate="{StaticResource TweakToggleRow}"/>

                            <TextBlock Text="NETWORK" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="0,18,0,0"/>
                            <ItemsControl x:Name="NetworkTweakList" Margin="0,8,0,0"
                                          ItemTemplate="{StaticResource TweakToggleRow}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="MEMORY" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="MemoryLine" Text="—" FontWeight="SemiBold" Margin="0,8,0,0"/>

                            <TextBlock Text="Free RAM trims every process working set. The available figure rises, then Windows pages it straight back in as those apps carry on. It does not raise FPS — unused RAM is cache Windows wants to be using."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <Button Content="Free RAM anyway" Click="FreeRam_Click"
                                    HorizontalAlignment="Left" Height="34" Padding="14,0"
                                    Margin="0,12,0,0"/>

                            <TextBlock x:Name="CleanupStatusText" Text="" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="PageMod" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="FPS BOOST FASTFLAGS" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FlagStateText" DockPanel.Dock="Right" Text=""
                                           FontSize="11" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Every flag below is on Roblox's published allowlist. Anything not on that list is ignored by the client, so this only offers what is actually permitted and actually works."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <TextBlock x:Name="FlagPathText" Text="" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,8,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="ApplyFlagsButton" Content="Apply"
                                        Style="{StaticResource AccentButton}"
                                        Click="ApplyFlags_Click" Height="36" Width="120" Margin="0,0,10,0"/>
                                <Button x:Name="ResetFlagsButton" Content="Reset"
                                        Click="ResetFlags_Click" Height="36" Padding="20,0" Margin="0,0,10,0"/>
                                <Button x:Name="RestoreFlagsButton" Content="Restore backup"
                                        Click="RestoreFlags_Click" IsEnabled="False"
                                        ToolTip="Puts back the client settings file as it was before this app first changed it"
                                        Height="36" Padding="16,0" Margin="0"/>
                            </StackPanel>

                            <TextBlock x:Name="FlagStatusText" Text="" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="GRAPHICS API" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GraphicsApiStateText" DockPanel.Dock="Right" Text=""
                                           FontSize="11" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Which backend the client renders with. Allowlisted, and applied the moment you choose — no Apply needed. Which one is fastest depends on your GPU and driver, so try them: Vulkan is a large gain on some machines and a loss on others."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <UniformGrid x:Name="GraphicsApiPanel" Columns="4" Margin="0,14,0,0"
                                         MaxWidth="440" HorizontalAlignment="Left">
                                <!-- Deliberately not IsChecked here. A default in the
                                     markup raises Checked during parsing, and the
                                     handler applies what it is given — which wiped
                                     the stored API preference on every launch.
                                     RefreshFlags selects the right one from the file. -->
                                <RadioButton Content="Default" GroupName="GraphicsApi"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="GraphicsApi_Checked" Tag=""/>
                                <RadioButton Content="D3D11" GroupName="GraphicsApi"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="GraphicsApi_Checked" Tag="D3D11"/>
                                <RadioButton Content="Vulkan" GroupName="GraphicsApi"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="GraphicsApi_Checked" Tag="Vulkan"/>
                                <RadioButton Content="OpenGL" GroupName="GraphicsApi" Margin="0"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="GraphicsApi_Checked" Tag="OpenGL"/>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="DetectApiButton" Content="Pick for my PC"
                                        Style="{StaticResource AccentButton}"
                                        Click="DetectApi_Click" Height="36" Padding="18,0" Margin="0"/>
                            </StackPanel>

                            <TextBlock x:Name="ApiAdviceText" Text="" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="ROBLOX PRIORITY" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <CheckBox x:Name="RobloxPriority" DockPanel.Dock="Right" Margin="0"
                                          VerticalAlignment="Center"
                                          Checked="RobloxPriority_Changed" Unchecked="RobloxPriority_Changed"/>
                            </DockPanel>

                            <TextBlock Text="Raises the Roblox process above normal priority so Windows schedules it ahead of background work. Not a flag and nothing is injected — the same setting Task Manager offers. Reapplied every second, so it survives Roblox restarting."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <TextBlock Text="Worth having while clicking: the click engine runs above normal priority itself, and with Ultra Accuracy it spin-waits, so it competes with the game for a core."
                                       Foreground="{StaticResource TextDim}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <TextBlock x:Name="RobloxPriorityStateText" Text="" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="WHAT THIS SETS" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>

                            <ItemsControl x:Name="FlagList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextMuted}"
                                                               FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           Foreground="{StaticResource Accent}"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="PageHistory" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ALL TIME" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="HistoryTotalText" Text="0s" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" Margin="0,6,0,0"/>
                            <TextBlock Text="Counted only while clicks are actually being sent — not while the app is merely open, and not while hold mode is armed with the key up."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>

                            <UniformGrid Columns="4" Margin="0,18,0,0">
                                <StackPanel Margin="0,0,7,0">
                                    <TextBlock Text="TOTAL CLICKS" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="HistoryClicksText" Text="0" FontSize="18"
                                               FontWeight="Bold" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="7,0">
                                    <TextBlock Text="AVERAGE RATE" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="HistoryAverageText" Text="—" FontSize="18"
                                               FontWeight="Bold" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="7,0">
                                    <TextBlock Text="BUSIEST DAY" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="HistoryBusiestText" Text="—" FontSize="18"
                                               FontWeight="Bold" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="HistoryBusiestDateText" Text="" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="7,0,0,0">
                                    <TextBlock Text="DAYS RECORDED" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="HistoryDaysText" Text="0" FontSize="18"
                                               FontWeight="Bold" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="HistorySinceText" Text="" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="THIS SESSION" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>
                            <UniformGrid Columns="3" Margin="0,10,0,0">
                                <StackPanel Margin="0,0,7,0">
                                    <TextBlock Text="TIME" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="HistorySessionTimeText" Text="0s" FontSize="18"
                                               FontWeight="Bold" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="7,0">
                                    <TextBlock Text="CLICKS" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="HistorySessionClicksText" Text="0" FontSize="18"
                                               FontWeight="Bold" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="7,0,0,0">
                                    <TextBlock Text="RATE" Foreground="{StaticResource TextMuted}"
                                               FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="HistorySessionRateText" Text="—" FontSize="18"
                                               FontWeight="Bold" Margin="0,3,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="BY DAY" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="Reset history"
                                        Click="ResetHistory_Click" Padding="10,5" Margin="0" FontSize="11"/>
                            </DockPanel>

                            <TextBlock x:Name="HistoryEmptyText" Visibility="Collapsed"
                                       Text="No clicking recorded yet."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       Margin="0,14,0,0"/>

                            <ItemsControl x:Name="HistoryDayList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DateText}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DurationText}"
                                                           Foreground="{StaticResource Accent}"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ClicksText}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding RateText}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="PageRecorder" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="RECORD" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="RecorderEngineText" Text=""
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <TextBlock x:Name="RecordElapsedText" Text="00:00" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" Margin="0,10,0,0"/>

                            <TextBlock Text="CAPTURE" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="0,18,0,0"/>

                            <TextBlock Text="Which screen goes into the clip. Instant replay follows the same choice."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <!-- Filled at runtime: how many monitors exist is not
                                 knowable until the app is running. -->
                            <WrapPanel x:Name="DisplayPanel" Margin="0,10,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="RecordButton" Content="Start recording"
                                        Style="{StaticResource AccentButton}"
                                        Click="Record_Click" Height="36" Width="164" Margin="0,0,10,0"/>
                                <Button x:Name="RecordHotkeyButton" Content="Not set"
                                        Click="RecordHotkey_Click"
                                        ToolTip="Click, then press a key or mouse side button. Delete unbinds it, Escape leaves it alone."
                                        Height="36" Padding="16,0" MinWidth="64" Margin="0,0,10,0"/>
                                <Button x:Name="ClearRecordKey" Tag="Record" Style="{StaticResource ClearBindingButton}"
                                        Click="ClearBinding_Click"/>
                                <Button x:Name="OpenClipFolderButton" Content="Open clips folder"
                                        Click="OpenClipFolder_Click" Height="36" Padding="16,0" Margin="0"/>
                            </StackPanel>

                            <TextBlock x:Name="RecordStatusText" Text="" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="INSTANT REPLAY" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ReplayEnabled" DockPanel.Dock="Right" Margin="0"
                                          VerticalAlignment="Center"
                                          Checked="ReplayEnabled_Changed" Unchecked="ReplayEnabled_Changed"/>
                            </DockPanel>

                            <TextBlock Text="Keeps the last minute rolling in the background. Press the hotkey and it saves what already happened."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <UniformGrid x:Name="ReplayLengthPanel" Columns="3" Margin="0,14,0,0"
                                         MaxWidth="330" HorizontalAlignment="Left">
                                <RadioButton Content="15s" GroupName="ReplayLength"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="ReplayLength_Checked" Tag="15"/>
                                <RadioButton Content="30s" GroupName="ReplayLength" IsChecked="True"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="ReplayLength_Checked" Tag="30"/>
                                <RadioButton Content="60s" GroupName="ReplayLength" Margin="0"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="ReplayLength_Checked" Tag="60"/>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="SaveReplayButton" Content="Save now"
                                        Style="{StaticResource AccentButton}"
                                        Click="SaveReplay_Click" Height="36" Width="120" Margin="0,0,10,0"/>
                                <Button x:Name="ReplayHotkeyButton" Content="F8"
                                        Click="ReplayHotkey_Click"
                                        ToolTip="Click, then press a key or mouse side button. Delete unbinds it, Escape leaves it alone."
                                        Height="36" Padding="16,0" MinWidth="64" Margin="0"/>
                                <Button x:Name="ClearReplayKey" Tag="Replay" Style="{StaticResource ClearBindingButton}"
                                        Click="ClearBinding_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="ReplayStatusText" Text="" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="SHARE A CLIP" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Pick a clip and get a link back, instead of handing someone a file."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Border Background="{StaticResource AccentWash}" BorderBrush="{StaticResource Accent}"
                                    BorderThickness="1" CornerRadius="1" Padding="12" Margin="0,14,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Text}"
                                           Text="Uploading publishes the clip. Anyone with the link can watch it, there is no reliable way to delete it afterwards, and a screen recording captures whatever else was on screen at the time."/>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="ChooseClipButton" Content="Choose a clip…"
                                        Click="ChooseClip_Click" Height="36" Padding="16,0" Margin="0,0,10,0"/>
                                <Button x:Name="UploadClipButton" Content="Upload and get link"
                                        Style="{StaticResource AccentButton}" IsEnabled="False"
                                        Click="UploadClip_Click" Height="36" Width="176" Margin="0"/>
                            </StackPanel>

                            <TextBlock x:Name="ChosenClipText" Text="No clip chosen"
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="LINK" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>

                            <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                <!-- MinWidth so swapping in "Copied" on click does
                                     not widen the button and shove the field. -->
                                <Button x:Name="CopyLinkButton" Content="Copy" DockPanel.Dock="Right"
                                        Click="CopyLink_Click" IsEnabled="False"
                                        MinWidth="92"
                                        Padding="16,6" Margin="10,0,0,0"/>
                                <TextBox x:Name="ClipUrlBox" Style="{StaticResource FieldBox}"
                                         IsReadOnly="True" Width="440" HorizontalAlignment="Left"
                                         Text=""/>
                            </DockPanel>

                            <TextBlock x:Name="UploadStatusText" Text="" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="PageTheme" Visibility="Collapsed">
                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="MODE" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>

                            <TextBlock Text="Swaps the backgrounds, text and controls. The accent is unaffected — it stays whichever colour is chosen below."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <UniformGrid Columns="2" Margin="0,14,0,0" MaxWidth="220" HorizontalAlignment="Left">
                                <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="ThemeMode"
                                             IsChecked="True" Style="{StaticResource SegmentButton}"
                                             Checked="ThemeMode_Checked" Tag="Dark"/>
                                <RadioButton x:Name="ThemeLight" Content="Light" GroupName="ThemeMode"
                                             Margin="0" Style="{StaticResource SegmentButton}"
                                             Checked="ThemeMode_Checked" Tag="Light"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ACCENT COLOR" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>

                            <TextBlock Text="Recolors the buttons, highlights and status marks. Backgrounds and text stay as they are."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <!-- Tag carries the colour so the handler reads one string
                                 rather than mapping controls to values, the same way
                                 the replay length buttons work. -->
                            <WrapPanel x:Name="AccentSwatchPanel" Margin="0,14,0,0"
                                       MaxWidth="330" HorizontalAlignment="Left">
                                <RadioButton GroupName="Accent" ToolTip="Crimson"
                                             Style="{StaticResource SwatchButton}"
                                             Background="#FF4B52" Tag="#FF4B52"
                                             Checked="AccentSwatch_Checked"/>
                                <RadioButton GroupName="Accent" ToolTip="Ember"
                                             Style="{StaticResource SwatchButton}"
                                             Background="#FF7A45" Tag="#FF7A45"
                                             Checked="AccentSwatch_Checked"/>
                                <RadioButton GroupName="Accent" ToolTip="Amber"
                                             Style="{StaticResource SwatchButton}"
                                             Background="#FFC53D" Tag="#FFC53D"
                                             Checked="AccentSwatch_Checked"/>
                                <RadioButton GroupName="Accent" ToolTip="Mint"
                                             Style="{StaticResource SwatchButton}"
                                             Background="#4BD47B" Tag="#4BD47B"
                                             Checked="AccentSwatch_Checked"/>
                                <RadioButton GroupName="Accent" ToolTip="Teal"
                                             Style="{StaticResource SwatchButton}"
                                             Background="#2FD4A8" Tag="#2FD4A8"
                                             Checked="AccentSwatch_Checked"/>
                                <RadioButton GroupName="Accent" ToolTip="Sky"
                                             Style="{StaticResource SwatchButton}"
                                             Background="#45B7FF" Tag="#45B7FF"
                                             Checked="AccentSwatch_Checked"/>
                                <RadioButton GroupName="Accent" ToolTip="Indigo"
                                             Style="{StaticResource SwatchButton}"
                                             Background="#5B7CFA" Tag="#5B7CFA"
                                             Checked="AccentSwatch_Checked"/>
                                <RadioButton GroupName="Accent" ToolTip="Violet"
                                             Style="{StaticResource SwatchButton}"
                                             Background="#9B5BFA" Tag="#9B5BFA"
                                             Checked="AccentSwatch_Checked"/>
                                <RadioButton GroupName="Accent" ToolTip="Pink"
                                             Style="{StaticResource SwatchButton}"
                                             Background="#FF5BC8" Tag="#FF5BC8"
                                             Checked="AccentSwatch_Checked"/>
                                <RadioButton GroupName="Accent" ToolTip="Silver"
                                             Style="{StaticResource SwatchButton}"
                                             Background="#C3CDDD" Tag="#C3CDDD"
                                             Checked="AccentSwatch_Checked"/>
                                <!-- Deep and pale blues. Sky sits between them at
                                     #45B7FF, so these are spaced far enough either
                                     side to be distinguishable on the row. -->
                                <RadioButton GroupName="Accent" ToolTip="Deep blue"
                                             Style="{StaticResource SwatchButton}"
                                             Background="#1E5AA8" Tag="#1E5AA8"
                                             Checked="AccentSwatch_Checked"/>
                                <RadioButton GroupName="Accent" ToolTip="Ice blue"
                                             Style="{StaticResource SwatchButton}"
                                             Background="#8FD4FF" Tag="#8FD4FF"
                                             Checked="AccentSwatch_Checked"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="WINDOW OPACITY" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OpacityValueText" DockPanel.Dock="Right" Text="100%"
                                           Foreground="{StaticResource TextMuted}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Fades the whole window so whatever is behind it stays readable. Stops well short of invisible, so it can always be found again."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Slider x:Name="OpacitySlider" Minimum="0.4" Maximum="1" Value="1"
                                    Margin="0,10,0,0" TickFrequency="0.05"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="WALLPAPER" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WallpaperNameText" DockPanel.Dock="Right"
                                           Text="No wallpaper set"
                                           Foreground="{StaticResource TextMuted}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Use your own image as the background behind the sidebar and main page. PNG, JPEG, BMP or WebP. The picture is copied next to the app so moving or deleting the original won't break it."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Border Background="{StaticResource Panel2}" CornerRadius="2"
                                    Height="130" Margin="0,12,0,0" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="WallpaperEmptyText" Text="No wallpaper set"
                                               Foreground="{StaticResource TextMuted}" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="WallpaperPreview" Stretch="UniformToFill"
                                           Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="ChooseWallpaperButton" Content="Choose Image..."
                                        Style="{StaticResource AccentButton}" Height="36" Padding="16,0"
                                        Click="ChooseWallpaper_Click"/>
                                <Button x:Name="RemoveWallpaperButton" Content="Remove"
                                        Height="36" Padding="16,0" Margin="10,0,0,0"
                                        Click="RemoveWallpaper_Click"/>
                            </StackPanel>

                            <!-- The ten that come with the app. Drawn rather than
                                 shipped, so these thumbnails are rendered on the
                                 first visit to this page rather than loaded. -->
                            <TextBlock Text="OR PICK ONE OF THESE" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold" Margin="0,18,0,0"/>

                            <ItemsControl x:Name="WallpaperGalleryList" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Name}" Click="PickBuiltInWallpaper_Click"
                                                Width="150" Margin="0,0,10,10"
                                                Padding="0" Cursor="Hand"
                                                ToolTip="{Binding Name}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <!-- The whole tile is the target, picture
                                                         and caption together. -->
                                                    <Border x:Name="Tile" CornerRadius="2"
                                                            Background="Transparent"
                                                            BorderThickness="1"
                                                            BorderBrush="{StaticResource Outline}">
                                                        <StackPanel>
                                                            <Border Height="84" ClipToBounds="True"
                                                                    CornerRadius="2,2,0,0">
                                                                <Image Source="{Binding Thumbnail}"
                                                                       Stretch="UniformToFill"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Margin="8,6,8,7" FontSize="11"
                                                                       Foreground="{StaticResource TextSoft}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Tile" Property="BorderBrush"
                                                                    Value="{StaticResource Accent}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel LastChildFill="False" Margin="0,16,0,0">
                                <TextBlock Text="Background Dimming" Foreground="{StaticResource TextSoft}"
                                           FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WallpaperDimmingText" DockPanel.Dock="Right" Text="45%"
                                           Foreground="{StaticResource Accent}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <Slider x:Name="WallpaperDimmingSlider" Minimum="0" Maximum="90" Value="45"
                                    Margin="0,8,0,0" TickFrequency="5"
                                    ValueChanged="WallpaperDimming_ValueChanged"/>

                            <TextBlock Text="How far the image is darkened behind the interface. Higher values keep text readable on bright photos."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageSettings" Visibility="Collapsed">

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="STREAMING" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>

                            <DockPanel LastChildFill="False" Margin="0,12,0,0">
                                <StackPanel VerticalAlignment="Center" MaxWidth="470"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="STREAMER MODE" Foreground="{StaticResource TextSoft}"
                                               FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Hides the &quot;macro on&quot; badge from OBS, Discord screen share and other capture software. It stays visible on your own monitor, so you can still see when a macro is holding a key."
                                               Foreground="{StaticResource TextMuted}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="StreamerModeCheck" DockPanel.Dock="Right"
                                          VerticalAlignment="Center"
                                          Checked="StreamerMode_Changed"
                                          Unchecked="StreamerMode_Changed"/>
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,16,0,0">
                                <StackPanel VerticalAlignment="Center" MaxWidth="470"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="LIVE READOUT OVER THE GAME" Foreground="{StaticResource TextSoft}"
                                               FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Shows the clicks per second actually being sent, and how even they are, in the corner of the screen while the clicker runs. It reports what this app sends — it does not read the game, so there is no hit count."
                                               Foreground="{StaticResource TextMuted}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="OverlayCheck" DockPanel.Dock="Right"
                                          VerticalAlignment="Center" IsChecked="True"
                                          Checked="Overlay_Changed"
                                          Unchecked="Overlay_Changed"/>
                            </DockPanel>

                            <TextBlock Text="The badge appears whenever a macro or the auto switcher is running, and names the keys being sent. It is there so a macro left on does not read as the game misbehaving — several kits bind the same keys."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="HOTKEYS" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <CheckBox x:Name="HotkeysEnabledToggle" DockPanel.Dock="Right" Margin="0"
                                          IsChecked="True" VerticalAlignment="Center"
                                          Checked="HotkeysEnabled_Changed" Unchecked="HotkeysEnabled_Changed"/>
                            </DockPanel>

                            <TextBlock Text="Hotkeys are watched system-wide, so they fire inside a game — and just as readily while you are typing in a browser or a chat box. Turning this off silences the rest without unbinding them."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Border Height="1" Background="{StaticResource Divider}" Margin="0,14,0,0"/>

                            <DockPanel LastChildFill="False" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="HOTKEY FOR THE SWITCH ABOVE" Foreground="{StaticResource TextSoft}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Flips that checkbox from anywhere. Keeps listening while hotkeys are off, so it can always turn them back on."
                                               Foreground="{StaticResource TextMuted}" FontSize="11"
                                               TextWrapping="Wrap" MaxWidth="430" HorizontalAlignment="Left"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="ClearMasterKey" Tag="Master" Style="{StaticResource ClearBindingButton}"
                                        Click="ClearBinding_Click" DockPanel.Dock="Right"/>
                                <Button x:Name="MasterHotkeyButton" DockPanel.Dock="Right" Content="Not set"
                                        MinWidth="110" Height="36" Padding="14,0" VerticalAlignment="Center"
                                        Click="MasterHotkey_Click"/>
                            </DockPanel>

                            <TextBlock x:Name="HotkeySummaryText" Text=""
                                       Foreground="{StaticResource TextDim}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="CLIP FOLDER" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>

                            <TextBlock Text="Where recordings and saved replays are written. Left empty it returns to your Videos folder."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <DockPanel Margin="0,10,0,0" LastChildFill="True">
                                <Button x:Name="ResetClipFolderButton" DockPanel.Dock="Right"
                                        Content="Default" Click="ResetClipFolder_Click"
                                        Height="36" Padding="16,0" Margin="10,0,0,0"/>
                                <TextBox x:Name="ClipFolderBox" Style="{StaticResource PathBox}"
                                         TextChanged="ClipFolder_TextChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="RECORDING FRAMERATE" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>

                            <TextBlock Text="Applies to both recordings and the replay buffer. 60 is smoother for gameplay and roughly doubles the file size."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <!-- No IsChecked here: it raises Checked during XAML
                                 parsing, which applied a framerate before the
                                 stored one had been read. LoadSettings selects
                                 the right button, falling back to 30. -->
                            <UniformGrid x:Name="RecordFpsPanel" Columns="4" Margin="0,14,0,0"
                                         MaxWidth="440" HorizontalAlignment="Left">
                                <RadioButton Content="30" GroupName="RecordFps"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="30"/>
                                <RadioButton Content="60" GroupName="RecordFps"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="60"/>
                                <RadioButton Content="120" GroupName="RecordFps"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="120"/>
                                <RadioButton Content="144" GroupName="RecordFps" Margin="0"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="144"/>
                                <RadioButton Content="165" GroupName="RecordFps"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="165"/>
                                <RadioButton Content="180" GroupName="RecordFps"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="180"/>
                                <RadioButton Content="240" GroupName="RecordFps"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="240"/>
                                <RadioButton Content="360" GroupName="RecordFps" Margin="0"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="360"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource EmptyPanel}">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" Style="{StaticResource EmptyHeading}"/>
                            <TextBlock Text="More to come" Style="{StaticResource EmptyTitle}"/>
                            <TextBlock Text="Hotkeys are rebound from their own buttons on the Clicker and Recorder pages."
                                       Style="{StaticResource EmptyHint}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
              </Grid>
            </ScrollViewer>
        </Grid>

        <!-- In-app confirmation. Spans both columns so it dims the sidebar too,
             which is what makes it read as modal rather than as another panel. -->
        <Grid x:Name="ConfirmOverlay" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="#D9080B11" Panel.ZIndex="100"
              TextOptions.TextFormattingMode="Display"
              TextOptions.TextRenderingMode="ClearType"
              UseLayoutRounding="True" SnapsToDevicePixels="True">

            <!-- The shadow lives on its own element behind the card. A bitmap
                 Effect forces everything inside it through an intermediate
                 surface, which drops ClearType and softens all the text — so the
                 card itself must not be inside one. -->
            <Border CornerRadius="3" Background="{StaticResource Panel}" MaxWidth="460" Margin="0,0,0,0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="460" Height="{Binding ActualHeight, ElementName=ConfirmCard}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black"/>
                </Border.Effect>
            </Border>

            <Border x:Name="ConfirmCard" Background="{StaticResource Panel}" CornerRadius="3" Padding="0"
                    MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource Track}" BorderThickness="1">

                <StackPanel>
                    <Border Height="3" CornerRadius="14,14,0,0" Background="{StaticResource Accent}"/>

                    <StackPanel Margin="24">
                        <TextBlock x:Name="ConfirmTitleText" Text="" FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="ConfirmMessageText" Text="" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMuted}" FontSize="12"
                                   Margin="0,10,0,0" LineHeight="18"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button x:Name="ConfirmNoButton" Content="Cancel" Click="ConfirmNo_Click"
                                    Height="36" Padding="18,0" Margin="0,0,10,0"/>
                            <Button x:Name="ConfirmYesButton" Content="Confirm" Click="ConfirmYes_Click"
                                    Style="{StaticResource AccentButton}"
                                    Height="36" Padding="18,0" MinWidth="120" Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
