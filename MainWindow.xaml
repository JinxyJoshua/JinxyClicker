                            <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Margin="0,14,0,0"/>
                            <TextBlock Text="Don't have a key yet? Join the Discord to get one â€” a one-time $20 for lifetime, or a short pass."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,8"/>
                            <Button Content="Join the Discord" Style="{StaticResource AccentButton}" Padding="16,8"
                                    HorizontalAlignment="Left" Click="JoinDiscord_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE734;"/>
                                </Border>
                                <TextBlock Text="What Plus unlocks" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="&#8226;  Clip Studio &#8212; auto-montage of your best moments, auto-clip and export"
                                       Foreground="{StaticResource TextSoft}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <TextBlock Text="&#8226;  BedWars timer overlay &#8212; generator and event countdowns"
                                       Foreground="{StaticResource TextSoft}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="&#8226;  App themes, custom colours and animated backgrounds"
                                       Foreground="{StaticResource TextSoft}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="&#8226;  Personal stats &#8212; your hours, clips and favourite kit"
                                       Foreground="{StaticResource TextSoft}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="&#8226;  Unlimited presets and custom crosshairs"
                                       Foreground="{StaticResource TextSoft}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <Border Height="1" Background="{StaticResource Divider}" Margin="0,14,0,0"/>
                            <TextBlock Text="One key unlocks all of the above for its length. Grab one above."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageTrainer" Visibility="Collapsed">
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE1D2;"/>
                                </Border>
                                <TextBlock DockPanel.Dock="Left" Text="Aim trainer" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="PLUS" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="Practise your aim and clicking right here â€” reaction, flick accuracy, tracking and a CPS test. Nothing touches the game."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <StackPanel x:Name="TrainerProPanel" Margin="0,4,0,0">
                                <WrapPanel Margin="0,12,0,0">
                                    <RadioButton x:Name="TrainerModeAccuracy" Content="Accuracy" GroupName="TrainerMode" Tag="Accuracy" Style="{StaticResource SegmentButton}" MinWidth="82" IsChecked="True" Checked="TrainerMode_Checked"/>
                                    <RadioButton x:Name="TrainerModeReaction" Content="Reaction" GroupName="TrainerMode" Tag="Reaction" Style="{StaticResource SegmentButton}" MinWidth="82" Checked="TrainerMode_Checked"/>
                                    <RadioButton x:Name="TrainerModeTracking" Content="Tracking" GroupName="TrainerMode" Tag="Tracking" Style="{StaticResource SegmentButton}" MinWidth="82" Checked="TrainerMode_Checked"/>
                                    <RadioButton x:Name="TrainerModeCps" Content="CPS test" GroupName="TrainerMode" Tag="CPS" Style="{StaticResource SegmentButton}" MinWidth="82" Checked="TrainerMode_Checked"/>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="DURATION" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,10,0"/>
                                    <RadioButton x:Name="TrainerDur15" Content="15s" GroupName="TrainerDur" Tag="15" Style="{StaticResource SegmentButton}" MinWidth="50" Checked="TrainerDur_Checked"/>
                                    <RadioButton x:Name="TrainerDur30" Content="30s" GroupName="TrainerDur" Tag="30" Style="{StaticResource SegmentButton}" MinWidth="50" IsChecked="True" Checked="TrainerDur_Checked"/>
                                    <RadioButton x:Name="TrainerDur60" Content="60s" GroupName="TrainerDur" Tag="60" Style="{StaticResource SegmentButton}" MinWidth="50" Checked="TrainerDur_Checked"/>
                                    <Button x:Name="TrainerStartButton" Content="Start" Style="{StaticResource AccentButton}" Height="34" Padding="22,0" Margin="16,0,0,0" Click="TrainerStart_Click"/>
                                </StackPanel>

                                <Border Margin="0,14,0,0" CornerRadius="8" Background="#0E0E16" BorderBrush="{StaticResource Outline}" BorderThickness="1" ClipToBounds="True">
                                    <Canvas x:Name="TrainerCanvas" Height="340" Background="Transparent" MouseLeftButtonDown="TrainerCanvas_Click"/>
                                </Border>

                                <UniformGrid Columns="5" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TrainerHits" Text="0" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextBright}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="HITS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="TrainerMisses" Text="0" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextBright}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="MISSED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="TrainerAccuracy" Text="â€”" FontSize="22" FontWeight="Black" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="ACCURACY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="TrainerAvg" Text="â€”" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextBright}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="AVG TIME" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="TrainerTimeLeft" Text="â€”" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextBright}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="TIME LEFT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageSettings" Visibility="Collapsed">

                    <UniformGrid x:Name="PageSettingsBar" Columns="5" Margin="0,0,0,14">
                        <RadioButton Content="General" GroupName="PageSettingsTab" Tag="PageSettings_general" IsChecked="True" Style="{StaticResource SegmentButton}" Checked="PageTab_Checked"/>
                        <RadioButton Content="Streaming" GroupName="PageSettingsTab" Tag="PageSettings_streaming" Style="{StaticResource SegmentButton}" Checked="PageTab_Checked"/>
                        <RadioButton Content="Hotkeys" GroupName="PageSettingsTab" Tag="PageSettings_hotkeys" Style="{StaticResource SegmentButton}" Checked="PageTab_Checked"/>
                        <RadioButton Content="Recording" GroupName="PageSettingsTab" Tag="PageSettings_recording" Style="{StaticResource SegmentButton}" Checked="PageTab_Checked"/>
                        <RadioButton Content="Feedback" GroupName="PageSettingsTab" Tag="PageSettings_feedback" Margin="0" Style="{StaticResource SegmentButton}" Checked="PageTab_Checked"/>
                    </UniformGrid>

                    <StackPanel x:Name="PageSettings_general">
                    <Border Style="{StaticResource EmptyPanel}">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" Style="{StaticResource EmptyHeading}"/>
                            <TextBlock Text="More to come" Style="{StaticResource EmptyTitle}"/>
                            <TextBlock Text="Hotkeys are rebound from their own buttons on the Clicker and Recorder pages."
                                       Style="{StaticResource EmptyHint}"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>

                    <StackPanel x:Name="PageSettings_streaming" Visibility="Collapsed">
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="STREAMING" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>

                            <DockPanel LastChildFill="False" Margin="0,12,0,0">
                                <StackPanel VerticalAlignment="Center" MaxWidth="470"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="STREAMER MODE" Foreground="{StaticResource TextSoft}"
                                               FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Hides every overlay this app draws over the game &#8212; the &quot;macro on&quot; badge and the CPS readout &#8212; from OBS, Discord screen share and other capture software. They stay visible on your own monitor, so you can still read them while you play. Recording notices are hidden from capture whether this is on or not."
                                               Foreground="{StaticResource TextMuted}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="StreamerModeCheck" DockPanel.Dock="Right"
                                          VerticalAlignment="Center"
                                          Checked="StreamerMode_Changed"
                                          Unchecked="StreamerMode_Changed"/>
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,16,0,0">
                                <StackPanel VerticalAlignment="Center" MaxWidth="470"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="LIVE READOUT OVER THE GAME" Foreground="{StaticResource TextSoft}"
                                               FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Off unless you turn it on. Shows the clicks per second actually being sent, and how even they are, in the corner of the screen while the clicker runs. It reports what this app sends â€” it does not read the game, so there is no hit count."
                                               Foreground="{StaticResource TextMuted}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <!-- Unchecked here as well as in AppSettings: the
                                     markup value is what a fresh run starts from. -->
                                <CheckBox x:Name="OverlayCheck" DockPanel.Dock="Right"
                                          VerticalAlignment="Center"
                                          Checked="Overlay_Changed"
                                          Unchecked="Overlay_Changed"/>
                            </DockPanel>

                            <TextBlock Text="The badge appears whenever a macro or the auto switcher is running, and names the keys being sent. It is there so a macro left on does not read as the game misbehaving â€” several kits bind the same keys."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>

                    <StackPanel x:Name="PageSettings_hotkeys" Visibility="Collapsed">
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="HOTKEYS" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <CheckBox x:Name="HotkeysEnabledToggle" DockPanel.Dock="Right" Margin="0"
                                          IsChecked="True" VerticalAlignment="Center"
                                          Checked="HotkeysEnabled_Changed" Unchecked="HotkeysEnabled_Changed"/>
                            </DockPanel>

                            <TextBlock Text="Hotkeys are watched system-wide, so they fire inside a game â€” and just as readily while you are typing in a browser or a chat box. Turning this off silences the rest without unbinding them."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Border Height="1" Background="{StaticResource Divider}" Margin="0,14,0,0"/>

                            <DockPanel LastChildFill="False" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="HOTKEY FOR THE SWITCH ABOVE" Foreground="{StaticResource TextSoft}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Flips that checkbox from anywhere. Keeps listening while hotkeys are off, so it can always turn them back on."
                                               Foreground="{StaticResource TextMuted}" FontSize="11"
                                               TextWrapping="Wrap" MaxWidth="430" HorizontalAlignment="Left"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="ClearMasterKey" Tag="Master" Style="{StaticResource ClearBindingButton}"
                                        Click="ClearBinding_Click" DockPanel.Dock="Right"/>
                                <Button x:Name="MasterHotkeyButton" DockPanel.Dock="Right" Content="Not set"
                                        MinWidth="110" Height="36" Padding="14,0" VerticalAlignment="Center"
                                        Click="MasterHotkey_Click"/>
                            </DockPanel>

                            <TextBlock x:Name="HotkeySummaryText" Text=""
                                       Foreground="{StaticResource TextDim}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>

                    <StackPanel x:Name="PageSettings_recording" Visibility="Collapsed">
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="CLIP FOLDER" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>

                            <TextBlock Text="Where recordings and saved replays are written. Left empty it returns to your Videos folder."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <DockPanel Margin="0,10,0,0" LastChildFill="True">
                                <Button x:Name="ResetClipFolderButton" DockPanel.Dock="Right"
                                        Content="Default" Click="ResetClipFolder_Click"
                                        Height="36" Padding="16,0" Margin="10,0,0,0"/>
                                <TextBox x:Name="ClipFolderBox" Style="{StaticResource PathBox}"
                                         TextChanged="ClipFolder_TextChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="RECORDING FRAMERATE" Foreground="{StaticResource TextMuted}"
                                       FontSize="10" FontWeight="Bold"/>

                            <TextBlock Text="Applies to both recordings and the replay buffer. 60 is smoother for gameplay and roughly doubles the file size."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <!--
                                The same setting behaves differently on different
                                PCs, so this measures rather than assumes. Placed
                                above the buttons because it sets them.
                            -->
                            <DockPanel LastChildFill="False" Margin="0,12,0,0">
                                <TextBlock x:Name="AutoFpsStatus"
                                           Text="Not measured. Run this with the game open â€” an idle PC measures faster than a busy one, and busy is when you record."
                                           Foreground="{StaticResource TextMuted}" FontSize="11"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           MaxWidth="440"/>
                                <Button x:Name="AutoFpsButton" Content="AUTO"
                                        Click="AutoFpsButton_Click"
                                        DockPanel.Dock="Right" VerticalAlignment="Center"
                                        ToolTip="Captures for a few seconds at each rate and picks the fastest one this PC actually holds without taking the CPU the game needs. Nothing is saved. Best run with the game already open, because that is the load a recording really happens under."
                                        FontSize="14" FontWeight="Bold"
                                        Height="38" MinWidth="104" Padding="16,0" Margin="12,0,0,0"/>
                            </DockPanel>

                            <!-- No IsChecked here: it raises Checked during XAML
                                 parsing, which applied a framerate before the
                                 stored one had been read. LoadSettings selects
                                 the right button, falling back to 30. -->
                            <UniformGrid x:Name="RecordFpsPanel" Columns="4" Margin="0,14,0,0"
                                         MaxWidth="440" HorizontalAlignment="Left">
                                <RadioButton Content="30" GroupName="RecordFps"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="30"/>
                                <RadioButton Content="60" GroupName="RecordFps"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="60"/>
                                <RadioButton Content="120" GroupName="RecordFps"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="120"/>
                                <RadioButton Content="144" GroupName="RecordFps" Margin="0"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="144"/>
                                <RadioButton Content="165" GroupName="RecordFps"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="165"/>
                                <RadioButton Content="180" GroupName="RecordFps"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="180"/>
                                <RadioButton Content="240" GroupName="RecordFps"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="240"/>
                                <RadioButton Content="360" GroupName="RecordFps" Margin="0"
                                             Style="{StaticResource SegmentButton}"
                                             Checked="RecordFps_Checked" Tag="360"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    </StackPanel>

                    <StackPanel x:Name="PageSettings_feedback" Visibility="Collapsed">
                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE939;"/>
                                </Border>
                                <TextBlock DockPanel.Dock="Left" Text="Send feedback" Style="{StaticResource CardTitle}" Margin="11,0,0,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="STRAIGHT TO THE DEV" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="Found a bug, want a feature, or have an idea to make Jinxy better? Send it right here &#x2014; no GitHub, no account, no sign-in."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <TextBlock Text="WHAT'S THIS ABOUT" FontSize="9" FontWeight="Bold" Margin="0,16,0,6" Foreground="{StaticResource TextMuted}"/>
                            <WrapPanel>
                                <RadioButton x:Name="FeedbackTypeFeature" Content="New feature" GroupName="FeedbackType" Tag="feature"
                                             Style="{StaticResource SegmentButton}" MinWidth="116" IsChecked="True" Checked="FeedbackType_Checked"/>
                                <RadioButton x:Name="FeedbackTypeImprovement" Content="Improvement" GroupName="FeedbackType" Tag="improvement"
                                             Style="{StaticResource SegmentButton}" MinWidth="116" Checked="FeedbackType_Checked"/>
                                <RadioButton x:Name="FeedbackTypeBug" Content="Something's broken" GroupName="FeedbackType" Tag="bug"
                                             Style="{StaticResource SegmentButton}" MinWidth="150" Checked="FeedbackType_Checked"/>
                            </WrapPanel>

                            <TextBlock Text="SUMMARY" FontSize="9" FontWeight="Bold" Margin="0,16,0,2" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="One line &#x2014; what should change?" Foreground="{StaticResource TextSoft}" FontSize="11" Margin="0,0,0,6"/>
                            <TextBox x:Name="FeedbackSummary" Style="{StaticResource InputField}" MaxLength="120"
                                     HorizontalAlignment="Stretch" TextChanged="FeedbackText_Changed"/>

                            <TextBlock Text="DETAILS" FontSize="9" FontWeight="Bold" Margin="0,16,0,2" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="What you'd like it to do, and why. For a bug: what you did, what happened, and what you expected instead."
                                       Foreground="{StaticResource TextSoft}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <TextBox x:Name="FeedbackDetails" Style="{StaticResource TextArea}" MaxLength="4000"
                                     HorizontalAlignment="Stretch" TextChanged="FeedbackText_Changed"/>
                            <TextBlock x:Name="FeedbackCount" Text="0 / 4000" HorizontalAlignment="Right" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextMuted}" FontSize="10"/>

                            <DockPanel LastChildFill="False" Margin="0,14,0,0">
                                <Button x:Name="FeedbackSubmit" DockPanel.Dock="Left" Content="Send suggestion" Style="{StaticResource AccentButton}"
                                        Padding="18,9" Click="FeedbackSubmit_Click"/>
                                <TextBlock x:Name="FeedbackStatus" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="14,0,0,0"
                                           Foreground="{StaticResource TextSoft}" FontSize="12" TextWrapping="Wrap"/>
                            </DockPanel>

                            <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Margin="0,16,0,0"/>
                            <TextBlock Text="What gets included: your message, the type, and the app version &#x2014; nothing else. No settings, no profiles, no personal details, and nothing leaves your PC until you press Send."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                </StackPanel>
              </Grid>
            </ScrollViewer>
        </Grid>

        <!-- In-app confirmation. Spans both columns so it dims the sidebar too,
             which is what makes it read as modal rather than as another panel. -->
        <Grid x:Name="ConfirmOverlay" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="#D9080B11" Panel.ZIndex="100"
              TextOptions.TextFormattingMode="Display"
              TextOptions.TextRenderingMode="ClearType"
              UseLayoutRounding="True" SnapsToDevicePixels="True">

            <!-- The shadow lives on its own element behind the card. A bitmap
                 Effect forces everything inside it through an intermediate
                 surface, which drops ClearType and softens all the text â€” so the
                 card itself must not be inside one. -->
            <Border CornerRadius="8" Background="{StaticResource Panel}" MaxWidth="460" Margin="0,0,0,0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="460" Height="{Binding ActualHeight, ElementName=ConfirmCard}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black"/>
                </Border.Effect>
            </Border>

            <Border x:Name="ConfirmCard" Background="{StaticResource Panel}" CornerRadius="8" Padding="0"
                    MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource Track}" BorderThickness="1">

                <StackPanel>
                    <Border Height="3" CornerRadius="14,14,0,0" Background="{StaticResource Accent}"/>

                    <StackPanel Margin="24">
                        <TextBlock x:Name="ConfirmTitleText" Text="" FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="ConfirmMessageText" Text="" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMuted}" FontSize="12"
                                   Margin="0,10,0,0" LineHeight="18"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button x:Name="ConfirmNoButton" Content="Cancel" Click="ConfirmNo_Click"
                                    Height="36" Padding="18,0" Margin="0,0,10,0"/>
                            <Button x:Name="ConfirmYesButton" Content="Confirm" Click="ConfirmYes_Click"
                                    Style="{StaticResource AccentButton}"
                                    Height="36" Padding="18,0" MinWidth="120" Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Confetti layer for a successful Pro activation. A top-level sibling so
             it overlays the whole window and is never hidden by a collapsed parent;
             click-through and empty until something celebrates. -->
        <Canvas x:Name="ProCelebration" IsHitTestVisible="False"
                Grid.ColumnSpan="2" Panel.ZIndex="200" ClipToBounds="True"/>

        <!-- First-open intro, Lyre-style: a brief branded flourish over a solid
             backdrop that fades away to reveal the app. The backdrop uses the
             theme Bg so it matches whatever mode is set. Driven from
             Window_ContentRendered so it starts after the first paint, and a
             click anywhere skips it. See MainWindow.Intro.cs. -->
        <Grid x:Name="IntroOverlay" Grid.ColumnSpan="2" Panel.ZIndex="500"
              Background="{DynamicResource Bg}"
              MouseLeftButtonDown="IntroOverlay_Skip">
            <Grid x:Name="IntroContent" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="IntroScale" ScaleX="0.86" ScaleY="0.86"/>
                </Grid.RenderTransform>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="JINXY" FontSize="66" FontWeight="Black"
                               Foreground="{DynamicResource TextBright}"
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect x:Name="IntroGlow" ShadowDepth="0" BlurRadius="34"
                                              Color="{DynamicResource AccentColor}" Opacity="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <!-- Accent bar wipes open from the centre under the wordmark. -->
                    <Border x:Name="IntroBar" Height="4" CornerRadius="2" Width="230"
                            Background="{DynamicResource Accent}" Margin="0,12,0,0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="IntroBarScale" ScaleX="0" ScaleY="1"/>
                        </Border.RenderTransform>
                    </Border>
                    <TextBlock Text="ORIGINAL BUILD" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
