                                         KeyDown="EditorMarkBox_KeyDown" LostFocus="EditorMarkBox_LostFocus"/>
                                <Button DockPanel.Dock="Left" Content="+" Tag="B+" Width="30" Height="28" Click="EditorNudge_Click" IsEnabled="False" x:Name="EditorNudgeBUp"/>
                            </DockPanel>

                            <WrapPanel Margin="0,2,0,0">
                                <Button x:Name="EditorDeleteMiddleButton" Content="Delete A &#x2192; B" Click="EditorDeleteMiddle_Click" IsEnabled="False"
                                        Style="{StaticResource AccentButton}" Height="32" Padding="16,0" Margin="0,0,8,0"/>
                                <Button x:Name="EditorClearABButton" Content="Clear A/B" Click="EditorClearAB_Click" IsEnabled="False"
                                        Height="32" Padding="14,0"/>
                            </WrapPanel>
