                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="EditorTimeline" Orientation="Horizontal"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Outline}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Style="{StaticResource CardIconChip}">
                                    <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#xE8B2;"/>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Cut (A &#x2192; B)"/>
                                    <TextBlock x:Name="EditorCutText" Style="{StaticResource CardSubtitle}" Text="Select a clip, then mark A and B"/>
