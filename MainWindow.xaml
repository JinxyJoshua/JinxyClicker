                            </StackPanel>
                            <DockPanel Margin="0,2,0,6" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="A" Width="14" VerticalAlignment="Center"
                                           FontWeight="Bold" Foreground="#5AD17A"/>
