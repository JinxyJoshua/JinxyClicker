<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!--
      The app has to know its own version to tell whether a release is newer
      than it. This lived only in Installer/JinxyClicker.iss, where the built
      binary could not read it. Bump both together at release time — the
      installer's AppVersion and this — or the update prompt compares against
      a version nobody shipped.
    -->
    <Version>1.4.2</Version>

    <!--
      The compiler records where it built, and that record ships. A release DLL
      carried the full build path in its CodeView entry — the folder name and
      the account name it was built under — readable in any hex editor by
      anyone who downloaded the installer.

      PathMap rewrites those paths to a relative "." so nothing about this
      machine travels with the binary. Deterministic builds make the rewrite
      total: without it some paths are still recorded absolutely.
    -->
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Release ships no debug record at all. PathMap cleans the source paths, but
    the reference to the .pdb itself is still an absolute path to a file the
    user does not have — leaking the same two names to no benefit, since the
    symbols are not shipped either. Debug builds keep theirs so local
    debugging still works.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    The developer panel is not in a normal build.

    Passing -p:DevTools=true defines DEVTOOLS, which is the only thing that
    compiles MainWindow.DevTools.cs in. Without it the panel, its handlers and
    even its labels are absent from the assembly — not hidden at runtime, not
    behind a key, simply not built. Anyone handed the public installer has
    nothing to find, whatever they know about it.

    Usage counting is deliberately NOT behind this switch. Every copy reports,
    or a total across everybody would only count the people who can see it.

      Build:   dotnet build JinxyClicker.csproj -c Release -p:DevTools=true
      Publish: the usual publish command, plus -p:DevTools=true
  -->
  <!--
    Never compile anything out of bin or obj.

    MSBuild normally excludes the intermediate folder for you, but only the one
    it is currently using — so building to a different obj (which run-dev.cmd
    does, to keep the dev build from overwriting the one Visual Studio makes)
    leaves the old obj\Debug visible to the source glob, and its generated
    AssemblyInfo.cs then collides with the real one.
  -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DevTools)' == 'true'">
    <DefineConstants>$(DefineConstants);DEVTOOLS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Tests sit next to the code they cover. They are compiled by
      Testing/JinxyClicker.Tests.csproj, which links them in by source, so the
      app must not pick them up — it has no test framework referenced.
    -->
    <Compile Remove="**/*.Tests.cs" />
    <!-- A nested project's obj/ would otherwise be globbed into this one. -->
    <Compile Remove="Testing/**" />
    <None Remove="Testing/**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Shipped inside the assembly so a fresh install can lay it down as the
      window background on first launch, without dragging along a loose file
      that could go missing between install and run. LogicalName pins the
      manifest name so relocating the source file cannot silently rename it.
    -->
    <EmbeddedResource Include="icon-source.png" LogicalName="DefaultWallpaper.png" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Kit art, copied out beside the executable rather than embedded. There are
      a hundred and thirteen of them and the Kit Wheel only ever shows a handful
      at once, so loose files let it decode the ones it needs; embedding would
      put all eight megabytes in the assembly to reach any one of them.

      Link flattens them into a "kits" folder, which is where KitImages looks.
      Publish carries them through, so the installer picks them up with the rest
      of the publish output and needs no line of its own.
    -->
    <Content Include="Assets\Kits\*.png"
             Link="kits\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
