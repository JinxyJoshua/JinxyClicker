<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Tests sit next to the code they cover. They are compiled by
      Testing/JinxyClicker.Tests.csproj, which links them in by source, so the
      app must not pick them up — it has no test framework referenced.
    -->
    <Compile Remove="**/*.Tests.cs" />
    <!-- A nested project's obj/ would otherwise be globbed into this one. -->
    <Compile Remove="Testing/**" />
    <None Remove="Testing/**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Shipped inside the assembly so a fresh install can lay it down as the
      window background on first launch, without dragging along a loose file
      that could go missing between install and run. LogicalName pins the
      manifest name so relocating the source file cannot silently rename it.
    -->
    <EmbeddedResource Include="icon-source.png" LogicalName="DefaultWallpaper.png" />
  </ItemGroup>

</Project>
