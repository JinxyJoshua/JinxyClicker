# Build output
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Rider / ReSharper
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# NuGet
*.nupkg
*.snupkg
packages/
!packages/build/
*.nuget.props
*.nuget.targets

# Test / coverage
[Tt]est[Rr]esult*/
*.coverage
*.coveragexml
coverage*.json
coverage*.xml

# Publish
[Pp]ublish/
*.[Pp]ublish.xml
*.pubxml
*.azurePubxml

# Installer output, and the ffmpeg binary it bundles. ffmpeg.exe alone is 213 MB
# — twice GitHub's hard file limit — so it is fetched rather than committed.
# See Installer/README for where to put it before building the installer.
dist/
ffmpeg/

# Runtime user settings (generated on first run)
hotkey_settings.json
app_settings.json
click_presets.json
tweak_state.json
history.json

# Copies of the above set aside by hand. SettingsPath migrates any settings file
# left in the working directory into %APPDATA% whenever the target is missing,
# so a stale one here silently resurrects old values during development.
*.legacy-bak

# OS cruft
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# The dev build's update token. This repository is public, so this must never
# be committed - it is packaged into the DEV installer only.
dev-update.token
