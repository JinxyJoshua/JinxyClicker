<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!--
      Not for building UI. HotkeyBinding stores triggers as WPF Key and
      MouseButton values, so the types have to resolve for the linked-in
      sources to compile at all.
    -->
    <UseWPF>true</UseWPF>
    <!--
      The app is a WinExe and cannot be referenced as a library, so the classes
      under test are linked in by source. Only files listed below compile here.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../ClickTiming.cs" />
    <Compile Include="../ClickTiming.Tests.cs" />
    <Compile Include="../ClickButton.cs" />
    <Compile Include="../ClickButton.Tests.cs" />
    <Compile Include="../ClickOutput.cs" />
    <Compile Include="../ClickOutput.Tests.cs" />
    <Compile Include="../ClickPreset.cs" />
    <Compile Include="../ClickPreset.Tests.cs" />
    <Compile Include="../AppSettings.cs" />
    <Compile Include="../SettingsPath.cs" />
    <Compile Include="../Wallpaper.cs" />
    <Compile Include="../Wallpaper.Tests.cs" />
    <Compile Include="../KeyMacro.cs" />
    <Compile Include="../KeyMacro.Tests.cs" />
    <Compile Include="../KeyMacroDwell.Tests.cs" />
    <Compile Include="../KeyMacroWait.Tests.cs" />
    <Compile Include="../CaptureBackend.cs" />
    <Compile Include="../CaptureBackend.Tests.cs" />
    <!-- Pulled in as a dependency of KeyMacro, not tested directly. -->
    <Compile Include="../HotkeySettings.cs" />
    <!-- Pulled in as dependencies of CaptureBackend, not tested directly. -->
    <Compile Include="../DisplayInfo.cs" />
    <Compile Include="../GpuInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
